<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<PlatformTarget>x86</PlatformTarget>
		<RootNamespace>FalloutScriptStudio.UiTests</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<NoWarn>$(NoWarn);WPF0001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- The tests start the built program as a separate process: the project is built first, but never referenced. -->
		<ProjectReference Include="..\FalloutScriptStudio\FalloutScriptStudio.csproj" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\FalloutScriptStudio.Core\FalloutScriptStudio.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The scratch folder and file locator shared with the other test projects (everything lives in _test_files at the repository root). -->
		<Compile Include="..\FalloutScriptStudio.Core.Tests\Support\TestFiles.cs" Link="Support\TestFiles.cs" />
		<Compile Include="..\FalloutScriptStudio.Core.Tests\Support\TestFolder.cs" Link="Support\TestFolder.cs" />
	</ItemGroup>

</Project>