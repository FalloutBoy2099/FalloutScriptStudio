<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="SSL" extensions=".ssl;.h" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
	<Color name="Default" />
	<Color name="Number" />
	<Color name="LineComment" />
	<Color name="BlockComment" />
	<Color name="String" />
	<Color name="StringEscape" />
	<Color name="IncludePath" />
	<Color name="CodeBraces" />
	<Color name="DefineName" />
	<Color name="ErrorWords" />
	<Color name="WarningWords" />
	<Color name="UserMacros" />
	<Color name="SpecMacros" />
	<Color name="PreprocessorDirectives" />
	<Color name="StandardProcedures" />
	<Color name="Punctuation" />
	<Color name="SpecSymbol" />
	<Color name="CoreKeywords" />
	<Color name="FalloutBaseFunctions" />
	<Color name="InterfaceFunctions" />
	<Color name="Special" />
	<Color name="FalloutBaseMacros" />
	<Color name="FalloutExtendMacros" />
	<Color name="SfallUnsafeFunctions" />
	<Color name="SfallFunctions" />
	<Color name="SfallMacros" />
	<Color name="OperatorKeywords" />
	<Color name="Constants" />
	<Color name="DefineConstants" />

	<RuleSet name="CommentMarkers" ignoreCase="false">
		<Keywords color="ErrorWords">
			<Word>TODO</Word>
			<Word>FIXME</Word>
		</Keywords>
		<Keywords color="WarningWords">
			<Word>HACK</Word>
			<Word>UNDONE</Word>
		</Keywords>
	</RuleSet>

	<RuleSet name="StringEscapes" ignoreCase="false">
		<Span color="StringEscape" begin="\\" end="." />
	</RuleSet>

	<RuleSet ignoreCase="true">
		<Span color="IncludePath" ruleSet="IncludeLine" multiline="false">
			<Begin color="PreprocessorDirectives">^[ \t]*\#(?:include|line)\b</Begin>
		</Span>
		<Span color="LineComment" ruleSet="CommentMarkers" multiline="false">
			<Begin>//</Begin>
		</Span>
		<Span color="BlockComment" ruleSet="CommentMarkers" multiline="true">
			<Begin>/\*</Begin>
			<End>\*/</End>
		</Span>
		<Span color="String" ruleSet="StringEscapes" multiline="false">
			<Begin>"</Begin>
			<End>"</End>
		</Span>
		<Span color="CodeBraces" multiline="false">
			<Begin>\{</Begin>
			<End>\}</End>
		</Span>

		<Rule color="DefineName">(?&lt;=\#define[ \t]+)[A-Za-z_]\w*</Rule>

			<Keywords color="PreprocessorDirectives">
				<Word>#define</Word>
				<Word>#ifdef</Word>
				<Word>#ifndef</Word>
				<Word>#if</Word>
				<Word>#elif</Word>
				<Word>#else</Word>
				<Word>#endif</Word>
				<Word>#undef</Word>
			</Keywords>
