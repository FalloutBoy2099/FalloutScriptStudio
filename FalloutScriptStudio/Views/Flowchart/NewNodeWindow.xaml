<ui:FluentWindow FontSize="12" x:Class="FalloutScriptStudio.Views.Flowchart.NewNodeWindow"
				 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
				 xmlns:local="clr-namespace:FalloutScriptStudio.Views.Flowchart"
				 Title="{DynamicResource Str.Flowchart.NewNodeTitle}"
				 Width="520"
				 Height="470"
				 MinWidth="420"
				 MinHeight="380"
				 ShowInTaskbar="False"
				 WindowStartupLocation="CenterOwner"
				 ExtendsContentIntoTitleBar="True"
				 WindowBackdropType="Mica"
				 Background="{DynamicResource ApplicationBackgroundBrush}"
				 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
	<ui:FluentWindow.Resources>
		<local:NodeTemplateNameConverter x:Key="TemplateNameConverter" />
	</ui:FluentWindow.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<ui:TitleBar Grid.Row="0" Title="{DynamicResource Str.Flowchart.NewNodeTitle}" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />

		<Grid Grid.Row="1" Margin="20,8,20,20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0" Text="{DynamicResource Str.Flowchart.NodeName}" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
			<ui:TextBox Grid.Row="1" x:Name="NameBox" Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" FontSize="14"
						AutomationProperties.Name="{DynamicResource Str.Flowchart.NodeName}" />

			<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,6">
				<TextBlock Text="{DynamicResource Str.Flowchart.Template}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
				<ComboBox MinWidth="220" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
						  AutomationProperties.Name="{DynamicResource Str.Flowchart.TemplateName}">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Name, Converter={StaticResource TemplateNameConverter}}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</StackPanel>

			<ui:TextBox Grid.Row="3" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
						VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="13"
						AutomationProperties.Name="{DynamicResource Str.Flowchart.NodeCode}" />

			<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
				<ui:Button Content="{DynamicResource Str.Flowchart.Create}" Appearance="Primary" MinWidth="96" IsDefault="True" Command="{Binding CreateCommand}" />
				<ui:Button Content="{DynamicResource Str.Common.Cancel}" MinWidth="96" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
			</StackPanel>
		</Grid>
	</Grid>
</ui:FluentWindow>
