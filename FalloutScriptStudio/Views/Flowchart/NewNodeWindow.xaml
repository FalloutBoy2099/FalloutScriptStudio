<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.Flowchart.NewNodeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FalloutScriptStudio.Views.Flowchart"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Str.Flowchart.NewNodeTitle}"
    Width="520"
    Height="470"
    MinWidth="420"
    MinHeight="380"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <ui:FluentWindow.Resources>
        <local:NodeTemplateNameConverter x:Key="TemplateNameConverter" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{DynamicResource Str.Flowchart.NewNodeTitle}"
            Grid.Row="0"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="20,8,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,6"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource Str.Flowchart.NodeName}" />
            <ui:TextBox
                x:Name="NameBox"
                Grid.Row="1"
                AutomationProperties.Name="{DynamicResource Str.Flowchart.NodeName}"
                FontSize="14"
                MaxLength="200"
                Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel
                Grid.Row="2"
                Margin="0,14,0,6"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource Str.Flowchart.Template}" />
                <ComboBox
                    MinWidth="220"
                    AutomationProperties.Name="{DynamicResource Str.Flowchart.TemplateName}"
                    ItemsSource="{Binding Templates}"
                    SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, Converter={StaticResource TemplateNameConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <ui:TextBox
                Grid.Row="3"
                VerticalContentAlignment="Top"
                AcceptsReturn="True"
                AcceptsTab="True"
                AutomationProperties.Name="{DynamicResource Str.Flowchart.NodeCode}"
                FontFamily="Consolas"
                FontSize="13"
                HorizontalScrollBarVisibility="Auto"
                Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto" />

            <StackPanel
                Grid.Row="4"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    MinWidth="96"
                    Appearance="Primary"
                    Command="{Binding CreateCommand}"
                    Content="{DynamicResource Str.Flowchart.Create}"
                    IsDefault="True" />
                <ui:Button
                    MinWidth="96"
                    Margin="8,0,0,0"
                    Command="{Binding CancelCommand}"
                    Content="{DynamicResource Str.Common.Cancel}"
                    IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
