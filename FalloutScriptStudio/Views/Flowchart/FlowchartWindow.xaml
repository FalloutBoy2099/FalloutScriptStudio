<ui:FluentWindow FontSize="12" x:Class="FalloutScriptStudio.Views.Flowchart.FlowchartWindow"
				 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
				 xmlns:diagram="clr-namespace:FalloutScriptStudio.Controls.Diagram"
				 Title="{Binding Title}"
				 Width="1180"
				 Height="760"
				 MinWidth="640"
				 MinHeight="360"
				 ExtendsContentIntoTitleBar="True"
				 WindowBackdropType="Mica"
				 WindowStartupLocation="CenterScreen"
				 Background="{DynamicResource ApplicationBackgroundBrush}"
				 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
	<ui:FluentWindow.InputBindings>
		<KeyBinding Gesture="Alt+E" Command="{Binding EditNodeCommand}" />
		<KeyBinding Gesture="Alt+H" Command="{Binding HideSelectionCommand}" />
		<KeyBinding Gesture="Alt+U" Command="{Binding UnhideAllCommand}" />
		<KeyBinding Gesture="F5" Command="{Binding UpdateCommand}" />
	</ui:FluentWindow.InputBindings>

	<ui:FluentWindow.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />

		<Style x:Key="ToolButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
			<Setter Property="Appearance" Value="Transparent" />
			<Setter Property="MinWidth" Value="34" />
			<Setter Property="Height" Value="34" />
			<Setter Property="Padding" Value="8,0" />
			<Setter Property="Margin" Value="1,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
			<Setter Property="Width" Value="34" />
			<Setter Property="Height" Value="34" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Margin" Value="1,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style x:Key="ToolDivider" TargetType="Border">
			<Setter Property="Width" Value="1" />
			<Setter Property="Height" Value="20" />
			<Setter Property="Margin" Value="6,0" />
			<Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<ContextMenu x:Key="FileMenu">
			<MenuItem Header="{DynamicResource Str.Flowchart.Menu.File.Open}" Command="{Binding OpenFlowchartCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="FolderOpen24" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Header="{DynamicResource Str.Flowchart.Menu.File.Save}" Command="{Binding SaveFlowchartCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="Save24" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Header="{DynamicResource Str.Flowchart.Menu.File.SaveImage}" Command="{Binding SaveImageCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="Image24" />
				</MenuItem.Icon>
			</MenuItem>
			<Separator />
			<MenuItem Header="{DynamicResource Str.Common.Close}" Click="OnCloseClick" />
		</ContextMenu>

		<ContextMenu x:Key="AddMenu">
			<MenuItem Header="{DynamicResource Str.Flowchart.Menu.Add.Node}" Command="{Binding AddNodeCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="Flowchart24" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Header="{DynamicResource Str.Flowchart.Menu.Add.Note}" Command="{Binding AddNoteCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="NoteAdd24" />
				</MenuItem.Icon>
			</MenuItem>
		</ContextMenu>

		<ContextMenu x:Key="OptionsMenu">
			<MenuItem Header="{DynamicResource Str.Flowchart.Menu.Options.FunctionsConfig}" Command="{Binding ShowFunctionRulesCommand}" ToolTip="{DynamicResource Str.Flowchart.Tip.FunctionsConfig}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="Wrench24" />
				</MenuItem.Icon>
			</MenuItem>
			<Separator />
			<MenuItem Header="{DynamicResource Str.Flowchart.Menu.Options.NoExitNode}" IsCheckable="True" IsChecked="{Binding WithoutExitNode, Mode=TwoWay}"
					  ToolTip="{DynamicResource Str.Flowchart.Tip.NoExitNode}" />
			<MenuItem Header="{DynamicResource Str.Flowchart.Menu.Options.AutoHide}" IsCheckable="True" IsChecked="{Binding AutoHideNodes, Mode=TwoWay}"
					  ToolTip="{DynamicResource Str.Flowchart.Tip.AutoHide}" />
			<Separator />
			<MenuItem Header="{DynamicResource Str.Flowchart.Menu.Options.AutoSave}" IsCheckable="True" IsChecked="{Binding AutoSaveChart, Mode=TwoWay}"
					  ToolTip="{DynamicResource Str.Flowchart.Tip.AutoSave}" />
			<MenuItem Header="{DynamicResource Str.Flowchart.Menu.Options.AutoSync}" IsCheckable="True" IsChecked="{Binding AutoUpdate, Mode=TwoWay}"
					  ToolTip="{DynamicResource Str.Flowchart.Tip.AutoSync}" />
			<MenuItem Header="{DynamicResource Str.Flowchart.Menu.Options.AutoArrange}" IsCheckable="True" IsChecked="{Binding AutoArrange, Mode=TwoWay}"
					  ToolTip="{DynamicResource Str.Flowchart.Tip.AutoArrange}" />
			<Separator />
			<MenuItem Header="{DynamicResource Str.Flowchart.Menu.Options.HighQuality}" IsCheckable="True" IsChecked="{Binding HighQuality, Mode=TwoWay}" />
			<MenuItem Header="{DynamicResource Str.Flowchart.Menu.Options.LowDetails}" IsCheckable="True" IsChecked="{Binding LowDetails, Mode=TwoWay}"
					  ToolTip="{DynamicResource Str.Flowchart.Tip.LowDetails}" />
		</ContextMenu>

		<ContextMenu x:Key="NodeMenu">
			<MenuItem Header="{Binding EditNodeHeader}" InputGestureText="Alt+E" IsEnabled="{Binding CanEditNode}" Command="{Binding EditNodeCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="Edit24" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Header="{Binding RenameNodeHeader}" IsEnabled="{Binding CanRenameNode}" Command="{Binding RenameNodeCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="Rename24" />
				</MenuItem.Icon>
			</MenuItem>
			<Separator />
			<MenuItem Tag="jump" Header="{Binding JumpHeader}" IsEnabled="{Binding CanJump}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="ArrowForward24" />
				</MenuItem.Icon>
			</MenuItem>
			<Separator />
			<MenuItem Header="{DynamicResource Str.Flowchart.Menu.Node.Hide}" InputGestureText="Alt+H" IsEnabled="{Binding CanHideSelection}" Command="{Binding HideSelectionCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="EyeOff24" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Tag="unhide" Header="{DynamicResource Str.Flowchart.Menu.Node.Unhide}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="Eye24" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Header="{DynamicResource Str.Flowchart.Menu.Node.UnhideAll}" InputGestureText="Alt+U" Command="{Binding UnhideAllCommand}" />
			<Separator />
			<MenuItem Header="{DynamicResource Str.Flowchart.Menu.Node.Delete}" InputGestureText="Del" ToolTip="{DynamicResource Str.Flowchart.Tip.DeleteSelection}" IsEnabled="{Binding CanDeleteSelection}"
					  Command="{Binding DeleteSelectionCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="Delete24" />
				</MenuItem.Icon>
			</MenuItem>
		</ContextMenu>
	</ui:FluentWindow.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="{Binding Title}" ShowMaximize="True" ShowMinimize="True">
			<ui:TitleBar.Icon>
				<ui:SymbolIcon Symbol="Flowchart24" />
			</ui:TitleBar.Icon>
		</ui:TitleBar>

		<Border Grid.Row="1" Padding="8,2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
			<DockPanel LastChildFill="False">
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="{DynamicResource Str.Flowchart.ZoomLabel}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
					<Slider x:Name="ZoomSlider" Width="130" Minimum="10" Maximum="400" SmallChange="5" LargeChange="25" TickFrequency="50"
							Value="{Binding ZoomPercent, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="{DynamicResource Str.Flowchart.Tip.Zoom}"
							AutomationProperties.Name="{DynamicResource Str.Flowchart.Zoom}" />
					<TextBlock Text="{Binding ZoomText}" Width="46" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,8,0" />
					<ui:Button Style="{StaticResource ToolButton}" Click="OnHelpClick" ToolTip="{DynamicResource Str.Common.Help}" Icon="{ui:SymbolIcon QuestionCircle24}" />
				</StackPanel>
				<WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
					<ui:Button x:Name="FileButton" Style="{StaticResource ToolButton}" Click="OnFileClick" ToolTip="{DynamicResource Str.Flowchart.Tip.File}"
							   Icon="{ui:SymbolIcon Document24}" Content="{DynamicResource Str.Common.File}" />
					<Border Style="{StaticResource ToolDivider}" />
					<ui:Button Style="{StaticResource ToolButton}" Command="{Binding CreateCommand}" ToolTip="{DynamicResource Str.Flowchart.Tip.New}"
							   Icon="{ui:SymbolIcon DocumentAdd24}" Content="{DynamicResource Str.Flowchart.New}" />
					<ui:Button x:Name="AddButton" Style="{StaticResource ToolButton}" Click="OnAddClick" ToolTip="{DynamicResource Str.Flowchart.Tip.Add}"
							   Icon="{ui:SymbolIcon Add24}" Content="{DynamicResource Str.Common.Add}" />
					<Border Style="{StaticResource ToolDivider}" />
					<ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding ShowAllCode, Mode=TwoWay}" ToolTip="{DynamicResource Str.Flowchart.Tip.ShowAllCode}">
						<ui:SymbolIcon Symbol="Code24" />
					</ToggleButton>
					<ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding ShowCommentCode, Mode=TwoWay}" ToolTip="{DynamicResource Str.Flowchart.Tip.ShowCommentCode}">
						<TextBlock Text="//" FontWeight="SemiBold" />
					</ToggleButton>
					<ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding LinksOnlyForSelection, Mode=TwoWay}" ToolTip="{DynamicResource Str.Flowchart.Tip.LinksOnlySelection}">
						<ui:SymbolIcon Symbol="Link24" />
					</ToggleButton>
					<Border Style="{StaticResource ToolDivider}" />
					<ui:Button Style="{StaticResource ToolButton}" Command="{Binding UpdateCommand}" ToolTip="{DynamicResource Str.Flowchart.Tip.UpdateAll}" Icon="{ui:SymbolIcon ArrowSync24}" Content="{DynamicResource Str.Flowchart.Update}" />
					<Border Style="{StaticResource ToolDivider}" />
					<ui:Button Style="{StaticResource ToolButton}" Click="OnCollapseClick" ToolTip="{DynamicResource Str.Flowchart.Tip.CollapseAll}" Icon="{ui:SymbolIcon ArrowMinimizeVertical24}" />
					<ui:Button Style="{StaticResource ToolButton}" Click="OnExpandClick" ToolTip="{DynamicResource Str.Flowchart.Tip.ExpandAll}" Icon="{ui:SymbolIcon ArrowMaximizeVertical24}" />
					<Border Style="{StaticResource ToolDivider}" />
					<ui:Button Style="{StaticResource ToolButton}" Command="{Binding ShrinkAllWidthsCommand}" ToolTip="{DynamicResource Str.Flowchart.Tip.ShrinkWidths}" Icon="{ui:SymbolIcon ArrowCollapseAll24}" />
					<ui:Button Style="{StaticResource ToolButton}" Command="{Binding MatchAllWidthsCommand}" ToolTip="{DynamicResource Str.Flowchart.Tip.MatchWidths}" Icon="{ui:SymbolIcon ArrowAutofitWidth24}" />
					<Border Style="{StaticResource ToolDivider}" />
					<ui:Button Style="{StaticResource ToolButton}" Command="{Binding ArrangeCommand}" ToolTip="{DynamicResource Str.Flowchart.Tip.ArrangeAll}" Icon="{ui:SymbolIcon Branch24}" Content="{DynamicResource Str.Flowchart.Arrange}" />
					<Border Style="{StaticResource ToolDivider}" />
					<ui:Button x:Name="OptionsButton" Style="{StaticResource ToolButton}" Click="OnOptionsClick" ToolTip="{DynamicResource Str.Flowchart.Options}" Icon="{ui:SymbolIcon Settings24}" Content="{DynamicResource Str.Flowchart.Options}" />
				</WrapPanel>
			</DockPanel>
		</Border>

		<Grid Grid.Row="2">
			<diagram:DiagramCanvas x:Name="Canvas" />

			<Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12,14,0" Padding="14,8" MaxWidth="560" BorderThickness="1"
					CornerRadius="{DynamicResource ControlCornerRadius}"
					Background="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}" BorderBrush="{DynamicResource InfoBarInformationalSeverityBorderBrush}"
					Visibility="{Binding IsHintVisible, Converter={StaticResource BoolToVisibility}}">
				<DockPanel>
					<ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="4" Margin="12,0,0,0" VerticalAlignment="Top"
							   Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding DismissHintCommand}" ToolTip="{DynamicResource Str.Flowchart.Dismiss}" />
					<ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="18" Margin="0,2,12,0" VerticalAlignment="Top"
								   Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
					<TextBlock Text="{Binding Hint}" TextWrapping="Wrap" VerticalAlignment="Center" />
				</DockPanel>
			</Border>

			<Popup x:Name="MessagePopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=Canvas}">
				<Border Margin="8" Padding="12,8" MaxWidth="520" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}"
						Background="{DynamicResource FlyoutBackgroundThemeBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
					<Border.Effect>
						<DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" />
					</Border.Effect>
					<TextBlock x:Name="MessagePopupText" TextWrapping="Wrap" FontSize="14" />
				</Border>
			</Popup>

			<Popup x:Name="HelpPopup" StaysOpen="False" AllowsTransparency="True" Placement="Left" HorizontalOffset="0">
				<Border Margin="8" Padding="14,10" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}"
						Background="{DynamicResource FlyoutBackgroundThemeBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
					<Border.Effect>
						<DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" />
					</Border.Effect>
					<TextBlock x:Name="HelpText" Text="{DynamicResource Str.Flowchart.Help}" TextWrapping="Wrap" />
				</Border>
			</Popup>
		</Grid>
	</Grid>
</ui:FluentWindow>
