<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.Flowchart.FlowchartWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:diagram="clr-namespace:FalloutScriptStudio.Controls.Diagram"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="1180"
    Height="760"
    MinWidth="640"
    MinHeight="360"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Command="{Binding EditNodeCommand}" Gesture="Alt+E" />
        <KeyBinding Command="{Binding HideSelectionCommand}" Gesture="Alt+H" />
        <KeyBinding Command="{Binding UnhideAllCommand}" Gesture="Alt+U" />
        <KeyBinding Command="{Binding UpdateCommand}" Gesture="F5" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style
            x:Key="ToolButton"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style
            x:Key="ToolToggle"
            BasedOn="{StaticResource {x:Type ToggleButton}}"
            TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <ContextMenu x:Key="FileMenu">
            <MenuItem Command="{Binding OpenFlowchartCommand}" Header="{DynamicResource Str.Flowchart.Menu.File.Open}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding SaveFlowchartCommand}" Header="{DynamicResource Str.Flowchart.Menu.File.Save}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Save24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding SaveImageCommand}" Header="{DynamicResource Str.Flowchart.Menu.File.SaveImage}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Image24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="OnCloseClick" Header="{DynamicResource Str.Common.Close}" />
        </ContextMenu>

        <ContextMenu x:Key="AddMenu">
            <MenuItem Command="{Binding AddNodeCommand}" Header="{DynamicResource Str.Flowchart.Menu.Add.Node}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Flowchart24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding AddNoteCommand}" Header="{DynamicResource Str.Flowchart.Menu.Add.Note}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="NoteAdd24" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="OptionsMenu">
            <MenuItem
                Command="{Binding ShowFunctionRulesCommand}"
                Header="{DynamicResource Str.Flowchart.Menu.Options.FunctionsConfig}"
                ToolTip="{DynamicResource Str.Flowchart.Tip.FunctionsConfig}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Wrench24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Header="{DynamicResource Str.Flowchart.Menu.Options.NoExitNode}"
                IsCheckable="True"
                IsChecked="{Binding WithoutExitNode, Mode=TwoWay}"
                ToolTip="{DynamicResource Str.Flowchart.Tip.NoExitNode}" />
            <MenuItem
                Header="{DynamicResource Str.Flowchart.Menu.Options.AutoHide}"
                IsCheckable="True"
                IsChecked="{Binding AutoHideNodes, Mode=TwoWay}"
                ToolTip="{DynamicResource Str.Flowchart.Tip.AutoHide}" />
            <Separator />
            <MenuItem
                Header="{DynamicResource Str.Flowchart.Menu.Options.AutoSave}"
                IsCheckable="True"
                IsChecked="{Binding AutoSaveChart, Mode=TwoWay}"
                ToolTip="{DynamicResource Str.Flowchart.Tip.AutoSave}" />
            <MenuItem
                Header="{DynamicResource Str.Flowchart.Menu.Options.AutoSync}"
                IsCheckable="True"
                IsChecked="{Binding AutoUpdate, Mode=TwoWay}"
                ToolTip="{DynamicResource Str.Flowchart.Tip.AutoSync}" />
            <MenuItem
                Header="{DynamicResource Str.Flowchart.Menu.Options.AutoArrange}"
                IsCheckable="True"
                IsChecked="{Binding AutoArrange, Mode=TwoWay}"
                ToolTip="{DynamicResource Str.Flowchart.Tip.AutoArrange}" />
            <Separator />
            <MenuItem
                Header="{DynamicResource Str.Flowchart.Menu.Options.HighQuality}"
                IsCheckable="True"
                IsChecked="{Binding HighQuality, Mode=TwoWay}" />
            <MenuItem
                Header="{DynamicResource Str.Flowchart.Menu.Options.LowDetails}"
                IsCheckable="True"
                IsChecked="{Binding LowDetails, Mode=TwoWay}"
                ToolTip="{DynamicResource Str.Flowchart.Tip.LowDetails}" />
        </ContextMenu>

        <ContextMenu x:Key="NodeMenu">
            <MenuItem
                Command="{Binding EditNodeCommand}"
                Header="{Binding EditNodeHeader}"
                InputGestureText="Alt+E"
                IsEnabled="{Binding CanEditNode}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Edit24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding RenameNodeCommand}"
                Header="{Binding RenameNodeHeader}"
                IsEnabled="{Binding CanRenameNode}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Rename24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Header="{Binding JumpHeader}"
                IsEnabled="{Binding CanJump}"
                Tag="jump">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowForward24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding HideSelectionCommand}"
                Header="{DynamicResource Str.Flowchart.Menu.Node.Hide}"
                InputGestureText="Alt+H"
                IsEnabled="{Binding CanHideSelection}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="EyeOff24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Str.Flowchart.Menu.Node.Unhide}" Tag="unhide">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Eye24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding UnhideAllCommand}"
                Header="{DynamicResource Str.Flowchart.Menu.Node.UnhideAll}"
                InputGestureText="Alt+U" />
            <Separator />
            <MenuItem
                Command="{Binding DeleteSelectionCommand}"
                Header="{DynamicResource Str.Flowchart.Menu.Node.Delete}"
                InputGestureText="Del"
                IsEnabled="{Binding CanDeleteSelection}"
                ToolTip="{DynamicResource Str.Flowchart.Tip.DeleteSelection}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding Title}"
            Grid.Row="0"
            ShowMaximize="True"
            ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Flowchart24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border
            Grid.Row="1"
            Padding="8,2"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Str.Flowchart.ZoomLabel}" />
                    <Slider
                        x:Name="ZoomSlider"
                        Width="130"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource Str.Flowchart.Zoom}"
                        LargeChange="25"
                        Maximum="400"
                        Minimum="10"
                        SmallChange="5"
                        TickFrequency="50"
                        ToolTip="{DynamicResource Str.Flowchart.Tip.Zoom}"
                        Value="{Binding ZoomPercent, Mode=TwoWay}" />
                    <TextBlock
                        Width="46"
                        Margin="6,0,8,0"
                        VerticalAlignment="Center"
                        Text="{Binding ZoomText}"
                        TextAlignment="Right" />
                    <ui:Button
                        Click="OnHelpClick"
                        Icon="{ui:SymbolIcon QuestionCircle24}"
                        Style="{StaticResource ToolButton}"
                        ToolTip="{DynamicResource Str.Common.Help}" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ui:Button
                        x:Name="FileButton"
                        Click="OnFileClick"
                        Content="{DynamicResource Str.Common.File}"
                        Icon="{ui:SymbolIcon Document24}"
                        Style="{StaticResource ToolButton}"
                        ToolTip="{DynamicResource Str.Flowchart.Tip.File}" />
                    <Border Style="{StaticResource ToolDivider}" />
                    <ui:Button
                        Command="{Binding CreateCommand}"
                        Content="{DynamicResource Str.Flowchart.New}"
                        Icon="{ui:SymbolIcon DocumentAdd24}"
                        Style="{StaticResource ToolButton}"
                        ToolTip="{DynamicResource Str.Flowchart.Tip.New}" />
                    <ui:Button
                        x:Name="AddButton"
                        Click="OnAddClick"
                        Content="{DynamicResource Str.Common.Add}"
                        Icon="{ui:SymbolIcon Add24}"
                        Style="{StaticResource ToolButton}"
                        ToolTip="{DynamicResource Str.Flowchart.Tip.Add}" />
                    <Border Style="{StaticResource ToolDivider}" />
                    <ToggleButton
                        IsChecked="{Binding ShowAllCode, Mode=TwoWay}"
                        Style="{StaticResource ToolToggle}"
                        ToolTip="{DynamicResource Str.Flowchart.Tip.ShowAllCode}">
                        <ui:SymbolIcon Symbol="Code24" />
                    </ToggleButton>
                    <ToggleButton
                        IsChecked="{Binding ShowCommentCode, Mode=TwoWay}"
                        Style="{StaticResource ToolToggle}"
                        ToolTip="{DynamicResource Str.Flowchart.Tip.ShowCommentCode}">
                        <TextBlock FontWeight="SemiBold" Text="//" />
                    </ToggleButton>
                    <ToggleButton
                        IsChecked="{Binding LinksOnlyForSelection, Mode=TwoWay}"
                        Style="{StaticResource ToolToggle}"
                        ToolTip="{DynamicResource Str.Flowchart.Tip.LinksOnlySelection}">
                        <ui:SymbolIcon Symbol="Link24" />
                    </ToggleButton>
                    <Border Style="{StaticResource ToolDivider}" />
                    <ui:Button
                        Command="{Binding UpdateCommand}"
                        Content="{DynamicResource Str.Flowchart.Update}"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        Style="{StaticResource ToolButton}"
                        ToolTip="{DynamicResource Str.Flowchart.Tip.UpdateAll}" />
                    <Border Style="{StaticResource ToolDivider}" />
                    <ui:Button
                        Click="OnCollapseClick"
                        Icon="{ui:SymbolIcon ArrowMinimizeVertical24}"
                        Style="{StaticResource ToolButton}"
                        ToolTip="{DynamicResource Str.Flowchart.Tip.CollapseAll}" />
                    <ui:Button
                        Click="OnExpandClick"
                        Icon="{ui:SymbolIcon ArrowMaximizeVertical24}"
                        Style="{StaticResource ToolButton}"
                        ToolTip="{DynamicResource Str.Flowchart.Tip.ExpandAll}" />
                    <Border Style="{StaticResource ToolDivider}" />
                    <ui:Button
                        Command="{Binding ShrinkAllWidthsCommand}"
                        Icon="{ui:SymbolIcon ArrowCollapseAll24}"
                        Style="{StaticResource ToolButton}"
                        ToolTip="{DynamicResource Str.Flowchart.Tip.ShrinkWidths}" />
                    <ui:Button
                        Command="{Binding MatchAllWidthsCommand}"
                        Icon="{ui:SymbolIcon ArrowAutofitWidth24}"
                        Style="{StaticResource ToolButton}"
                        ToolTip="{DynamicResource Str.Flowchart.Tip.MatchWidths}" />
                    <Border Style="{StaticResource ToolDivider}" />
                    <ui:Button
                        Command="{Binding ArrangeCommand}"
                        Content="{DynamicResource Str.Flowchart.Arrange}"
                        Icon="{ui:SymbolIcon Branch24}"
                        Style="{StaticResource ToolButton}"
                        ToolTip="{DynamicResource Str.Flowchart.Tip.ArrangeAll}" />
                    <Border Style="{StaticResource ToolDivider}" />
                    <ui:Button
                        x:Name="OptionsButton"
                        Click="OnOptionsClick"
                        Content="{DynamicResource Str.Flowchart.Options}"
                        Icon="{ui:SymbolIcon Settings24}"
                        Style="{StaticResource ToolButton}"
                        ToolTip="{DynamicResource Str.Flowchart.Options}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <diagram:DiagramCanvas x:Name="Canvas" />

            <Border
                MaxWidth="560"
                Margin="14,12,14,0"
                Padding="14,8"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}"
                BorderBrush="{DynamicResource InfoBarInformationalSeverityBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Visibility="{Binding IsHintVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <ui:Button
                        Margin="12,0,0,0"
                        Padding="4"
                        VerticalAlignment="Top"
                        Appearance="Transparent"
                        Command="{Binding DismissHintCommand}"
                        DockPanel.Dock="Right"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        ToolTip="{DynamicResource Str.Flowchart.Dismiss}" />
                    <ui:SymbolIcon
                        Margin="0,2,12,0"
                        VerticalAlignment="Top"
                        DockPanel.Dock="Left"
                        FontSize="18"
                        Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"
                        Symbol="Info24" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding Hint}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Popup
                x:Name="MessagePopup"
                AllowsTransparency="True"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=Canvas}"
                StaysOpen="False">
                <Border
                    MaxWidth="520"
                    Margin="8"
                    Padding="12,8"
                    Background="{DynamicResource FlyoutBackgroundThemeBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="12"
                            Opacity="0.3"
                            ShadowDepth="2" />
                    </Border.Effect>
                    <TextBlock
                        x:Name="MessagePopupText"
                        FontSize="14"
                        TextWrapping="Wrap" />
                </Border>
            </Popup>

            <Popup
                x:Name="HelpPopup"
                AllowsTransparency="True"
                HorizontalOffset="0"
                Placement="Left"
                StaysOpen="False">
                <Border
                    Margin="8"
                    Padding="14,10"
                    Background="{DynamicResource FlyoutBackgroundThemeBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="12"
                            Opacity="0.3"
                            ShadowDepth="2" />
                    </Border.Effect>
                    <TextBlock
                        x:Name="HelpText"
                        Text="{DynamicResource Str.Flowchart.Help}"
                        TextWrapping="Wrap" />
                </Border>
            </Popup>
        </Grid>
    </Grid>
</ui:FluentWindow>
