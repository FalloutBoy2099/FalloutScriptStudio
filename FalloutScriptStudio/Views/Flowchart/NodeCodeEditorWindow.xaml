<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.Flowchart.NodeCodeEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a11y="clr-namespace:FalloutScriptStudio.Views.Accessibility"
    xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="820"
    Height="620"
    MinWidth="520"
    MinHeight="360"
    a11y:WindowFit.FitToWorkArea="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Command="{Binding UndoCommand}" Gesture="Ctrl+Z" />
        <KeyBinding Command="{Binding RedoCommand}" Gesture="Ctrl+Y" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <Style
            x:Key="ToolButton"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MessageTextBlock" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOption}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="MessageTextEditor"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="TextBox">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <ContextMenu x:Key="CodeMenu">
            <MenuItem Command="{Binding InsertMessageCommand}" Header="{DynamicResource Str.Flowchart.Menu.InsertMessage}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Chat24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                FontWeight="SemiBold"
                Header="{DynamicResource Str.Flowchart.Menu.QuickMacros}"
                Tag="macros">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Code24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Click="OnStoreSnippetClick"
                Header="{DynamicResource Str.Flowchart.Menu.StoreCustom}"
                Tag="store" />
            <Separator />
            <MenuItem
                Command="ApplicationCommands.Cut"
                Header="{DynamicResource Str.Common.Cut}"
                InputGestureText="Ctrl+X">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Cut24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="ApplicationCommands.Copy"
                Header="{DynamicResource Str.Common.Copy}"
                InputGestureText="Ctrl+C">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Copy24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="ApplicationCommands.Paste"
                Header="{DynamicResource Str.Common.Paste}"
                InputGestureText="Ctrl+V">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ClipboardPaste24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="ApplicationCommands.Delete"
                Header="{DynamicResource Str.Common.Delete}"
                InputGestureText="Del">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="170" MinHeight="70" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{Binding Title}"
            Grid.Row="0"
            ShowMaximize="True"
            ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Code24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border
            Grid.Row="1"
            Padding="8,2"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">
                <ui:Button
                    Height="34"
                    Margin="1,0"
                    Padding="12,0"
                    VerticalAlignment="Center"
                    Appearance="Primary"
                    Command="{Binding DoneCommand}"
                    Content="{DynamicResource Str.Flowchart.Done}"
                    Icon="{ui:SymbolIcon Checkmark24}"
                    ToolTip="{DynamicResource Str.Flowchart.Tip.Done}" />
                <Border Style="{StaticResource ToolDivider}" />
                <ui:Button
                    AutomationProperties.Name="{DynamicResource Str.Flowchart.Tip.Undo}"
                    Command="{Binding UndoCommand}"
                    Icon="{ui:SymbolIcon ArrowUndo24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.Flowchart.Tip.Undo}" />
                <ui:Button
                    AutomationProperties.Name="{DynamicResource Str.Flowchart.Tip.Redo}"
                    Command="{Binding RedoCommand}"
                    Icon="{ui:SymbolIcon ArrowRedo24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.Flowchart.Tip.Redo}" />
                <Border Style="{StaticResource ToolDivider}" />
                <ui:Button
                    AutomationProperties.Name="{DynamicResource Str.Flowchart.Tip.PasteNodeName}"
                    Command="{Binding PasteNodeNameCommand}"
                    Icon="{ui:SymbolIcon ClipboardPaste24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.Flowchart.Tip.PasteNodeName}" />
                <ComboBox
                    Width="190"
                    Height="34"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{DynamicResource Str.Flowchart.NodeListName}"
                    DropDownClosed="OnNodeListDropDownClosed"
                    ItemsSource="{Binding NodeChoices}"
                    MaxDropDownHeight="420"
                    SelectedItem="{Binding SelectedNodeChoice, Mode=TwoWay}"
                    ToolTip="{DynamicResource Str.Flowchart.Tip.NodeList}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="ChoiceText" Text="{Binding}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding}" Value="&lt;Unselect Node&gt;">
                                    <Setter TargetName="ChoiceText" Property="Text" Value="{DynamicResource Str.Flowchart.NoNodeChoice}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ui:Button
                    Command="{Binding GoToNodeCommand}"
                    Content="{DynamicResource Str.Flowchart.Go}"
                    Icon="{ui:SymbolIcon ArrowRight24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.Flowchart.Tip.GoToNode}" />
                <Border Style="{StaticResource ToolDivider}" />
                <ToggleButton
                    Width="34"
                    Height="34"
                    Margin="1,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{DynamicResource Str.Flowchart.Tip.OnTop}"
                    IsChecked="{Binding IsOnTop, Mode=TwoWay}"
                    ToolTip="{DynamicResource Str.Flowchart.Tip.OnTop}">
                    <ui:SymbolIcon Symbol="Pin24" />
                </ToggleButton>
            </WrapPanel>
        </Border>

        <ae:TextEditor
            x:Name="CodeEditor"
            Grid.Row="2"
            Padding="2,0,0,0"
            a11y:EditorAutomation.NameResource="Str.Flowchart.NodeCode"
            BorderThickness="0"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            WordWrap="False" />

        <GridSplitter
            Grid.Row="3"
            Height="5"
            HorizontalAlignment="Stretch"
            Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

        <DataGrid
            x:Name="MessageGrid"
            Grid.Row="4"
            Margin="8,4,8,8"
            AutoGenerateColumns="False"
            AutomationProperties.Name="{DynamicResource Str.Flowchart.NodeMessagesName}"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserSortColumns="False"
            GridLinesVisibility="None"
            HeadersVisibility="Column"
            ItemsSource="{Binding Rows}"
            SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
            SelectionMode="Single"
            SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTemplateColumn
                    Width="Auto"
                    MinWidth="72"
                    IsReadOnly="True">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource Str.Common.Line}" ToolTip="{DynamicResource Str.Flowchart.Tip.LineColumn}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button
                                Padding="6,2"
                                HorizontalAlignment="Center"
                                Appearance="Transparent"
                                Command="{Binding DataContext.OpenMessageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}"
                                Content="{Binding MessageNumber}"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                ToolTip="{DynamicResource Str.Flowchart.Tip.OpenMessage}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="*" Header="{DynamicResource Str.Flowchart.Col.MessageText}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource MessageTextBlock}" Text="{Binding Text}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox
                                AutomationProperties.Name="{DynamicResource Str.Flowchart.Col.MessageText}"
                                IsReadOnly="{Binding IsReadOnlyText}"
                                Style="{StaticResource MessageTextEditor}"
                                Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                    Width="130"
                    MinWidth="110"
                    Header="{DynamicResource Str.Flowchart.Col.MsgFile}"
                    IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="6,5"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding FileName}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</ui:FluentWindow>
