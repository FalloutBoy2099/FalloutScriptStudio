<ui:FluentWindow FontSize="12" x:Class="FalloutScriptStudio.Views.ScriptTools.RegisterScriptWindow"
				 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
				 Title="{DynamicResource Str.ScriptTools.RegTitle}"
				 Width="880"
				 Height="620"
				 MinWidth="560"
				 MinHeight="340"
				 ShowInTaskbar="False"
				 WindowStartupLocation="CenterOwner"
				 ExtendsContentIntoTitleBar="True"
				 WindowBackdropType="Mica"
				 Background="{DynamicResource ApplicationBackgroundBrush}"
				 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
				 KeyDown="OnWindowKeyDown">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ui:TitleBar Grid.Row="0"
					 Title="{DynamicResource Str.ScriptTools.RegTitle}"
					 ShowMinimize="False"
					 ShowMaximize="False" />

		<Grid Grid.Row="1" Margin="16,4,16,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="240" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<ui:Button Grid.Column="0"
					   Content="{DynamicResource Str.Common.Save}"
					   Appearance="Primary"
					   Icon="{ui:SymbolIcon Save24}"
					   Command="{Binding SaveCommand}"
					   Click="OnSaveClick"
					   ToolTip="{DynamicResource Str.ScriptTools.RegSaveTip}" />
			<ui:Button Grid.Column="1"
					   Margin="12,0,0,0"
					   Icon="{ui:SymbolIcon Add24}"
					   Command="{Binding AddRowCommand}"
					   ToolTip="{DynamicResource Str.ScriptTools.RegAddRowTip}"
					   AutomationProperties.Name="{DynamicResource Str.ScriptTools.RegAddRowName}" />
			<ui:Button Grid.Column="2"
					   Margin="6,0,0,0"
					   Icon="{ui:SymbolIcon Delete24}"
					   Command="{Binding RemoveLastRowCommand}"
					   ToolTip="{DynamicResource Str.ScriptTools.RegDeleteRowTip}"
					   AutomationProperties.Name="{DynamicResource Str.ScriptTools.RegDeleteRowName}" />
			<ui:TextBox Grid.Column="4"
						Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
						PlaceholderText="{DynamicResource Str.ScriptTools.RegFindPlaceholder}"
						Icon="{ui:SymbolIcon Search24}"
						ClearButtonEnabled="True"
						AutomationProperties.Name="{DynamicResource Str.ScriptTools.RegFindPlaceholder}">
				<ui:TextBox.InputBindings>
					<KeyBinding Key="Enter" Command="{Binding FindNextCommand}" />
				</ui:TextBox.InputBindings>
			</ui:TextBox>
			<ui:Button Grid.Column="5"
					   Margin="6,0,0,0"
					   Icon="{ui:SymbolIcon ArrowUp24}"
					   Command="{Binding FindPreviousCommand}"
					   ToolTip="{DynamicResource Str.ScriptTools.RegFindPrevTip}"
					   AutomationProperties.Name="{DynamicResource Str.ScriptTools.RegFindPrevName}" />
			<ui:Button Grid.Column="6"
					   Margin="6,0,0,0"
					   Icon="{ui:SymbolIcon ArrowDown24}"
					   Command="{Binding FindNextCommand}"
					   ToolTip="{DynamicResource Str.ScriptTools.RegFindNextTip}"
					   AutomationProperties.Name="{DynamicResource Str.ScriptTools.RegFindNextName}" />
		</Grid>

		<ui:InfoBar Grid.Row="2"
					Margin="16,0,16,8"
					Severity="Informational"
					Title=""
					Message="{Binding NoticeMessage}"
					IsOpen="{Binding HasNotice, Mode=OneWay}"
					IsClosable="False" />

		<Grid Grid.Row="3"
			  Margin="16,0,16,10"
			  IsEnabled="{Binding CanDefine}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock Grid.Column="0"
					   VerticalAlignment="Center"
					   Text="{DynamicResource Str.ScriptTools.RegDefineLabel}"
					   ToolTip="{DynamicResource Str.ScriptTools.RegDefineTip}" />
			<ui:TextBox Grid.Column="1"
						Margin="10,0,10,0"
						Text="{Binding DefineName, UpdateSourceTrigger=PropertyChanged}"
						AutomationProperties.Name="{DynamicResource Str.ScriptTools.RegDefineName}" />
			<ui:ToggleSwitch Grid.Column="2"
							 Content="{DynamicResource Str.ScriptTools.RegAllow}"
							 IsChecked="{Binding AllowDefine}"
							 ToolTip="{DynamicResource Str.ScriptTools.RegAllowTip}" />
		</Grid>

		<DataGrid x:Name="ScriptsGrid"
				  Grid.Row="4"
				  Margin="16,0,16,0"
				  ItemsSource="{Binding Entries}"
				  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
				  AutoGenerateColumns="False"
				  CanUserAddRows="False"
				  CanUserDeleteRows="False"
				  CanUserSortColumns="False"
				  CanUserReorderColumns="False"
				  CanUserResizeRows="False"
				  SelectionMode="Single"
				  SelectionUnit="FullRow"
				  HeadersVisibility="Column"
				  GridLinesVisibility="Horizontal"
				  RowHeaderWidth="0"
				  EnableRowVirtualization="True"
				  CurrentCellChanged="OnCurrentCellChanged"
				  HorizontalScrollBarVisibility="Disabled"
				  AutomationProperties.Name="{DynamicResource Str.ScriptTools.RegGridName}">
			<DataGrid.Columns>
				<DataGridTemplateColumn Header="{DynamicResource Str.ScriptTools.RegColNumber}" Width="84" IsReadOnly="True" CanUserResize="False">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<ui:Button Content="{Binding Number}"
									   Appearance="Transparent"
									   Padding="10,2"
									   HorizontalAlignment="Stretch"
									   Command="{Binding DataContext.OpenScriptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
									   CommandParameter="{Binding}"
									   ToolTip="{DynamicResource Str.ScriptTools.RegOpenTip}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTextColumn Header="{DynamicResource Str.ScriptTools.RegColFile}" Width="130" Binding="{Binding Script, UpdateSourceTrigger=LostFocus}" />
				<DataGridTextColumn Header="{DynamicResource Str.ScriptTools.RegColDescriptions}" Width="2*" Binding="{Binding Description, UpdateSourceTrigger=LostFocus}" />
				<DataGridTextColumn Header="{DynamicResource Str.ScriptTools.RegColLocalVars}" Width="70" Binding="{Binding LocalVars, UpdateSourceTrigger=LostFocus}" />
				<DataGridTextColumn Header="{DynamicResource Str.ScriptTools.RegColGameName}" Width="*" Binding="{Binding GameName, UpdateSourceTrigger=LostFocus}" />
			</DataGrid.Columns>
		</DataGrid>

		<TextBlock Grid.Row="5"
				   Margin="16,8,16,10"
				   Text="{Binding StatusText}"
				   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
	</Grid>
</ui:FluentWindow>
