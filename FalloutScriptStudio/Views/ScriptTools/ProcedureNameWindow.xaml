<ui:FluentWindow FontSize="12" x:Class="FalloutScriptStudio.Views.ScriptTools.ProcedureNameWindow"
				 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
				 Title="{Binding Title}"
				 Width="460"
				 SizeToContent="Height"
				 ResizeMode="NoResize"
				 ShowInTaskbar="False"
				 WindowStartupLocation="CenterOwner"
				 ExtendsContentIntoTitleBar="True"
				 WindowBackdropType="Mica"
				 Background="{DynamicResource ApplicationBackgroundBrush}"
				 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
	</Window.Resources>
	<StackPanel>
		<ui:TitleBar Title="{Binding Title}"
					 ShowMinimize="False"
					 ShowMaximize="False"
					 CanMaximize="False" />
		<StackPanel Margin="20,8,20,20">
			<TextBlock Text="{DynamicResource Str.Common.Name}"
					   Margin="0,0,0,6"
					   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
			<ui:TextBox x:Name="NameBox"
						Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
						PlaceholderText="{Binding PlaceholderText}"
						IsReadOnly="{Binding NameReadOnly}"
						MaxLength="200"
						FontSize="14"
						AutomationProperties.Name="{DynamicResource Str.ScriptTools.ProcNameAutomation}" />
			<TextBlock Text="{Binding Hint}"
					   Margin="0,6,0,0"
					   TextWrapping="Wrap"
					   FontSize="12"
					   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
			<ui:InfoBar Margin="0,12,0,0"
						Severity="Error"
						Title="{DynamicResource Str.ScriptTools.ProcInvalidName}"
						Message="{Binding ErrorMessage}"
						IsOpen="{Binding HasError, Mode=OneWay}"
						IsClosable="False" />
			<Border Margin="0,14,0,0"
					Padding="12,10,12,10"
					BorderThickness="1"
					CornerRadius="6"
					BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
					Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
					Visibility="{Binding ShowOptions, Converter={StaticResource BooleanToVisibility}}">
				<StackPanel>
					<TextBlock Text="{DynamicResource Str.ScriptTools.ProcOptions}"
							   FontWeight="SemiBold"
							   Margin="0,0,0,8" />
					<RadioButton Content="{DynamicResource Str.ScriptTools.ProcPlaceAtEnd}"
								 IsChecked="{Binding PlaceAtEnd}"
								 GroupName="Placement"
								 ToolTip="{DynamicResource Str.ScriptTools.ProcPlaceAtEndTip}" />
					<RadioButton Content="{DynamicResource Str.ScriptTools.ProcPlaceAfter}"
								 IsChecked="{Binding PlaceAfterCurrent}"
								 GroupName="Placement"
								 ToolTip="{DynamicResource Str.ScriptTools.ProcPlaceAfterTip}" />
					<CheckBox Content="{DynamicResource Str.ScriptTools.ProcCopyBody}"
							  IsChecked="{Binding CopyBody}"
							  IsEnabled="{Binding CanCopyBody}"
							  Margin="0,6,0,0"
							  ToolTip="{DynamicResource Str.ScriptTools.ProcCopyBodyTip}" />
				</StackPanel>
			</Border>
			<StackPanel Orientation="Horizontal"
						HorizontalAlignment="Right"
						Margin="0,18,0,0">
				<ui:Button Content="{Binding OkText}"
						   Appearance="Primary"
						   MinWidth="96"
						   IsDefault="True"
						   Command="{Binding AcceptCommand}" />
				<ui:Button Content="{DynamicResource Str.Common.Cancel}"
						   MinWidth="96"
						   Margin="8,0,0,0"
						   IsCancel="True"
						   Command="{Binding CancelCommand}" />
			</StackPanel>
		</StackPanel>
	</StackPanel>
</ui:FluentWindow>
