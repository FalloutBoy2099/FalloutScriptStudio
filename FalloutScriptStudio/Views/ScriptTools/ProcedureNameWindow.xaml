<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.ScriptTools.ProcedureNameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="460"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </Window.Resources>
    <StackPanel>
        <ui:TitleBar
            Title="{Binding Title}"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False" />
        <StackPanel Margin="20,8,20,20">
            <TextBlock
                Margin="0,0,0,6"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource Str.Common.Name}" />
            <ui:TextBox
                x:Name="NameBox"
                AutomationProperties.Name="{DynamicResource Str.ScriptTools.ProcNameAutomation}"
                FontSize="14"
                IsReadOnly="{Binding NameReadOnly}"
                MaxLength="200"
                PlaceholderText="{Binding PlaceholderText}"
                Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Margin="0,6,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{Binding Hint}"
                TextWrapping="Wrap" />
            <ui:InfoBar
                Title="{DynamicResource Str.ScriptTools.ProcInvalidName}"
                Margin="0,12,0,0"
                IsClosable="False"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage}"
                Severity="Error" />
            <Border
                Margin="0,14,0,0"
                Padding="12,10,12,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding ShowOptions, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Str.ScriptTools.ProcOptions}" />
                    <RadioButton
                        Content="{DynamicResource Str.ScriptTools.ProcPlaceAtEnd}"
                        GroupName="Placement"
                        IsChecked="{Binding PlaceAtEnd}"
                        ToolTip="{DynamicResource Str.ScriptTools.ProcPlaceAtEndTip}" />
                    <RadioButton
                        Content="{DynamicResource Str.ScriptTools.ProcPlaceAfter}"
                        GroupName="Placement"
                        IsChecked="{Binding PlaceAfterCurrent}"
                        ToolTip="{DynamicResource Str.ScriptTools.ProcPlaceAfterTip}" />
                    <CheckBox
                        Margin="0,6,0,0"
                        Content="{DynamicResource Str.ScriptTools.ProcCopyBody}"
                        IsChecked="{Binding CopyBody}"
                        IsEnabled="{Binding CanCopyBody}"
                        ToolTip="{DynamicResource Str.ScriptTools.ProcCopyBodyTip}" />
                </StackPanel>
            </Border>
            <StackPanel
                Margin="0,18,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    MinWidth="96"
                    Appearance="Primary"
                    Command="{Binding AcceptCommand}"
                    Content="{Binding OkText}"
                    IsDefault="True" />
                <ui:Button
                    MinWidth="96"
                    Margin="8,0,0,0"
                    Command="{Binding CancelCommand}"
                    Content="{DynamicResource Str.Common.Cancel}"
                    IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
