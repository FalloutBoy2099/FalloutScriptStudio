<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.ScriptTools.Dialogs.DialogueRulesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a11y="clr-namespace:FalloutScriptStudio.Views.Accessibility"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:FalloutScriptStudio.ViewModels.ScriptTools.Dialogs"
    Title="{DynamicResource Str.ScriptTools.RulesTitle}"
    Width="780"
    Height="680"
    MinWidth="640"
    MinHeight="520"
    a11y:WindowFit.FitToWorkArea="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="HelpTerm" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,12,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style
            x:Key="RuleRowStyle"
            BasedOn="{StaticResource DefaultDataGridRowStyle}"
            TargetType="DataGridRow">
            <Setter Property="ToolTip" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="ToolTip" Value="{Binding Error}" />
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NumberCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="TextEditStyle"
            BasedOn="{StaticResource DefaultTextBoxStyle}"
            TargetType="TextBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style
            x:Key="NumberEditStyle"
            BasedOn="{StaticResource TextEditStyle}"
            TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{DynamicResource Str.ScriptTools.RulesTitle}"
            Grid.Row="0"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,4,20,10">
            <TextBlock
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource Str.ScriptTools.RulesIntro}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,6,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{Binding BuiltInSummary}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="20,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,8"
                Orientation="Horizontal">
                <ui:Button
                    Command="{Binding AddRuleCommand}"
                    Content="{DynamicResource Str.ScriptTools.RulesAdd}"
                    Icon="{ui:SymbolIcon Add24}"
                    ToolTip="{DynamicResource Str.ScriptTools.RulesAddTip}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Command="{Binding RemoveRuleCommand}"
                    Content="{DynamicResource Str.ScriptTools.RulesBtnRemove}"
                    Icon="{ui:SymbolIcon Delete24}"
                    ToolTip="{DynamicResource Str.ScriptTools.RulesRemoveTip}" />
            </StackPanel>
            <DataGrid
                x:Name="RulesGrid"
                Grid.Row="1"
                AutoGenerateColumns="False"
                AutomationProperties.Name="{DynamicResource Str.ScriptTools.RulesGridName}"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                CanUserResizeRows="False"
                CanUserSortColumns="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                ItemsSource="{Binding Rules}"
                RowStyle="{StaticResource RuleRowStyle}"
                SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                SelectionMode="Single"
                SelectionUnit="FullRow">
                <DataGrid.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding RemoveRuleCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridComboBoxColumn
                        Width="110"
                        Header="{DynamicResource Str.Common.Type}"
                        ItemsSource="{x:Static vm:DialogueRuleItemViewModel.KindNames}"
                        SelectedItemBinding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn
                        x:Name="NameColumn"
                        Width="*"
                        MinWidth="140"
                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        EditingElementStyle="{StaticResource TextEditStyle}"
                        Header="{DynamicResource Str.ScriptTools.RulesColFunction}" />
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="64"
                        Binding="{Binding TotalArgs, UpdateSourceTrigger=PropertyChanged}"
                        EditingElementStyle="{StaticResource NumberEditStyle}"
                        ElementStyle="{StaticResource NumberCellStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str.ScriptTools.RulesColArgs}" ToolTip="{DynamicResource Str.ScriptTools.RulesColArgsTip}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="84"
                        Binding="{Binding MessageArg, UpdateSourceTrigger=PropertyChanged}"
                        EditingElementStyle="{StaticResource NumberEditStyle}"
                        ElementStyle="{StaticResource NumberCellStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str.ScriptTools.RulesColMessage}" ToolTip="{DynamicResource Str.ScriptTools.RulesColMessageTip}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="64"
                        Binding="{Binding NodeArg, UpdateSourceTrigger=PropertyChanged}"
                        EditingElementStyle="{StaticResource NumberEditStyle}"
                        ElementStyle="{StaticResource NumberCellStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str.ScriptTools.RulesColNode}" ToolTip="{DynamicResource Str.ScriptTools.RulesColNodeTip}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="64"
                        Binding="{Binding IqArg, UpdateSourceTrigger=PropertyChanged}"
                        EditingElementStyle="{StaticResource NumberEditStyle}"
                        ElementStyle="{StaticResource NumberCellStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str.ScriptTools.RulesColIq}" ToolTip="{DynamicResource Str.ScriptTools.RulesColIqTip}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="64"
                        Binding="{Binding FileArg, UpdateSourceTrigger=PropertyChanged}"
                        EditingElementStyle="{StaticResource NumberEditStyle}"
                        ElementStyle="{StaticResource NumberCellStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str.ScriptTools.RulesColFile}" ToolTip="{DynamicResource Str.ScriptTools.RulesColFileTip}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Expander
            Grid.Row="3"
            Margin="20,12,20,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Header="{DynamicResource Str.ScriptTools.RulesHelpHeader}"
            IsExpanded="False">
            <Border
                Padding="14,10,14,6"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource HelpTerm}"
                        Text="{DynamicResource Str.Common.Type}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource HelpText}"
                        Text="{DynamicResource Str.ScriptTools.RulesHelpType}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource HelpTerm}"
                        Text="{DynamicResource Str.ScriptTools.RulesColArgs}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource HelpText}"
                        Text="{DynamicResource Str.ScriptTools.RulesHelpArgs}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource HelpTerm}"
                        Text="{DynamicResource Str.ScriptTools.RulesColMessage}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource HelpText}"
                        Text="{DynamicResource Str.ScriptTools.RulesHelpMessage}" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource HelpTerm}"
                        Text="{DynamicResource Str.ScriptTools.RulesColNode}" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource HelpText}"
                        Text="{DynamicResource Str.ScriptTools.RulesHelpNode}" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource HelpTerm}"
                        Text="{DynamicResource Str.ScriptTools.RulesColIq}" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource HelpText}"
                        Text="{DynamicResource Str.ScriptTools.RulesHelpIq}" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Style="{StaticResource HelpTerm}"
                        Text="{DynamicResource Str.ScriptTools.RulesColFile}" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="1"
                        Style="{StaticResource HelpText}"
                        Text="{DynamicResource Str.ScriptTools.RulesHelpFile}" />
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Style="{StaticResource HelpTerm}"
                        Text="{DynamicResource Str.ScriptTools.RulesHelpExample}" />
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="1"
                        Style="{StaticResource HelpText}"
                        Text="{DynamicResource Str.ScriptTools.RulesHelpExampleText}" />
                </Grid>
            </Border>
        </Expander>

        <ui:InfoBar
            Title="{DynamicResource Str.ScriptTools.RulesInvalidRule}"
            Grid.Row="4"
            Margin="20,12,20,0"
            IsClosable="False"
            IsOpen="{Binding HasError, Mode=OneWay}"
            Message="{Binding ErrorMessage}"
            Severity="Error" />

        <StackPanel
            Grid.Row="5"
            Margin="20,16,20,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                MinWidth="96"
                Appearance="Primary"
                Click="OnSaveClick"
                Command="{Binding SaveCommand}"
                Content="{DynamicResource Str.ScriptTools.RulesBtnSave}"
                IsDefault="True" />
            <ui:Button
                MinWidth="96"
                Margin="8,0,0,0"
                Command="{Binding CancelCommand}"
                Content="{DynamicResource Str.Common.Cancel}"
                IsCancel="True" />
        </StackPanel>
    </Grid>

</ui:FluentWindow>