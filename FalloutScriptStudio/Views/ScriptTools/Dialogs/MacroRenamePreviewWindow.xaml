<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.ScriptTools.Dialogs.MacroRenamePreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a11y="clr-namespace:FalloutScriptStudio.Views.Accessibility"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:FalloutScriptStudio.ViewModels.ScriptTools.Dialogs"
    Title="{Binding Title}"
    Width="760"
    Height="640"
    MinWidth="560"
    MinHeight="420"
    a11y:WindowFit.FitToWorkArea="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FocusManager.FocusedElement="{Binding ElementName=MatchTree}"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type vm:MacroRenameNodeViewModel}">
            <StackPanel Orientation="Horizontal">
                <CheckBox
                    Height="20"
                    MinWidth="0"
                    MinHeight="0"
                    Margin="0,0,6,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding Header}"
                    Focusable="False"
                    IsChecked="{Binding IsChecked}"
                    IsThreeState="False" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{Binding Header}" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding CountText}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FileTemplate" DataType="{x:Type vm:MacroRenameNodeViewModel}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding FilePath}">
                <CheckBox
                    Height="20"
                    MinWidth="0"
                    MinHeight="0"
                    Margin="0,0,6,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding Header}"
                    Focusable="False"
                    IsChecked="{Binding IsChecked}"
                    IsThreeState="False" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{Binding Header}" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding CountText}" />
                <TextBlock
                    MaxWidth="360"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding Detail}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="MatchTemplate" DataType="{x:Type vm:MacroRenameNodeViewModel}">
            <StackPanel Orientation="Horizontal">
                <CheckBox
                    Height="20"
                    MinWidth="0"
                    MinHeight="0"
                    Margin="0,0,6,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding Header}"
                    Focusable="False"
                    IsChecked="{Binding IsChecked}"
                    IsThreeState="False" />
                <TextBlock
                    Width="64"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Header}" />
                <TextBlock
                    MaxWidth="560"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="13"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Match.PreviewText}">
                    <Run
                        FontWeight="Bold"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Text="{Binding MatchText, Mode=OneWay}" /><Run Text="{Binding RestText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="NodeContentStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource MatchTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Section">
                    <Setter Property="ContentTemplate" Value="{StaticResource SectionTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="File">
                    <Setter Property="ContentTemplate" Value="{StaticResource FileTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DefinitionText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Command="{Binding ApplyCommand}" Gesture="Ctrl+Return" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{Binding Title}"
            Grid.Row="0"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Border
            Grid.Row="1"
            Margin="20,4,20,0"
            Padding="14,10,14,10"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,14,4"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource Str.ScriptTools.MacroBefore}" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,4"
                    Style="{StaticResource DefinitionText}"
                    Text="{Binding OldDefinition}"
                    ToolTip="{Binding OldDefinition}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,14,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource Str.ScriptTools.MacroAfter}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Style="{StaticResource DefinitionText}"
                    Text="{Binding NewDefinition}"
                    ToolTip="{Binding NewDefinition}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,6,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding DeclaredAtCaption}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding DeclaredAt}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DeclaredAt}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20,14,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button Command="{Binding SelectAllCommand}" Content="{DynamicResource Str.ScriptTools.MacroBtnSelectAll}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Command="{Binding DeselectAllCommand}"
                    Content="{DynamicResource Str.ScriptTools.MacroDeselectAll}" />
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                Margin="16,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding Summary}" />
        </Grid>

        <Border
            Grid.Row="3"
            Margin="20,0,20,0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <TreeView
                x:Name="MatchTree"
                Padding="4"
                AutomationProperties.Name="{DynamicResource Str.ScriptTools.MacroTreeName}"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Sections}"
                KeyDown="OnTreeKeyDown"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0,2" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:MacroRenameNodeViewModel}" ItemsSource="{Binding Children}">
                        <ContentControl
                            Content="{Binding}"
                            Focusable="False"
                            Style="{StaticResource NodeContentStyle}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <StackPanel
            Grid.Row="4"
            Margin="20,16,20,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                MinWidth="96"
                Appearance="Primary"
                Command="{Binding ApplyCommand}"
                Content="{DynamicResource Str.ScriptTools.MacroBtnRename}"
                IsDefault="True"
                ToolTip="{DynamicResource Str.ScriptTools.MacroRenameTip}" />
            <ui:Button
                MinWidth="96"
                Margin="8,0,0,0"
                Command="{Binding CancelCommand}"
                Content="{DynamicResource Str.Common.Cancel}"
                IsCancel="True" />
        </StackPanel>
    </Grid>

</ui:FluentWindow>