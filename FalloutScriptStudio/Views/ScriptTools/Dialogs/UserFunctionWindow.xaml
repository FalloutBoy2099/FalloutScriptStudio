<ui:FluentWindow FontSize="12" x:Class="FalloutScriptStudio.Views.ScriptTools.Dialogs.UserFunctionWindow"
				 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
				 xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
				 Title="{Binding Title}"
				 Width="620" Height="560"
				 MinWidth="480" MinHeight="440"
				 ResizeMode="CanResize"
				 ShowInTaskbar="False"
				 WindowStartupLocation="CenterOwner"
				 ExtendsContentIntoTitleBar="True"
				 WindowBackdropType="Mica"
				 Background="{DynamicResource ApplicationBackgroundBrush}"
				 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
	<Window.InputBindings>
		<KeyBinding Gesture="Ctrl+Return" Command="{Binding AcceptCommand}" />
	</Window.InputBindings>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />

		<Grid Grid.Row="1" Margin="20,8,20,20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0" Text="{DynamicResource Str.Common.Name}" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
			<ui:TextBox x:Name="NameBox"
						Grid.Row="1"
						Text="{Binding FunctionName, UpdateSourceTrigger=PropertyChanged}"
						PlaceholderText="{DynamicResource Str.ScriptTools.UfNamePlaceholder}"
						MaxLength="200"
						AutomationProperties.Name="{DynamicResource Str.ScriptTools.UfNameAutomation}" />

			<TextBlock Grid.Row="2" Text="{DynamicResource Str.ScriptTools.UfDescription}" Margin="0,14,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
			<ui:TextBox Grid.Row="3"
						Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
						PlaceholderText="{DynamicResource Str.ScriptTools.UfDescriptionPlaceholder}"
						TextWrapping="Wrap"
						AcceptsReturn="False"
						MinHeight="56"
						VerticalContentAlignment="Top"
						VerticalScrollBarVisibility="Auto"
						AutomationProperties.Name="{DynamicResource Str.Common.Description}" />

			<Grid Grid.Row="4" Margin="0,14,0,0">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<TextBlock Grid.Row="0" Text="{DynamicResource Str.ScriptTools.UfCode}" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
				<Border Grid.Row="1"
						BorderThickness="1"
						CornerRadius="4"
						BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
						ClipToBounds="True">
					<ae:TextEditor x:Name="CodeEditor"
								   FontFamily="Consolas"
								   FontSize="13"
								   ShowLineNumbers="True"
								   WordWrap="False"
								   Padding="4,2"
								   HorizontalScrollBarVisibility="Auto"
								   VerticalScrollBarVisibility="Auto"
								   AutomationProperties.Name="{DynamicResource Str.ScriptTools.UfCode}" />
				</Border>
			</Grid>

			<TextBlock Grid.Row="5"
					   Margin="0,6,0,0"
					   FontSize="12"
					   TextWrapping="Wrap"
					   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
					   Text="{DynamicResource Str.ScriptTools.UfCodeNote}" />

			<CheckBox Grid.Row="6"
					  Margin="0,10,0,0"
					  Content="{Binding HighlightText}"
					  IsChecked="{Binding AddToHighlight}"
					  IsEnabled="{Binding CanHighlight}"
					  ToolTip="{DynamicResource Str.ScriptTools.UfHighlightTip}" />

			<ui:InfoBar Grid.Row="7"
						Margin="0,12,0,0"
						Severity="Error"
						Title="{DynamicResource Str.ScriptTools.UfInvalid}"
						Message="{Binding ErrorMessage}"
						IsOpen="{Binding HasError, Mode=OneWay}"
						IsClosable="False" />

			<StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
				<ui:Button Content="{Binding OkText}"
						   Appearance="Primary"
						   MinWidth="96"
						   IsDefault="True"
						   Command="{Binding AcceptCommand}" />
				<ui:Button Content="{DynamicResource Str.Common.Cancel}"
						   MinWidth="96"
						   Margin="8,0,0,0"
						   IsCancel="True"
						   Command="{Binding CancelCommand}" />
			</StackPanel>
		</Grid>
	</Grid>
</ui:FluentWindow>
