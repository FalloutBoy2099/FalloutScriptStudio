<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.ScriptTools.Dialogs.UserFunctionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="620"
    Height="560"
    MinWidth="480"
    MinHeight="440"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Window.InputBindings>
        <KeyBinding Command="{Binding AcceptCommand}" Gesture="Ctrl+Return" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{Binding Title}"
            Grid.Row="0"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="20,8,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,6"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource Str.Common.Name}" />
            <ui:TextBox
                x:Name="NameBox"
                Grid.Row="1"
                AutomationProperties.Name="{DynamicResource Str.ScriptTools.UfNameAutomation}"
                MaxLength="200"
                PlaceholderText="{DynamicResource Str.ScriptTools.UfNamePlaceholder}"
                Text="{Binding FunctionName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                Grid.Row="2"
                Margin="0,14,0,6"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource Str.ScriptTools.UfDescription}" />
            <ui:TextBox
                Grid.Row="3"
                MinHeight="56"
                VerticalContentAlignment="Top"
                AcceptsReturn="False"
                AutomationProperties.Name="{DynamicResource Str.Common.Description}"
                PlaceholderText="{DynamicResource Str.ScriptTools.UfDescriptionPlaceholder}"
                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,6"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource Str.ScriptTools.UfCode}" />
                <Border
                    Grid.Row="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="4">
                    <ae:TextEditor
                        x:Name="CodeEditor"
                        Padding="4,2"
                        AutomationProperties.Name="{DynamicResource Str.ScriptTools.UfCode}"
                        FontFamily="Consolas"
                        FontSize="13"
                        HorizontalScrollBarVisibility="Auto"
                        ShowLineNumbers="True"
                        VerticalScrollBarVisibility="Auto"
                        WordWrap="False" />
                </Border>
            </Grid>

            <TextBlock
                Grid.Row="5"
                Margin="0,6,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{DynamicResource Str.ScriptTools.UfCodeNote}"
                TextWrapping="Wrap" />

            <CheckBox
                Grid.Row="6"
                Margin="0,10,0,0"
                Content="{Binding HighlightText}"
                IsChecked="{Binding AddToHighlight}"
                IsEnabled="{Binding CanHighlight}"
                ToolTip="{DynamicResource Str.ScriptTools.UfHighlightTip}" />

            <ui:InfoBar
                Title="{DynamicResource Str.ScriptTools.UfInvalid}"
                Grid.Row="7"
                Margin="0,12,0,0"
                IsClosable="False"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage}"
                Severity="Error" />

            <StackPanel
                Grid.Row="8"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    MinWidth="96"
                    Appearance="Primary"
                    Command="{Binding AcceptCommand}"
                    Content="{Binding OkText}"
                    IsDefault="True" />
                <ui:Button
                    MinWidth="96"
                    Margin="8,0,0,0"
                    Command="{Binding CancelCommand}"
                    Content="{DynamicResource Str.Common.Cancel}"
                    IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
