<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.ScriptTools.ReplacePreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a11y="clr-namespace:FalloutScriptStudio.Views.Accessibility"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:FalloutScriptStudio.ViewModels.ScriptTools"
    Title="{Binding Title}"
    Width="820"
    Height="680"
    MinWidth="600"
    MinHeight="440"
    a11y:WindowFit.FitToWorkArea="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FocusManager.FocusedElement="{Binding ElementName=MatchTree}"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="FileTemplate" DataType="{x:Type vm:ReplaceNodeViewModel}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                <CheckBox
                    Height="20"
                    MinWidth="0"
                    MinHeight="0"
                    Margin="0,0,6,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding AccessibleName}"
                    IsChecked="{Binding IsChecked}"
                    IsThreeState="True" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{Binding Header}" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding CountText}" />
                <TextBlock
                    MaxWidth="360"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding Detail}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="MatchTemplate" DataType="{x:Type vm:ReplaceNodeViewModel}">
            <StackPanel Orientation="Horizontal">
                <CheckBox
                    Height="20"
                    MinWidth="0"
                    MinHeight="0"
                    Margin="0,0,6,0"
                    Padding="0"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{Binding AccessibleName}"
                    IsChecked="{Binding IsChecked}"
                    IsThreeState="False" />
                <TextBlock
                    Width="64"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Header}" />
                <StackPanel>
                    <TextBlock
                        MaxWidth="620"
                        FontFamily="Consolas"
                        FontSize="13"
                        TextTrimming="CharacterEllipsis"><Run Text="- " /><Run Text="{Binding Prefix, Mode=OneWay}" /><Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding Matched, Mode=OneWay}"
                            TextDecorations="Strikethrough" /><Run Text="{Binding Suffix, Mode=OneWay}" /></TextBlock>
                    <TextBlock
                        MaxWidth="620"
                        FontFamily="Consolas"
                        FontSize="13"
                        TextTrimming="CharacterEllipsis"><Run Text="+ " /><Run Text="{Binding Prefix, Mode=OneWay}" /><Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                            Text="{Binding Replacement, Mode=OneWay}" /><Run Text="{Binding Suffix, Mode=OneWay}" /></TextBlock>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="NodeContentStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource MatchTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFile}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource FileTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Command="{Binding ApplyCommand}" Gesture="Ctrl+Return" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{Binding Title}"
            Grid.Row="0"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Border
            Grid.Row="1"
            Margin="20,4,20,0"
            Padding="14,10,14,10"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,14,4"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource Str.ScriptTools.ReplFind}" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,4"
                    FontFamily="Consolas"
                    FontSize="13"
                    Text="{Binding FindText}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding FindText}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,14,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource Str.ScriptTools.ReplWith}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    FontFamily="Consolas"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding ReplaceText}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding ReplaceText}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,6,0,0"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding OptionsText}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20,14,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button Command="{Binding SelectAllCommand}" Content="{DynamicResource Str.ScriptTools.MacroBtnSelectAll}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Command="{Binding DeselectAllCommand}"
                    Content="{DynamicResource Str.ScriptTools.MacroDeselectAll}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Command="{Binding ExpandAllCommand}"
                    Content="{DynamicResource Str.Shell.Menu.ExpandAll}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Command="{Binding CollapseAllCommand}"
                    Content="{DynamicResource Str.Shell.Menu.CollapseAll}" />
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                Margin="16,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                a11y:LiveRegion.Text="{Binding Summary}"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding Summary}" />
        </Grid>

        <ui:InfoBar
            Title=""
            Grid.Row="3"
            Margin="20,0,20,8"
            IsClosable="False"
            IsOpen="{Binding IsTruncated, Mode=OneWay}"
            Message="{Binding TruncatedText}"
            Severity="Warning" />

        <Border
            Grid.Row="4"
            Margin="20,0,20,0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <TreeView
                x:Name="MatchTree"
                Padding="4"
                AutomationProperties.Name="{DynamicResource Str.ScriptTools.ReplTreeName}"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Files}"
                KeyDown="OnTreeKeyDown"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0,2" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:ReplaceNodeViewModel}" ItemsSource="{Binding Children}">
                        <ContentControl
                            Content="{Binding}"
                            Focusable="False"
                            Style="{StaticResource NodeContentStyle}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <Expander
            Grid.Row="5"
            Margin="20,8,20,0"
            Header="{Binding SkippedText}"
            Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVisibility}}">
            <ListBox
                MaxHeight="120"
                AutomationProperties.Name="{DynamicResource Str.ScriptTools.ReplSkippedName}"
                ItemsSource="{Binding SkippedItems}" />
        </Expander>

        <StackPanel
            Grid.Row="6"
            Margin="20,16,20,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                MinWidth="96"
                Appearance="Primary"
                Command="{Binding ApplyCommand}"
                Content="{DynamicResource Str.ScriptTools.ReplBtnApply}"
                IsDefault="True"
                ToolTip="{DynamicResource Str.ScriptTools.ReplApplyTip}" />
            <ui:Button
                MinWidth="96"
                Margin="8,0,0,0"
                Command="{Binding CancelCommand}"
                Content="{DynamicResource Str.Common.Cancel}"
                IsCancel="True" />
        </StackPanel>
    </Grid>

</ui:FluentWindow>