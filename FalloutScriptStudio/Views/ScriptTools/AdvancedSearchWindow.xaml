<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.ScriptTools.AdvancedSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a11y="clr-namespace:FalloutScriptStudio.Views.Accessibility"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Str.ScriptTools.SearchTitle}"
    Width="720"
    Height="760"
    MinWidth="560"
    MinHeight="560"
    a11y:WindowFit.FitToWorkArea="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    KeyDown="OnWindowKeyDown"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="FieldCaption" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{DynamicResource Str.ScriptTools.SearchTitle}"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource FieldCaption}" Text="{DynamicResource Str.ScriptTools.SearchFindText}" />
                <ComboBox
                    x:Name="SearchBox"
                    AutomationProperties.Name="{DynamicResource Str.ScriptTools.SearchFindText}"
                    IsEditable="True"
                    ItemsSource="{Binding QueryHistory}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource FieldCaption}" Text="{DynamicResource Str.ScriptTools.SearchReplaceText}" />
                <ui:TextBox AutomationProperties.Name="{DynamicResource Str.ScriptTools.SearchReplaceText}" Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                <CheckBox
                    Margin="0,0,20,0"
                    Content="{DynamicResource Str.ScriptTools.SearchMatchCase}"
                    IsChecked="{Binding MatchCase}" />
                <CheckBox
                    Margin="0,0,20,0"
                    Content="{DynamicResource Str.ScriptTools.SearchWholeWord}"
                    IsChecked="{Binding WholeWord}"
                    IsEnabled="{Binding CanChangeWholeWord}" />
                <CheckBox Content="{DynamicResource Str.ScriptTools.SearchRegex}" IsChecked="{Binding UseRegex}" />
            </WrapPanel>

            <Border
                Grid.Row="3"
                Margin="0,12,0,0"
                Padding="12,10,12,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Str.ScriptTools.SearchIn}" />
                    <WrapPanel>
                        <RadioButton
                            Margin="0,0,20,0"
                            Content="{DynamicResource Str.ScriptTools.SearchScopeCurrent}"
                            GroupName="Scope"
                            IsChecked="{Binding IsCurrentScope}"
                            ToolTip="{DynamicResource Str.ScriptTools.SearchScopeCurrentTip}" />
                        <RadioButton
                            Margin="0,0,20,0"
                            Content="{DynamicResource Str.ScriptTools.SearchScopeOpen}"
                            GroupName="Scope"
                            IsChecked="{Binding IsOpenScope}"
                            ToolTip="{DynamicResource Str.ScriptTools.SearchScopeOpenTip}" />
                        <RadioButton
                            Content="{DynamicResource Str.ScriptTools.SearchScopeFolder}"
                            GroupName="Scope"
                            IsChecked="{Binding IsFolderScope}"
                            ToolTip="{DynamicResource Str.ScriptTools.SearchScopeFolderTip}" />
                    </WrapPanel>
                    <Grid Margin="0,10,0,0" IsEnabled="{Binding IsFolderScope}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox
                            Grid.Row="0"
                            Grid.Column="0"
                            AutomationProperties.Name="{DynamicResource Str.ScriptTools.SearchFolderName}"
                            IsEditable="True"
                            ItemsSource="{Binding Folders}"
                            Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{DynamicResource Str.ScriptTools.SearchFolderTip}" />
                        <ui:Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Command="{Binding BrowseFolderCommand}"
                            Content="{DynamicResource Str.ScriptTools.SearchBtnBrowse}"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            ToolTip="{DynamicResource Str.ScriptTools.SearchBrowseTip}" />
                        <ui:Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            AutomationProperties.Name="{DynamicResource Str.ScriptTools.SearchRemoveFolderName}"
                            Command="{Binding RemoveSavedFolderCommand}"
                            Icon="{ui:SymbolIcon Delete24}"
                            ToolTip="{DynamicResource Str.ScriptTools.SearchRemoveFolderTip}" />
                        <WrapPanel
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Margin="0,10,0,0">
                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Text="{DynamicResource Str.ScriptTools.SearchFileTypes}" />
                            <ComboBox
                                Width="200"
                                AutomationProperties.Name="{DynamicResource Str.ScriptTools.SearchFileTypes}"
                                IsEditable="True"
                                ItemsSource="{Binding MaskPresets}"
                                Text="{Binding FileMask, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="{DynamicResource Str.ScriptTools.SearchFileTypesTip}" />
                            <ui:ToggleSwitch
                                Margin="24,0,0,0"
                                Content="{DynamicResource Str.ScriptTools.SearchIncludeSubfolders}"
                                IsChecked="{Binding IncludeSubfolders}" />
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <WrapPanel Grid.Row="4" Margin="0,12,0,0">
                <ui:Button
                    Appearance="Primary"
                    Command="{Binding SearchCommand}"
                    Content="{DynamicResource Str.ScriptTools.SearchFindNext}"
                    Icon="{ui:SymbolIcon Search24}"
                    IsDefault="True"
                    ToolTip="{DynamicResource Str.ScriptTools.SearchFindNextTip}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Command="{Binding FindAllCommand}"
                    Content="{DynamicResource Str.ScriptTools.SearchFindAll}"
                    ToolTip="{DynamicResource Str.ScriptTools.SearchFindAllTip}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Command="{Binding ReplaceCommand}"
                    Content="{DynamicResource Str.ScriptTools.SearchBtnReplace}"
                    ToolTip="{DynamicResource Str.ScriptTools.SearchReplaceTip}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Command="{Binding ReplaceAllCommand}"
                    Content="{DynamicResource Str.ScriptTools.SearchBtnReplaceAll}"
                    ToolTip="{DynamicResource Str.ScriptTools.SearchReplaceAllTip}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Command="{Binding FindAllCancelCommand}"
                    Content="{DynamicResource Str.Common.Cancel}"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibility}}" />
            </WrapPanel>

            <ui:InfoBar
                Title=""
                Grid.Row="5"
                Margin="0,12,0,0"
                IsClosable="False"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage}"
                Severity="Error" />

            <StackPanel Grid.Row="6" Margin="0,12,0,6">
                <ProgressBar
                    Height="4"
                    Margin="0,0,0,6"
                    AutomationProperties.Name="{Binding StatusText}"
                    Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                    Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibility}}"
                    Value="{Binding ProgressValue, Mode=OneWay}" />
                <TextBlock
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding StatusText}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <DataGrid
                x:Name="ResultsGrid"
                Grid.Row="7"
                AutoGenerateColumns="False"
                AutomationProperties.Name="{DynamicResource Str.ScriptTools.SearchResultsName}"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                HorizontalScrollBarVisibility="Disabled"
                IsReadOnly="True"
                ItemsSource="{Binding Results}"
                KeyDown="OnResultKeyDown"
                MouseDoubleClick="OnResultDoubleClick"
                RowHeaderWidth="0"
                SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                SelectionMode="Single"
                SelectionUnit="FullRow">
                <DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource DefaultDataGridRowStyle}" TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding FullPath}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding FileName}"
                        Header="{DynamicResource Str.Common.File}" />
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding Line}"
                        Header="{DynamicResource Str.Common.Line}" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Text}"
                        Header="{DynamicResource Str.ScriptTools.SearchColText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</ui:FluentWindow>
