<ui:FluentWindow FontSize="12" x:Class="FalloutScriptStudio.Views.ScriptTools.AdvancedSearchWindow"
				 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
				 Title="{DynamicResource Str.ScriptTools.SearchTitle}"
				 Width="720"
				 Height="760"
				 MinWidth="560"
				 MinHeight="560"
				 ShowInTaskbar="False"
				 WindowStartupLocation="CenterOwner"
				 ExtendsContentIntoTitleBar="True"
				 WindowBackdropType="Mica"
				 Background="{DynamicResource ApplicationBackgroundBrush}"
				 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
				 KeyDown="OnWindowKeyDown">
	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
		<Style x:Key="FieldCaption" TargetType="TextBlock">
			<Setter Property="Margin" Value="0,0,0,4" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
		</Style>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<ui:TitleBar Grid.Row="0"
					 Title="{DynamicResource Str.ScriptTools.SearchTitle}"
					 ShowMinimize="False"
					 ShowMaximize="False" />

		<Grid Grid.Row="1" Margin="16,4,16,16">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0">
				<TextBlock Text="{DynamicResource Str.ScriptTools.SearchFindText}" Style="{StaticResource FieldCaption}" />
				<ComboBox x:Name="SearchBox"
						  IsEditable="True"
						  ItemsSource="{Binding QueryHistory}"
						  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
						  AutomationProperties.Name="{DynamicResource Str.ScriptTools.SearchFindText}" />
			</StackPanel>

			<StackPanel Grid.Row="1" Margin="0,10,0,0">
				<TextBlock Text="{DynamicResource Str.ScriptTools.SearchReplaceText}" Style="{StaticResource FieldCaption}" />
				<ui:TextBox Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
							AutomationProperties.Name="{DynamicResource Str.ScriptTools.SearchReplaceText}" />
			</StackPanel>

			<WrapPanel Grid.Row="2" Margin="0,12,0,0">
				<CheckBox Content="{DynamicResource Str.ScriptTools.SearchMatchCase}"
						  IsChecked="{Binding MatchCase}"
						  Margin="0,0,20,0" />
				<CheckBox Content="{DynamicResource Str.ScriptTools.SearchWholeWord}"
						  IsChecked="{Binding WholeWord}"
						  IsEnabled="{Binding CanChangeWholeWord}"
						  Margin="0,0,20,0" />
				<CheckBox Content="{DynamicResource Str.ScriptTools.SearchRegex}"
						  IsChecked="{Binding UseRegex}" />
			</WrapPanel>

			<Border Grid.Row="3"
					Margin="0,12,0,0"
					Padding="12,10,12,12"
					BorderThickness="1"
					CornerRadius="6"
					BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
					Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
				<StackPanel>
					<TextBlock Text="{DynamicResource Str.ScriptTools.SearchIn}"
							   FontWeight="SemiBold"
							   Margin="0,0,0,8" />
					<WrapPanel>
						<RadioButton Content="{DynamicResource Str.ScriptTools.SearchScopeCurrent}"
									 IsChecked="{Binding IsCurrentScope}"
									 GroupName="Scope"
									 Margin="0,0,20,0"
									 ToolTip="{DynamicResource Str.ScriptTools.SearchScopeCurrentTip}" />
						<RadioButton Content="{DynamicResource Str.ScriptTools.SearchScopeOpen}"
									 IsChecked="{Binding IsOpenScope}"
									 GroupName="Scope"
									 Margin="0,0,20,0"
									 ToolTip="{DynamicResource Str.ScriptTools.SearchScopeOpenTip}" />
						<RadioButton Content="{DynamicResource Str.ScriptTools.SearchScopeFolder}"
									 IsChecked="{Binding IsFolderScope}"
									 GroupName="Scope"
									 ToolTip="{DynamicResource Str.ScriptTools.SearchScopeFolderTip}" />
					</WrapPanel>
					<Grid Margin="0,10,0,0"
						  IsEnabled="{Binding IsFolderScope}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<ComboBox Grid.Row="0"
								  Grid.Column="0"
								  IsEditable="True"
								  ItemsSource="{Binding Folders}"
								  Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
								  ToolTip="{DynamicResource Str.ScriptTools.SearchFolderTip}"
								  AutomationProperties.Name="{DynamicResource Str.ScriptTools.SearchFolderName}" />
						<ui:Button Grid.Row="0"
								   Grid.Column="1"
								   Margin="8,0,0,0"
								   Content="{DynamicResource Str.Common.Browse}"
								   Icon="{ui:SymbolIcon FolderOpen24}"
								   Command="{Binding BrowseFolderCommand}"
								   ToolTip="{DynamicResource Str.ScriptTools.SearchBrowseTip}" />
						<ui:Button Grid.Row="0"
								   Grid.Column="2"
								   Margin="6,0,0,0"
								   Icon="{ui:SymbolIcon Delete24}"
								   Command="{Binding RemoveSavedFolderCommand}"
								   ToolTip="{DynamicResource Str.ScriptTools.SearchRemoveFolderTip}"
								   AutomationProperties.Name="{DynamicResource Str.ScriptTools.SearchRemoveFolderName}" />
						<WrapPanel Grid.Row="1"
								   Grid.ColumnSpan="3"
								   Margin="0,10,0,0">
							<TextBlock Text="{DynamicResource Str.ScriptTools.SearchFileTypes}"
									   VerticalAlignment="Center"
									   Margin="0,0,10,0" />
							<ComboBox IsEditable="True"
									  Width="200"
									  ItemsSource="{Binding MaskPresets}"
									  Text="{Binding FileMask, UpdateSourceTrigger=PropertyChanged}"
									  ToolTip="{DynamicResource Str.ScriptTools.SearchFileTypesTip}"
									  AutomationProperties.Name="{DynamicResource Str.ScriptTools.SearchFileTypes}" />
							<ui:ToggleSwitch Content="{DynamicResource Str.ScriptTools.SearchIncludeSubfolders}"
											 IsChecked="{Binding IncludeSubfolders}"
											 Margin="24,0,0,0" />
						</WrapPanel>
					</Grid>
				</StackPanel>
			</Border>

			<WrapPanel Grid.Row="4"
					   Margin="0,12,0,0">
				<ui:Button Content="{DynamicResource Str.ScriptTools.SearchFindNext}"
						   Appearance="Primary"
						   Icon="{ui:SymbolIcon Search24}"
						   IsDefault="True"
						   Command="{Binding SearchCommand}"
						   ToolTip="{DynamicResource Str.ScriptTools.SearchFindNextTip}" />
				<ui:Button Content="{DynamicResource Str.ScriptTools.SearchFindAll}"
						   Margin="8,0,0,0"
						   Command="{Binding FindAllCommand}"
						   ToolTip="{DynamicResource Str.ScriptTools.SearchFindAllTip}" />
				<ui:Button Content="{DynamicResource Str.Common.Replace}"
						   Margin="8,0,0,0"
						   Command="{Binding ReplaceCommand}"
						   ToolTip="{DynamicResource Str.ScriptTools.SearchReplaceTip}" />
				<ui:Button Content="{DynamicResource Str.ScriptTools.SearchReplaceAll}"
						   Margin="8,0,0,0"
						   Command="{Binding ReplaceAllCommand}"
						   ToolTip="{DynamicResource Str.ScriptTools.SearchReplaceAllTip}" />
				<ui:Button Content="{DynamicResource Str.Common.Cancel}"
						   Margin="8,0,0,0"
						   Icon="{ui:SymbolIcon Dismiss24}"
						   Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibility}}"
						   Command="{Binding FindAllCancelCommand}" />
			</WrapPanel>

			<ui:InfoBar Grid.Row="5"
						Margin="0,12,0,0"
						Severity="Error"
						Title=""
						Message="{Binding ErrorMessage}"
						IsOpen="{Binding HasError, Mode=OneWay}"
						IsClosable="False" />

			<StackPanel Grid.Row="6" Margin="0,12,0,6">
				<ProgressBar Maximum="{Binding ProgressMaximum, Mode=OneWay}"
							 Value="{Binding ProgressValue, Mode=OneWay}"
							 Height="4"
							 Margin="0,0,0,6"
							 Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibility}}" />
				<TextBlock Text="{Binding StatusText}"
						   TextTrimming="CharacterEllipsis"
						   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
			</StackPanel>

			<DataGrid x:Name="ResultsGrid"
					  Grid.Row="7"
					  ItemsSource="{Binding Results}"
					  SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
					  AutoGenerateColumns="False"
					  IsReadOnly="True"
					  CanUserAddRows="False"
					  CanUserDeleteRows="False"
					  SelectionMode="Single"
					  SelectionUnit="FullRow"
					  HeadersVisibility="Column"
					  GridLinesVisibility="Horizontal"
					  RowHeaderWidth="0"
					  MouseDoubleClick="OnResultDoubleClick"
					  HorizontalScrollBarVisibility="Disabled"
					  AutomationProperties.Name="{DynamicResource Str.ScriptTools.SearchResultsName}">
				<DataGrid.RowStyle>
					<Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
						<Setter Property="ToolTip" Value="{Binding FullPath}" />
					</Style>
				</DataGrid.RowStyle>
				<DataGrid.Columns>
					<DataGridTextColumn Header="{DynamicResource Str.Common.File}" Width="150" Binding="{Binding FileName}" />
					<DataGridTextColumn Header="{DynamicResource Str.Common.Line}" Width="60" Binding="{Binding Line}" />
					<DataGridTextColumn Header="{DynamicResource Str.ScriptTools.SearchColText}" Width="*" Binding="{Binding Text}" />
				</DataGrid.Columns>
			</DataGrid>
		</Grid>
	</Grid>
</ui:FluentWindow>
