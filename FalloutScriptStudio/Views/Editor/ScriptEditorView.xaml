<UserControl
    x:Class="FalloutScriptStudio.Views.Editor.ScriptEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a11y="clr-namespace:FalloutScriptStudio.Views.Accessibility"
    xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
    Focusable="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="PrimaryRow" Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="SecondaryRow" Height="0" />
        </Grid.RowDefinitions>

        <ae:TextEditor
            x:Name="PrimaryEditor"
            Grid.Row="0"
            Padding="2,0,0,0"
            a11y:EditorAutomation.NameResource="Str.Editor.A11y.ScriptEditor"
            BorderThickness="0"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            WordWrap="False" />

        <GridSplitter
            x:Name="SplitSplitter"
            Grid.Row="1"
            Height="5"
            HorizontalAlignment="Stretch"
            Background="{DynamicResource ControlStrokeColorDefaultBrush}"
            Visibility="Collapsed" />

        <ae:TextEditor
            x:Name="SecondaryEditor"
            Grid.Row="2"
            Padding="2,0,0,0"
            a11y:EditorAutomation.NameResource="Str.Editor.A11y.ScriptEditorSplit"
            BorderThickness="0"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed"
            WordWrap="False" />
    </Grid>

</UserControl>