<ResourceDictionary
    x:Class="FalloutScriptStudio.Views.Editor.EditorPopupResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:completion="clr-namespace:FalloutScriptStudio.Editor.Completion"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <DataTemplate x:Key="CompletionItemTemplate" DataType="{x:Type completion:ScriptCompletionData}">
        <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontSize="15"
                Foreground="{Binding ItemBrush}"
                Symbol="{Binding Symbol}" />
            <TextBlock
                VerticalAlignment="Center"
                FontFamily="{Binding ItemFontFamily}"
                FontWeight="{Binding ItemFontWeight}"
                Foreground="{Binding ItemBrush}"
                Text="{Binding Text}" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="CompletionItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="3,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="4">
                        <Grid>
                            <Border
                                x:Name="Bar"
                                Width="3"
                                Height="14"
                                Margin="-6,0,0,0"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="1.5"
                                Visibility="Collapsed" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>