<ui:FluentWindow FontSize="12" x:Class="FalloutScriptStudio.Views.DialoguePreview.DialoguePreviewWindow"
				 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
				 Title="{Binding Title}"
				 Width="860"
				 Height="560"
				 MinWidth="520"
				 MinHeight="300"
				 ExtendsContentIntoTitleBar="True"
				 WindowBackdropType="Mica"
				 WindowStartupLocation="CenterScreen"
				 Background="{DynamicResource ApplicationBackgroundBrush}"
				 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
	<ui:FluentWindow.Resources>
		<Style x:Key="ToolButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
			<Setter Property="Appearance" Value="Transparent" />
			<Setter Property="MinWidth" Value="34" />
			<Setter Property="Height" Value="34" />
			<Setter Property="Padding" Value="8,0" />
			<Setter Property="Margin" Value="1,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style x:Key="ToolDivider" TargetType="Border">
			<Setter Property="Width" Value="1" />
			<Setter Property="Height" Value="20" />
			<Setter Property="Margin" Value="6,0" />
			<Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style x:Key="PlainCell" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="6,5" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>

		<Style x:Key="MessageCell" TargetType="TextBlock" BasedOn="{StaticResource PlainCell}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsOption}" Value="True">
					<Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsError}" Value="True">
					<Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="TargetCell" TargetType="TextBlock" BasedOn="{StaticResource PlainCell}">
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
			<Setter Property="TextWrapping" Value="NoWrap" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding CanFollow}" Value="True">
					<Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</ui:FluentWindow.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMaximize="True" ShowMinimize="True">
			<ui:TitleBar.Icon>
				<ui:SymbolIcon Symbol="ChatMultiple24" />
			</ui:TitleBar.Icon>
		</ui:TitleBar>

		<Border Grid.Row="1" Padding="8,2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
			<WrapPanel Orientation="Horizontal">
				<TextBlock Text="{DynamicResource Str.Flowchart.NodesLabel}" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
				<ComboBox Width="190" Height="34" VerticalAlignment="Center" ItemsSource="{Binding NodeNames}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
						  MaxDropDownHeight="420" ToolTip="{DynamicResource Str.Flowchart.Tip.PreviewNode}" AutomationProperties.Name="{DynamicResource Str.Flowchart.PreviewNodeName}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding GoBackCommand}" ToolTip="{DynamicResource Str.Flowchart.Back}" Icon="{ui:SymbolIcon ArrowLeft24}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding GoForwardCommand}" ToolTip="{DynamicResource Str.Flowchart.Forward}" Icon="{ui:SymbolIcon ArrowRight24}" />
				<Border Style="{StaticResource ToolDivider}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding UpdateScriptCommand}" ToolTip="{DynamicResource Str.Flowchart.Tip.PreviewUpdate}" Icon="{ui:SymbolIcon ArrowSync24}" Content="{DynamicResource Str.Flowchart.Update}" />
				<Border Style="{StaticResource ToolDivider}" />
				<CheckBox Content="{DynamicResource Str.Flowchart.PlayerFemale}" IsChecked="{Binding IsFemale, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0,6,0"
						  ToolTip="{DynamicResource Str.Flowchart.Tip.PlayerFemale}" />
				<ui:TextBox Width="70" Height="34" VerticalAlignment="Center" TextAlignment="Right" IsEnabled="{Binding IsFemale}" Text="{Binding FemaleOffsetText, UpdateSourceTrigger=PropertyChanged}"
							ToolTip="{DynamicResource Str.Flowchart.Tip.FemaleOffset}" AutomationProperties.Name="{DynamicResource Str.Flowchart.FemaleOffsetName}" />
				<Border Style="{StaticResource ToolDivider}" />
				<CheckBox Content="{DynamicResource Str.Flowchart.AutoJump}" IsChecked="{Binding AutoJump, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0,6,0"
						  ToolTip="{DynamicResource Str.Flowchart.Tip.AutoJump}" />
				<Border Style="{StaticResource ToolDivider}" />
				<TextBlock Text="{Binding OptionText}" VerticalAlignment="Center" Margin="4,0" FontWeight="SemiBold" MaxWidth="260" TextTrimming="CharacterEllipsis"
						   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" ToolTip="{Binding OptionText}" />
			</WrapPanel>
		</Border>

		<DataGrid x:Name="MessageGrid" Grid.Row="2" Margin="8" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
				  CanUserReorderColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" SelectionUnit="FullRow"
				  ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" MouseDoubleClick="OnGridDoubleClick" AutomationProperties.Name="{DynamicResource Str.Flowchart.NodeMessagesName}">
			<DataGrid.Columns>
				<DataGridTemplateColumn MinWidth="110" Width="150">
					<DataGridTemplateColumn.Header>
						<TextBlock Text="{DynamicResource Str.Flowchart.Col.Procedure}" ToolTip="{DynamicResource Str.Flowchart.Tip.ProcedureColumn}" />
					</DataGridTemplateColumn.Header>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Target}" Style="{StaticResource TargetCell}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Width="*">
					<DataGridTemplateColumn.Header>
						<TextBlock Text="{DynamicResource Str.Flowchart.Col.Text}" ToolTip="{DynamicResource Str.Flowchart.Tip.TextColumn}" />
					</DataGridTemplateColumn.Header>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Text}" Style="{StaticResource MessageCell}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Width="52">
					<DataGridTemplateColumn.Header>
						<TextBlock Text="{DynamicResource Str.Flowchart.Col.Iq}" ToolTip="{DynamicResource Str.Flowchart.Tip.IqColumn}" />
					</DataGridTemplateColumn.Header>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Iq}" Style="{StaticResource PlainCell}" HorizontalAlignment="Center" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn MinWidth="72" Width="Auto">
					<DataGridTemplateColumn.Header>
						<TextBlock Text="{DynamicResource Str.Common.Line}" ToolTip="{DynamicResource Str.Flowchart.Tip.LineColumn}" />
					</DataGridTemplateColumn.Header>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<ui:Button Appearance="Transparent" Padding="6,2" HorizontalAlignment="Center" Content="{Binding LineText}" IsEnabled="{Binding CanEditMessage}"
									   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
									   Command="{Binding DataContext.EditMessageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
									   ToolTip="{DynamicResource Str.Flowchart.Tip.OpenMessage}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</ui:FluentWindow>
