<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.DialoguePreview.DialoguePreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a11y="clr-namespace:FalloutScriptStudio.Views.Accessibility"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="860"
    Height="560"
    MinWidth="520"
    MinHeight="300"
    a11y:WindowFit.FitToWorkArea="True"
    a11y:WindowKeys.CloseOnEscape="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FocusManager.FocusedElement="{Binding ElementName=MessageGrid}"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <Style
            x:Key="ToolButton"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PlainCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style
            x:Key="MessageCell"
            BasedOn="{StaticResource PlainCell}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOption}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="TargetCell"
            BasedOn="{StaticResource PlainCell}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanFollow}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{Binding Title}"
            Grid.Row="0"
            ShowMaximize="True"
            ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="ChatMultiple24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border
            Grid.Row="1"
            Padding="8,2"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">
                <TextBlock
                    Margin="4,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource Str.Flowchart.NodesLabel}" />
                <ComboBox
                    Width="190"
                    Height="34"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{DynamicResource Str.Flowchart.PreviewNodeName}"
                    ItemsSource="{Binding NodeNames}"
                    MaxDropDownHeight="420"
                    SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                    ToolTip="{DynamicResource Str.Flowchart.Tip.PreviewNode}" />
                <ui:Button
                    AutomationProperties.Name="{DynamicResource Str.Flowchart.Back}"
                    Command="{Binding GoBackCommand}"
                    Icon="{ui:SymbolIcon ArrowLeft24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.Flowchart.Back}" />
                <ui:Button
                    AutomationProperties.Name="{DynamicResource Str.Flowchart.Forward}"
                    Command="{Binding GoForwardCommand}"
                    Icon="{ui:SymbolIcon ArrowRight24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.Flowchart.Forward}" />
                <Border Style="{StaticResource ToolDivider}" />
                <ui:Button
                    Command="{Binding UpdateScriptCommand}"
                    Content="{DynamicResource Str.Flowchart.Update}"
                    Icon="{ui:SymbolIcon ArrowSync24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.Flowchart.Tip.PreviewUpdate}" />
                <Border Style="{StaticResource ToolDivider}" />
                <CheckBox
                    Margin="4,0,6,0"
                    VerticalAlignment="Center"
                    Content="{DynamicResource Str.Flowchart.PlayerFemale}"
                    IsChecked="{Binding IsFemale, Mode=TwoWay}"
                    ToolTip="{DynamicResource Str.Flowchart.Tip.PlayerFemale}" />
                <ui:TextBox
                    Width="70"
                    Height="34"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{DynamicResource Str.Flowchart.FemaleOffsetName}"
                    IsEnabled="{Binding IsFemale}"
                    Text="{Binding FemaleOffsetText, UpdateSourceTrigger=PropertyChanged}"
                    TextAlignment="Right"
                    ToolTip="{DynamicResource Str.Flowchart.Tip.FemaleOffset}" />
                <Border Style="{StaticResource ToolDivider}" />
                <CheckBox
                    Margin="4,0,6,0"
                    VerticalAlignment="Center"
                    Content="{DynamicResource Str.Flowchart.AutoJump}"
                    IsChecked="{Binding AutoJump, Mode=TwoWay}"
                    ToolTip="{DynamicResource Str.Flowchart.Tip.AutoJump}" />
                <Border Style="{StaticResource ToolDivider}" />
                <TextBlock
                    MaxWidth="260"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Text="{Binding OptionText}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding OptionText}" />
            </WrapPanel>
        </Border>

        <DataGrid
            x:Name="MessageGrid"
            Grid.Row="2"
            Margin="8"
            AutoGenerateColumns="False"
            AutomationProperties.Name="{DynamicResource Str.Flowchart.NodeMessagesName}"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserSortColumns="False"
            GridLinesVisibility="None"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding Rows}"
            KeyDown="OnGridKeyDown"
            MouseDoubleClick="OnGridDoubleClick"
            SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
            SelectionMode="Single"
            SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="150" MinWidth="110">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource Str.Flowchart.Col.Procedure}" ToolTip="{DynamicResource Str.Flowchart.Tip.ProcedureColumn}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource TargetCell}" Text="{Binding Target}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource Str.Flowchart.Col.Text}" ToolTip="{DynamicResource Str.Flowchart.Tip.TextColumn}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource MessageCell}" Text="{Binding Text}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="52">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource Str.Flowchart.Col.Iq}" ToolTip="{DynamicResource Str.Flowchart.Tip.IqColumn}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource PlainCell}"
                                Text="{Binding Iq}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="Auto" MinWidth="72">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource Str.Common.Line}" ToolTip="{DynamicResource Str.Flowchart.Tip.LineColumn}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button
                                x:Name="EditLineButton"
                                Padding="6,2"
                                HorizontalAlignment="Center"
                                Appearance="Transparent"
                                Command="{Binding DataContext.EditMessageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}"
                                Content="{Binding LineText}"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                IsEnabled="{Binding CanEditMessage}"
                                ToolTip="{DynamicResource Str.Flowchart.Tip.OpenMessage}" />
                            <DataTemplate.Triggers>
                                <!--  A row without a message number (a call, an exit) has no line to open: no empty button  -->
                                <DataTrigger Binding="{Binding LineText}" Value="">
                                    <Setter TargetName="EditLineButton" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</ui:FluentWindow>