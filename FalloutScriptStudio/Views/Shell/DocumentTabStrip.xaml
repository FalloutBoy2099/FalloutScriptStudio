<UserControl
    x:Class="FalloutScriptStudio.Views.Shell.DocumentTabStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="clr-namespace:FalloutScriptStudio.Documents"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:FalloutScriptStudio.ViewModels.Main"
    x:Name="Root"
    Focusable="False"
    FontSize="12">
    <UserControl.Resources>
        <Style x:Key="TabItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Padding" Value="10,0,4,0" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="MaxWidth" Value="240" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid>
                            <Border
                                x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="6,6,0,0" />
                            <Border
                                x:Name="Accent"
                                Height="2"
                                Margin="10,0"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="1"
                                Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="{DynamicResource Str.Common.Close}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Dismiss24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding PlacementTarget.Tag.CloseAllCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Header="{DynamicResource Str.Shell.Menu.CloseAll}" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.CloseAllButThisCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="{DynamicResource Str.Shell.Tab.CloseAllButThis}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.OpenContainingFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="{DynamicResource Str.Shell.Tab.OpenFolder}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.OpenInExternalEditorCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="{DynamicResource Str.Shell.Tab.OpenExternal}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Open24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.CopyDocumentPathCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="{DynamicResource Str.Shell.Tab.CopyPath}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTabPreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="OnTabPreviewMouseMove" />
            <EventSetter Event="PreviewMouseUp" Handler="OnTabPreviewMouseUp" />
            <EventSetter Event="DragOver" Handler="OnTabDragOver" />
            <EventSetter Event="Drop" Handler="OnTabDrop" />
        </Style>

        <DataTemplate x:Key="TabHeaderTemplate" DataType="{x:Type docs:DocumentViewModel}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding FilePath}">
                <ui:SymbolIcon
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Symbol="{Binding Kind, Converter={StaticResource DocumentKindToSymbol}}" />
                <TextBlock
                    MaxWidth="150"
                    VerticalAlignment="Center"
                    Text="{Binding FileName}"
                    TextTrimming="CharacterEllipsis" />
                <Ellipse
                    Width="8"
                    Height="8"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource AccentFillColorDefaultBrush}"
                    ToolTip="{DynamicResource Str.Shell.Tab.Modified}"
                    Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button
                    Width="22"
                    Height="22"
                    MinWidth="22"
                    MinHeight="22"
                    Margin="6,0,0,0"
                    Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    CommandParameter="{Binding}"
                    Icon="{ui:SymbolIcon Dismiss12}"
                    Style="{StaticResource ShellSmallIconButtonStyle}"
                    ToolTip="{DynamicResource Str.Common.Close}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ListBox
            x:Name="Tabs"
            Padding="0"
            AllowDrop="True"
            Background="Transparent"
            BorderThickness="0"
            ItemContainerStyle="{StaticResource TabItemStyle}"
            ItemTemplate="{StaticResource TabHeaderTemplate}"
            ItemsSource="{Binding Documents}"
            PreviewMouseWheel="OnTabsPreviewMouseWheel"
            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
            SelectionChanged="OnTabsSelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <ui:Button
            Grid.Column="1"
            Click="OnAllTabsClick"
            Icon="{ui:SymbolIcon ChevronDown24}"
            Style="{StaticResource ShellIconButtonStyle}"
            ToolTip="{DynamicResource Str.Shell.Tab.AllDocuments}"
            Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
