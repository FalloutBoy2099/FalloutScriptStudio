<UserControl x:Class="FalloutScriptStudio.Views.Shell.DocumentTabStrip"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
			 xmlns:docs="clr-namespace:FalloutScriptStudio.Documents"
			 xmlns:vm="clr-namespace:FalloutScriptStudio.ViewModels.Main"
			 x:Name="Root"
			 FontSize="12"
			 Focusable="False">
	<UserControl.Resources>
		<Style x:Key="TabItemStyle" TargetType="{x:Type ListBoxItem}">
			<Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
			<Setter Property="AllowDrop" Value="True" />
			<Setter Property="Padding" Value="10,0,4,0" />
			<Setter Property="MinWidth" Value="110" />
			<Setter Property="MaxWidth" Value="240" />
			<Setter Property="Height" Value="36" />
			<Setter Property="Margin" Value="0,0,2,0" />
			<Setter Property="Cursor" Value="Arrow" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ListBoxItem}">
						<Grid>
							<Border x:Name="Surface"
									Background="Transparent"
									CornerRadius="6,6,0,0"
									Padding="{TemplateBinding Padding}" />
							<Border x:Name="Accent"
									Height="2"
									Margin="10,0"
									VerticalAlignment="Bottom"
									CornerRadius="1"
									Background="{DynamicResource AccentFillColorDefaultBrush}"
									Visibility="Collapsed" />
							<ContentPresenter Margin="{TemplateBinding Padding}"
											  VerticalAlignment="Center" />
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
								<Setter TargetName="Accent" Property="Visibility" Value="Visible" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Setter Property="ContextMenu">
				<Setter.Value>
					<ContextMenu>
						<MenuItem Header="{DynamicResource Str.Common.Close}"
								  Command="{Binding PlacementTarget.Tag.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
								  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="Dismiss24" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="{DynamicResource Str.Shell.Menu.CloseAll}"
								  Command="{Binding PlacementTarget.Tag.CloseAllCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
						<MenuItem Header="{DynamicResource Str.Shell.Tab.CloseAllButThis}"
								  Command="{Binding PlacementTarget.Tag.CloseAllButThisCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
								  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Shell.Tab.OpenFolder}"
								  Command="{Binding PlacementTarget.Tag.OpenContainingFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
								  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="FolderOpen24" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="{DynamicResource Str.Shell.Tab.OpenExternal}"
								  Command="{Binding PlacementTarget.Tag.OpenInExternalEditorCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
								  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="Open24" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="{DynamicResource Str.Shell.Tab.CopyPath}"
								  Command="{Binding PlacementTarget.Tag.CopyDocumentPathCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
								  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="Copy24" />
							</MenuItem.Icon>
						</MenuItem>
					</ContextMenu>
				</Setter.Value>
			</Setter>
			<EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTabPreviewMouseLeftButtonDown" />
			<EventSetter Event="PreviewMouseMove" Handler="OnTabPreviewMouseMove" />
			<EventSetter Event="PreviewMouseUp" Handler="OnTabPreviewMouseUp" />
			<EventSetter Event="DragOver" Handler="OnTabDragOver" />
			<EventSetter Event="Drop" Handler="OnTabDrop" />
		</Style>

		<DataTemplate x:Key="TabHeaderTemplate" DataType="{x:Type docs:DocumentViewModel}">
			<StackPanel Orientation="Horizontal" ToolTip="{Binding FilePath}">
				<ui:SymbolIcon Symbol="{Binding Kind, Converter={StaticResource DocumentKindToSymbol}}"
							   FontSize="14"
							   Margin="0,0,8,0"
							   VerticalAlignment="Center" />
				<TextBlock Text="{Binding FileName}"
						   VerticalAlignment="Center"
						   TextTrimming="CharacterEllipsis"
						   MaxWidth="150" />
				<Ellipse Width="8"
						 Height="8"
						 Margin="8,0,0,0"
						 VerticalAlignment="Center"
						 Fill="{DynamicResource AccentFillColorDefaultBrush}"
						 ToolTip="{DynamicResource Str.Shell.Tab.Modified}"
						 Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}" />
				<ui:Button Margin="6,0,0,0"
						   Style="{StaticResource ShellSmallIconButtonStyle}"
						   Width="22"
						   Height="22"
						   MinWidth="22"
						   MinHeight="22"
						   Icon="{ui:SymbolIcon Dismiss12}"
						   ToolTip="{DynamicResource Str.Common.Close}"
						   Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
						   CommandParameter="{Binding}" />
			</StackPanel>
		</DataTemplate>
	</UserControl.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<ListBox x:Name="Tabs"
				 ItemsSource="{Binding Documents}"
				 SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
				 ItemContainerStyle="{StaticResource TabItemStyle}"
				 ItemTemplate="{StaticResource TabHeaderTemplate}"
				 Background="Transparent"
				 BorderThickness="0"
				 Padding="0"
				 AllowDrop="True"
				 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
				 ScrollViewer.VerticalScrollBarVisibility="Disabled"
				 PreviewMouseWheel="OnTabsPreviewMouseWheel"
				 SelectionChanged="OnTabsSelectionChanged">
			<ListBox.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal" />
				</ItemsPanelTemplate>
			</ListBox.ItemsPanel>
		</ListBox>

		<ui:Button Grid.Column="1"
				   Style="{StaticResource ShellIconButtonStyle}"
				   Icon="{ui:SymbolIcon ChevronDown24}"
				   ToolTip="{DynamicResource Str.Shell.Tab.AllDocuments}"
				   Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}"
				   Click="OnAllTabsClick" />
	</Grid>
</UserControl>
