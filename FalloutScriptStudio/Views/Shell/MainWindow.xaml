<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a11y="clr-namespace:FalloutScriptStudio.Views.Accessibility"
    xmlns:docs="clr-namespace:FalloutScriptStudio.Documents"
    xmlns:panels="clr-namespace:FalloutScriptStudio.Views.Panels"
    xmlns:shell="clr-namespace:FalloutScriptStudio.Views.Shell"
    xmlns:svc="clr-namespace:FalloutScriptStudio.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="1360"
    Height="860"
    MinWidth="720"
    MinHeight="480"
    a11y:WindowFit.FitToWorkArea="True"
    AllowDrop="True"
    DragOver="OnWindowDragOver"
    Drop="OnWindowDrop"
    ExtendsContentIntoTitleBar="True"
    FontSize="12"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round">

    <Window.Resources>
        <Style
            x:Key="DocumentMenuItemStyle"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="{x:Type MenuItem}">
            <Setter Property="IsEnabled" Value="{Binding HasDocument}" />
        </Style>
        <Style
            x:Key="ScriptMenuItemStyle"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="{x:Type MenuItem}">
            <Setter Property="IsEnabled" Value="{Binding IsScript}" />
        </Style>
        <Style
            x:Key="ParsableMenuItemStyle"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="{x:Type MenuItem}">
            <Setter Property="IsEnabled" Value="{Binding IsParsable}" />
        </Style>
        <Style
            x:Key="ToolbarComboBoxStyle"
            BasedOn="{StaticResource {x:Type ComboBox}}"
            TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style
            x:Key="DefineComboBoxStyle"
            BasedOn="{StaticResource ToolbarComboBoxStyle}"
            TargetType="{x:Type ComboBox}">
            <Setter Property="IsEnabled" Value="{Binding CanChooseDefine}" />
            <Setter Property="ToolTip" Value="{DynamicResource Str.Shell.Tip.PreprocessorDefine}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanChooseDefine}" Value="False">
                    <Setter Property="ToolTip" Value="{DynamicResource Str.Shell.Tip.PreprocessorDefineProfile}" />
                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding
            Key="N"
            Command="{Binding NewScriptCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="O"
            Command="{Binding OpenCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="S"
            Command="{Binding SaveCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="S"
            Command="{Binding SaveAllCommand}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="W"
            Command="{Binding CloseDocumentCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="Tab"
            Command="{Binding NextDocumentCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="Tab"
            Command="{Binding PreviousDocumentCommand}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="PageDown"
            Command="{Binding NextDocumentCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="PageUp"
            Command="{Binding PreviousDocumentCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="F"
            Command="{Binding AdvancedSearchCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="H"
            Command="{Binding ShowSearchBarCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="F3"
            Command="{Binding QuickFindCommand}"
            Modifiers="Ctrl" />
        <KeyBinding Key="F3" Command="{Binding FindNextCommand}" />
        <KeyBinding
            Key="F3"
            Command="{Binding FindPreviousCommand}"
            Modifiers="Shift" />
        <KeyBinding
            Key="G"
            Command="{Binding GoToLineCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="P"
            Command="{Binding GoToProcedureCommand}"
            Modifiers="Alt" />
        <KeyBinding
            Key="T"
            Command="{Binding GoToSymbolCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="P"
            Command="{Binding Procedures.CreateProcedureCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="E"
            Command="{Binding ToggleFunctionTreeCommand}"
            Modifiers="Alt" />
        <KeyBinding
            Key="R"
            Command="{Binding ToggleRightBrowserCommand}"
            Modifiers="Alt" />
        <KeyBinding
            Key="L"
            Command="{Binding ToggleLogCommand}"
            Modifiers="Alt" />
        <KeyBinding Key="F7" Command="{Binding ScriptsListCommand}" />
        <KeyBinding Key="F8" Command="{Binding CompileCommand}" />
        <KeyBinding Key="F4" Command="{Binding PreprocessCommand}" />
        <KeyBinding Key="F5" Command="{Binding RoundTripCommand}" />
        <KeyBinding
            Key="F8"
            Command="{Binding Output.NextProblemCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="F8"
            Command="{Binding Output.PreviousProblemCommand}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="Cancel"
            Command="{Binding CancelOperationCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="G"
            Command="{Binding OpenAllIncludesCommand}"
            Modifiers="Alt+Shift" />
        <KeyBinding
            Key="M"
            Command="{Binding CheckMessageStructureCommand}"
            Modifiers="Alt" />
        <KeyBinding
            Key="M"
            Command="{Binding CheckMessagesCommand}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="OemPlus"
            Command="{Binding ZoomInCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="OemMinus"
            Command="{Binding ZoomOutCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="D0"
            Command="{Binding ResetZoomCommand}"
            Modifiers="Ctrl" />
        <KeyBinding Key="F1" Command="{Binding ShowCommandPaletteCommand}" />
        <KeyBinding
            Key="H"
            Command="{Binding ReplaceInFilesCommand}"
            Modifiers="Ctrl+Shift" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title bar with the menu  -->
        <StackPanel Grid.Row="0">
            <ui:TitleBar
                x:Name="TitleBar"
                Title=""
                Height="30">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/Assets/Icons/app.ico" />
                </ui:TitleBar.Icon>
                <ui:TitleBar.TrailingContent>
                    <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
                        <ui:Button
                            x:Name="ThemeButton"
                            Width="44"
                            Height="30"
                            MinWidth="0"
                            MinHeight="0"
                            Margin="0"
                            AutomationProperties.Name="{DynamicResource Str.Common.Theme}"
                            BorderThickness="0"
                            Click="OnThemeButtonClick"
                            Content="&#xE793;"
                            CornerRadius="0"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="14"
                            Style="{StaticResource ShellIconButtonStyle}"
                            ToolTip="{DynamicResource Str.Common.Theme}" />
                        <ui:Button
                            x:Name="LanguageButton"
                            Width="44"
                            Height="30"
                            MinWidth="0"
                            MinHeight="0"
                            Margin="0"
                            AutomationProperties.Name="{DynamicResource Str.Common.LanguageTip}"
                            BorderThickness="0"
                            Click="OnLanguageButtonClick"
                            Content="&#xE774;"
                            CornerRadius="0"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="14"
                            Style="{StaticResource ShellIconButtonStyle}"
                            ToolTip="{DynamicResource Str.Common.LanguageTip}" />
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
                <ui:TitleBar.CenterContent>
                    <TextBlock
                        MaxWidth="520"
                        Style="{StaticResource ShellCaptionTextStyle}"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis" />
                </ui:TitleBar.CenterContent>
            </ui:TitleBar>

            <!--  Menu bar (under the slim title bar, like DatExplorerIII)  -->
            <Border Padding="4,0,4,0">
                <Menu
                    x:Name="MainMenu"
                    Margin="0"
                    VerticalAlignment="Center"
                    Background="Transparent">
                    <MenuItem Header="{DynamicResource Str.Shell.MenuBar.File}" HeaderTemplate="{StaticResource ShellMenuBarHeaderTemplate}">
                        <MenuItem
                            Command="{Binding NewScriptCommand}"
                            Header="{DynamicResource Str.Shell.Menu.NewScript}"
                            InputGestureText="Ctrl+N">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="DocumentAdd24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            x:Name="TemplatesMenu"
                            Header="{DynamicResource Str.Shell.Menu.NewFromTemplate}"
                            SubmenuOpened="OnTemplatesMenuOpened">
                            <MenuItem Header="{DynamicResource Str.Common.Loading}" IsEnabled="False" />
                        </MenuItem>
                        <MenuItem
                            Command="{Binding OpenCommand}"
                            Header="{DynamicResource Str.Shell.Menu.Open}"
                            InputGestureText="Ctrl+O">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            x:Name="RecentMenu"
                            Header="{DynamicResource Str.Shell.Menu.OpenRecent}"
                            SubmenuOpened="OnRecentMenuOpened">
                            <MenuItem Header="{DynamicResource Str.Common.Loading}" IsEnabled="False" />
                        </MenuItem>
                        <MenuItem Command="{Binding OpenFromArchiveCommand}" Header="{DynamicResource Str.Shell.Menu.OpenFromArchive}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding OpenProjectCommand}"
                            Header="{DynamicResource Str.Shell.Menu.OpenProject}"
                            ToolTip="{DynamicResource Str.Shell.Tip.SetProjectFolder}" />
                        <MenuItem
                            x:Name="RecentProjectsMenu"
                            Header="{DynamicResource Str.Shell.Menu.RecentProjects}"
                            SubmenuOpened="OnRecentProjectsMenuOpened">
                            <MenuItem Header="{DynamicResource Str.Common.Loading}" IsEnabled="False" />
                        </MenuItem>
                        <MenuItem Command="{Binding CreateProjectSettingsCommand}" Header="{DynamicResource Str.Shell.Menu.CreateProjectSettings}" />
                        <MenuItem Command="{Binding CloseProjectCommand}" Header="{DynamicResource Str.Shell.Menu.CloseProject}" />
                        <MenuItem
                            Command="{Binding OpenProjectFolderCommand}"
                            Header="{DynamicResource Str.Shell.Menu.ShowProjectFolder}"
                            IsEnabled="{Binding HasProject}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding SaveCommand}"
                            Header="{DynamicResource Str.Common.Save}"
                            InputGestureText="Ctrl+S"
                            Style="{StaticResource DocumentMenuItemStyle}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Save24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Command="{Binding SaveAllCommand}"
                            Header="{DynamicResource Str.Shell.Menu.SaveAll}"
                            InputGestureText="Ctrl+Shift+S"
                            Style="{StaticResource DocumentMenuItemStyle}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="SaveMultiple24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Command="{Binding SaveAsCommand}"
                            Header="{DynamicResource Str.Shell.Menu.SaveAs}"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding SaveAsTemplateCommand}"
                            Header="{DynamicResource Str.Shell.Menu.SaveAsTemplate}"
                            Style="{StaticResource ScriptMenuItemStyle}" />
                        <MenuItem
                            Header="{DynamicResource Str.Shell.Menu.SaveUtf8}"
                            IsCheckable="True"
                            IsChecked="{Binding SaveAsUtf8, Mode=TwoWay}"
                            ToolTip="{DynamicResource Str.Shell.Tip.SaveUtf8}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding CloseDocumentCommand}"
                            Header="{DynamicResource Str.Common.Close}"
                            InputGestureText="Ctrl+W"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding CloseAllCommand}"
                            Header="{DynamicResource Str.Shell.Menu.CloseAll}"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding ExitCommand}"
                            Header="{DynamicResource Str.Shell.Menu.Exit}"
                            InputGestureText="Alt+F4" />
                    </MenuItem>

                    <MenuItem Header="{DynamicResource Str.Shell.MenuBar.Edit}" HeaderTemplate="{StaticResource ShellMenuBarHeaderTemplate}">
                        <MenuItem
                            Command="{Binding UndoCommand}"
                            Header="{DynamicResource Str.Common.Undo}"
                            InputGestureText="Ctrl+Z"
                            IsEnabled="{Binding CanUndo}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowUndo24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Command="{Binding RedoCommand}"
                            Header="{DynamicResource Str.Common.Redo}"
                            InputGestureText="Ctrl+Y"
                            IsEnabled="{Binding CanRedo}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowRedo24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Command="{Binding CutCommand}"
                            Header="{DynamicResource Str.Common.Cut}"
                            InputGestureText="Ctrl+X"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding CopyCommand}"
                            Header="{DynamicResource Str.Common.Copy}"
                            InputGestureText="Ctrl+C"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding PasteCommand}"
                            Header="{DynamicResource Str.Common.Paste}"
                            InputGestureText="Ctrl+V"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding SelectAllCommand}"
                            Header="{DynamicResource Str.Common.SelectAll}"
                            InputGestureText="Ctrl+A"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding AdvancedSearchCommand}"
                            Header="{DynamicResource Str.Shell.Menu.FindInFiles}"
                            InputGestureText="Ctrl+F">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Search24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Command="{Binding ReplaceInFilesCommand}"
                            Header="{DynamicResource Str.Shell.Menu.ReplaceInFiles}"
                            InputGestureText="Ctrl+Shift+H"
                            ToolTip="{DynamicResource Str.Shell.Tip.ReplaceInFiles}" />
                        <MenuItem
                            Command="{Binding UndoReplaceInFilesCommand}"
                            Header="{DynamicResource Str.Shell.Menu.UndoReplaceInFiles}"
                            IsEnabled="{Binding CanUndoReplaceInFiles}"
                            ToolTip="{DynamicResource Str.Shell.Tip.UndoReplaceInFiles}" />
                        <MenuItem
                            Command="{Binding ShowSearchBarCommand}"
                            Header="{DynamicResource Str.Shell.Menu.FindReplaceBar}"
                            InputGestureText="Ctrl+H"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding QuickFindCommand}"
                            Header="{DynamicResource Str.Shell.Menu.QuickFind}"
                            InputGestureText="Ctrl+F3"
                            Style="{StaticResource DocumentMenuItemStyle}"
                            ToolTip="{DynamicResource Str.Shell.Tip.QuickFind}" />
                        <MenuItem
                            Command="{Binding FindNextCommand}"
                            Header="{DynamicResource Str.Shell.Menu.FindNext}"
                            InputGestureText="F3"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding FindPreviousCommand}"
                            Header="{DynamicResource Str.Shell.Menu.FindPrevious}"
                            InputGestureText="Shift+F3"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding GoToLineCommand}"
                            Header="{DynamicResource Str.Shell.Menu.GoToLine}"
                            InputGestureText="Ctrl+G"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding GoToProcedureCommand}"
                            Header="{DynamicResource Str.Shell.Menu.GoToProcedure}"
                            InputGestureText="Alt+P"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding GoToSymbolCommand}"
                            Header="{DynamicResource Str.Shell.Menu.GoToSymbol}"
                            InputGestureText="Ctrl+T" />
                        <MenuItem
                            Command="{Binding GoBackCommand}"
                            Header="{DynamicResource Str.Shell.Menu.Back}"
                            IsEnabled="{Binding CanGoBack}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowLeft24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Command="{Binding GoForwardCommand}"
                            Header="{DynamicResource Str.Shell.Menu.Forward}"
                            IsEnabled="{Binding CanGoForward}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowRight24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.SplitDocument}"
                            Header="{DynamicResource Str.Shell.Menu.SplitDocument}"
                            InputGestureText="Alt+S"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                    </MenuItem>

                    <MenuItem Header="{DynamicResource Str.Shell.MenuBar.Code}" HeaderTemplate="{StaticResource ShellMenuBarHeaderTemplate}">
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.CommentSelection}"
                            Header="{DynamicResource Str.Shell.Menu.CommentText}"
                            InputGestureText="Alt+C"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.UncommentSelection}"
                            Header="{DynamicResource Str.Shell.Menu.UncommentText}"
                            InputGestureText="Alt+X"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.ToggleLineComment}"
                            Header="{DynamicResource Str.Shell.Menu.ToggleLineComment}"
                            InputGestureText="Ctrl+/"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.ToggleBlockComment}"
                            Header="{DynamicResource Str.Shell.Menu.ToggleRegionComment}"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.AlignSelectionLeft}"
                            Header="{DynamicResource Str.Shell.Menu.AlignSelectedText}"
                            InputGestureText="Alt+A"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.DecreaseIndent}"
                            Header="{DynamicResource Str.Shell.Menu.DecreaseIndent}"
                            InputGestureText="Alt+Q"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.IncreaseIndent}"
                            Header="{DynamicResource Str.Shell.Menu.IncreaseIndent}"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.FormatDocument}"
                            Header="{DynamicResource Str.Shell.Menu.FormatDocument}"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.FormatSelection}"
                            Header="{DynamicResource Str.Shell.Menu.FormatSelection}"
                            InputGestureText="Alt+F"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem Command="{Binding FormatProjectCommand}" Header="{DynamicResource Str.Shell.Menu.FormatProject}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.UpperCase}"
                            Header="{DynamicResource Str.Shell.Menu.UpperCase}"
                            InputGestureText="Ctrl+Shift+A"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.LowerCase}"
                            Header="{DynamicResource Str.Shell.Menu.LowerCase}"
                            InputGestureText="Ctrl+Shift+Z"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.CapitalizeWord}"
                            Header="{DynamicResource Str.Shell.Menu.CapitalizeWord}"
                            InputGestureText="Ctrl+Shift+W"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.ConvertHexDec}"
                            Header="{DynamicResource Str.Shell.Menu.ConvertHexDec}"
                            Style="{StaticResource DocumentMenuItemStyle}"
                            ToolTip="{DynamicResource Str.Shell.Tip.ConvertHexDec}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.ConvertLeadingTabsToSpaces}"
                            Header="{DynamicResource Str.Shell.Menu.ConvertLeadingTabsToSpaces}"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.ConvertAllTabsToSpaces}"
                            Header="{DynamicResource Str.Shell.Menu.ConvertAllTabsToSpaces}"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.ConvertLeadingSpacesToTabs}"
                            Header="{DynamicResource Str.Shell.Menu.ConvertLeadingSpacesToTabs}"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.TrimTrailingSpaces}"
                            Header="{DynamicResource Str.Shell.Menu.TrimTrailingSpaces}"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Header="{DynamicResource Str.Shell.Menu.AutoTrimTrailing}"
                            IsCheckable="True"
                            IsChecked="{Binding AutoTrimTrailingSpaces, Mode=TwoWay}"
                            ToolTip="{DynamicResource Str.Shell.Tip.AutoTrimTrailing}" />
                        <MenuItem
                            Header="{DynamicResource Str.Shell.Menu.AutoFormatCode}"
                            IsCheckable="True"
                            IsChecked="{Binding FormatCodeOnOpen, Mode=TwoWay}"
                            ToolTip="{DynamicResource Str.Shell.Tip.AutoFormatCode}" />
                        <MenuItem
                            Header="{DynamicResource Str.Shell.Menu.ShowWhitespace}"
                            IsCheckable="True"
                            IsChecked="{Binding ShowWhitespace, Mode=TwoWay}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.HighlightWord}"
                            Header="{DynamicResource Str.Shell.Menu.HighlightWord}"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.ShowCompletion}"
                            Header="{DynamicResource Str.Shell.Menu.Autocomplete}"
                            InputGestureText="Ctrl+Space / Alt+Space"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.InsertSnippet}"
                            Header="{DynamicResource Str.Shell.Menu.InsertSnippet}"
                            InputGestureText="Ctrl+J"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.SurroundWith}"
                            Header="{DynamicResource Str.Shell.Menu.SurroundWith}"
                            InputGestureText="Ctrl+Shift+J"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem Command="{Binding ManageSnippetsCommand}" Header="{DynamicResource Str.Shell.Menu.ManageSnippets}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.ToggleOutline}"
                            Header="{DynamicResource Str.Shell.Menu.ToggleOutline}"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.CollapseAll}"
                            Header="{DynamicResource Str.Shell.Menu.CollapseAll}"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.ExpandAll}"
                            Header="{DynamicResource Str.Shell.Menu.ExpandAll}"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.GoToDeclaration}"
                            Header="{DynamicResource Str.Shell.Menu.GoToDeclaration}"
                            InputGestureText="Ctrl+F12"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.GoToDefinition}"
                            Header="{DynamicResource Str.Shell.Menu.GoToDefinition}"
                            InputGestureText="F12"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.FindReferences}"
                            Header="{DynamicResource Str.Shell.Menu.FindReferences}"
                            InputGestureText="Alt+F12"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.RenameSymbol}"
                            Header="{DynamicResource Str.Common.Rename}"
                            InputGestureText="F2"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.OpenInclude}"
                            Header="{DynamicResource Str.Shell.Menu.OpenInclude}"
                            InputGestureText="Alt+G"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.QuickFix}"
                            Header="{DynamicResource Str.Shell.Menu.QuickFix}"
                            InputGestureText="Ctrl+."
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.ExtractProcedure}"
                            Header="{DynamicResource Str.Shell.Menu.ExtractProcedure}"
                            InputGestureText="Ctrl+Shift+E"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.DeleteUnusedProcedure}"
                            Header="{DynamicResource Str.Shell.Menu.DeleteUnusedProcedure}"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.FindUnusedVariables}"
                            Header="{DynamicResource Str.Shell.Menu.FindUnusedVariables}"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.RemoveUnusedVariable}"
                            Header="{DynamicResource Str.Shell.Menu.RemoveUnusedVariable}"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding CheckMessageStructureCommand}"
                            Header="{DynamicResource Str.Shell.Menu.CheckMessageStructure}"
                            InputGestureText="Alt+M"
                            IsEnabled="{Binding IsMessage}" />
                    </MenuItem>

                    <MenuItem Header="{DynamicResource Str.Shell.MenuBar.Script}" HeaderTemplate="{StaticResource ShellMenuBarHeaderTemplate}">
                        <MenuItem
                            Command="{Binding ScriptsListCommand}"
                            Header="{DynamicResource Str.Shell.Menu.ScriptsListEditor}"
                            InputGestureText="F7"
                            ToolTip="{DynamicResource Str.Shell.Tip.ScriptsListEditor}" />
                        <MenuItem
                            Command="{Binding RegisterScriptCommand}"
                            Header="{DynamicResource Str.Shell.Menu.RegisterScript}"
                            Style="{StaticResource ScriptMenuItemStyle}"
                            ToolTip="{DynamicResource Str.Shell.Tip.RegisterScript}" />
                        <MenuItem
                            Header="{DynamicResource Str.Shell.Menu.DefineToScriptsHeader}"
                            IsCheckable="True"
                            IsChecked="{Binding DefineToScriptsHeader, Mode=TwoWay}"
                            ToolTip="{DynamicResource Str.Shell.Tip.DefineToScriptsHeader}" />
                    </MenuItem>

                    <MenuItem Header="{DynamicResource Str.Shell.MenuBar.Headers}" HeaderTemplate="{StaticResource ShellMenuBarHeaderTemplate}">
                        <MenuItem
                            Command="{Binding IncludeFileToCodeCommand}"
                            Header="{DynamicResource Str.Shell.Menu.IncludeFile}"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                        <MenuItem Command="{Binding OpenHeaderFileCommand}" Header="{DynamicResource Str.Shell.Menu.OpenHeader}" />
                        <MenuItem Command="{Binding BrowseHeadersCommand}" Header="{DynamicResource Str.Shell.Menu.BrowseHeaders}" />
                        <MenuItem
                            Command="{Binding OpenAllIncludesCommand}"
                            Header="{DynamicResource Str.Shell.Menu.OpenAllIncludes}"
                            InputGestureText="Alt+Shift+G"
                            Style="{StaticResource ParsableMenuItemStyle}" />
                    </MenuItem>

                    <MenuItem Header="{DynamicResource Str.Shell.MenuBar.Dialog}" HeaderTemplate="{StaticResource ShellMenuBarHeaderTemplate}">
                        <MenuItem Command="{Binding OpenMessageEditorCommand}" Header="{DynamicResource Str.Shell.Menu.MessageEditor}" />
                        <MenuItem
                            Command="{Binding AssociateMessageFileCommand}"
                            Header="{DynamicResource Str.Shell.Menu.AssociatedMessageFile}"
                            Style="{StaticResource ScriptMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding ShowFlowchartCommand}"
                            Header="{DynamicResource Str.Shell.Menu.NodesFlowchart}"
                            Style="{StaticResource ScriptMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding ShowDialoguePreviewCommand}"
                            Header="{DynamicResource Str.Shell.Menu.DialoguePreview}"
                            Style="{StaticResource ScriptMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding EditCommand}"
                            CommandParameter="{x:Static docs:EditorCommand.PreviewDialogueFromNode}"
                            Header="{DynamicResource Str.Shell.Menu.PreviewDialogueFromNode}"
                            InputGestureText="Ctrl+Shift+P"
                            Style="{StaticResource ParsableMenuItemStyle}"
                            ToolTip="{DynamicResource Str.Shell.Tip.PreviewDialogueFromNode}" />
                        <MenuItem
                            Command="{Binding CheckMessagesCommand}"
                            Header="{DynamicResource Str.Shell.Menu.CheckMessages}"
                            InputGestureText="Ctrl+Shift+M"
                            Style="{StaticResource ScriptMenuItemStyle}"
                            ToolTip="{DynamicResource Str.Shell.Tip.CheckMessages}" />
                        <MenuItem Command="{Binding ShowFunctionRulesCommand}" Header="{DynamicResource Str.Shell.Menu.FunctionsConfig}" />
                        <Separator />
                        <MenuItem
                            Header="{DynamicResource Str.Shell.Menu.AutoOpenMessageEditor}"
                            IsCheckable="True"
                            IsChecked="{Binding AutoOpenMessageEditor, Mode=TwoWay}"
                            ToolTip="{DynamicResource Str.Shell.Tip.AutoOpenMessageEditor}" />
                    </MenuItem>

                    <MenuItem Header="{DynamicResource Str.Shell.MenuBar.Compile}" HeaderTemplate="{StaticResource ShellMenuBarHeaderTemplate}">
                        <MenuItem
                            Command="{Binding CompileCommand}"
                            Header="{DynamicResource Str.Shell.Menu.CompileScript}"
                            InputGestureText="F8"
                            Style="{StaticResource ScriptMenuItemStyle}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Play24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Command="{Binding CompileAllOpenCommand}"
                            Header="{DynamicResource Str.Shell.Menu.CompileAllOpen}"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding BuildChangedCommand}"
                            Header="{DynamicResource Str.Shell.Menu.BuildChanged}"
                            Style="{StaticResource DocumentMenuItemStyle}"
                            ToolTip="{DynamicResource Str.Shell.Tip.BuildChanged}" />
                        <MenuItem Command="{Binding MassCompileCommand}" Header="{DynamicResource Str.Shell.Menu.MassCompile}" />
                        <MenuItem
                            Command="{Binding RebuildAllCommand}"
                            Header="{DynamicResource Str.Shell.Menu.RebuildAll}"
                            ToolTip="{DynamicResource Str.Shell.Tip.RebuildAll}" />
                        <MenuItem
                            Header="{DynamicResource Str.Shell.Menu.MassCompileOnlyChanged}"
                            IsCheckable="True"
                            IsChecked="{Binding MassCompileOnlyChanged, Mode=TwoWay}"
                            ToolTip="{DynamicResource Str.Shell.Tip.MassCompileOnlyChanged}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding PreprocessCommand}"
                            Header="{DynamicResource Str.Shell.Menu.Preprocess}"
                            InputGestureText="F4"
                            Style="{StaticResource ScriptMenuItemStyle}"
                            ToolTip="{DynamicResource Str.Shell.Tip.Preprocess}" />
                        <MenuItem
                            Command="{Binding RoundTripCommand}"
                            Header="{DynamicResource Str.Shell.Menu.Roundtrip}"
                            InputGestureText="F5"
                            Style="{StaticResource ScriptMenuItemStyle}"
                            ToolTip="{DynamicResource Str.Shell.Tip.Roundtrip}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding CancelOperationCommand}"
                            Header="{DynamicResource Str.Shell.Operation.Cancel}"
                            InputGestureText="Ctrl+Break">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Stop24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Command="{Binding ShowProblemsCommand}" Header="{DynamicResource Str.Shell.Problems.Show}" />
                        <MenuItem
                            Command="{Binding Output.NextProblemCommand}"
                            Header="{DynamicResource Str.Shell.Problems.Next}"
                            InputGestureText="Ctrl+F8" />
                        <MenuItem
                            Command="{Binding Output.PreviousProblemCommand}"
                            Header="{DynamicResource Str.Shell.Problems.Previous}"
                            InputGestureText="Ctrl+Shift+F8" />
                        <Separator />
                        <MenuItem
                            Header="{DynamicResource Str.Shell.Menu.DecompileFallout1}"
                            IsCheckable="True"
                            IsChecked="{Binding DecompileAsFallout1, Mode=TwoWay}" />
                        <MenuItem
                            Header="{DynamicResource Str.Shell.Menu.UseOldDecompiler}"
                            IsCheckable="True"
                            IsChecked="{Binding UseOldDecompiler, Mode=TwoWay}"
                            IsEnabled="{Binding CanUseOldDecompiler}"
                            ToolTip="{DynamicResource Str.Shell.Menu.UseOldDecompilerTip}"
                            ToolTipService.ShowOnDisabled="True" />
                    </MenuItem>

                    <MenuItem Header="{DynamicResource Str.Shell.MenuBar.View}" HeaderTemplate="{StaticResource ShellMenuBarHeaderTemplate}">
                        <MenuItem
                            Header="{DynamicResource Str.Shell.Menu.LineNumbers}"
                            IsCheckable="True"
                            IsChecked="{Binding ShowLineNumbers, Mode=TwoWay}" />
                        <MenuItem
                            Header="{DynamicResource Str.Shell.Menu.ShowIndentLine}"
                            IsCheckable="True"
                            IsChecked="{Binding ShowIndentLine, Mode=TwoWay}" />
                        <MenuItem
                            Header="{DynamicResource Str.Shell.Menu.HighlightParseErrors}"
                            IsCheckable="True"
                            IsChecked="{Binding HighlightParseErrors, Mode=TwoWay}" />
                        <Separator />
                        <MenuItem
                            Header="{DynamicResource Str.Shell.Menu.RightBrowser}"
                            InputGestureText="Alt+R"
                            IsCheckable="True"
                            IsChecked="{Binding ShowRightBrowser, Mode=TwoWay}" />
                        <MenuItem
                            Header="{DynamicResource Str.Shell.Menu.FunctionTree}"
                            InputGestureText="Alt+E"
                            IsCheckable="True"
                            IsChecked="{Binding ShowFunctionTree, Mode=TwoWay}" />
                        <MenuItem
                            Header="{DynamicResource Str.Shell.Menu.LogWindow}"
                            InputGestureText="Alt+L"
                            IsCheckable="True"
                            IsChecked="{Binding ShowLog, Mode=TwoWay}" />
                        <Separator />
                        <MenuItem Header="{DynamicResource Str.Common.Theme}">
                            <MenuItem
                                Command="{Binding SetThemeCommand}"
                                CommandParameter="{x:Static svc:AppTheme.System}"
                                Header="{DynamicResource Str.Common.ThemeSystem}" />
                            <MenuItem
                                Command="{Binding SetThemeCommand}"
                                CommandParameter="{x:Static svc:AppTheme.Light}"
                                Header="{DynamicResource Str.Common.ThemeLight}" />
                            <MenuItem
                                Command="{Binding SetThemeCommand}"
                                CommandParameter="{x:Static svc:AppTheme.Dark}"
                                Header="{DynamicResource Str.Common.ThemeDark}" />
                        </MenuItem>
                        <MenuItem
                            x:Name="LanguageMenu"
                            Header="{DynamicResource Str.Common.LanguageTip}"
                            SubmenuOpened="OnLanguageMenuOpened">
                            <MenuItem Header="{DynamicResource Str.Common.Loading}" IsEnabled="False" />
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Command="{Binding ZoomInCommand}"
                            Header="{DynamicResource Str.Shell.Menu.ZoomIn}"
                            InputGestureText="Ctrl++"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding ZoomOutCommand}"
                            Header="{DynamicResource Str.Shell.Menu.ZoomOut}"
                            InputGestureText="Ctrl+-"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <MenuItem
                            Command="{Binding ResetZoomCommand}"
                            Header="{DynamicResource Str.Shell.Menu.ResetZoom}"
                            InputGestureText="Ctrl+0"
                            Style="{StaticResource DocumentMenuItemStyle}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding ShowCommandPaletteCommand}"
                            Header="{DynamicResource Str.Shell.Menu.CommandPalette}"
                            InputGestureText="F1"
                            ToolTip="{DynamicResource Str.Shell.Tip.CommandPalette}" />
                    </MenuItem>

                    <MenuItem Header="{DynamicResource Str.Shell.MenuBar.Options}" HeaderTemplate="{StaticResource ShellMenuBarHeaderTemplate}">
                        <MenuItem Command="{Binding SettingsCommand}" Header="{DynamicResource Str.Shell.Menu.Settings}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Settings24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ProjectSettingsCommand}" Header="{DynamicResource Str.Shell.Menu.ProjectSettings}" />
                        <MenuItem Header="{DynamicResource Str.Shell.Menu.MessageEncoding}">
                            <MenuItem
                                Header="{DynamicResource Str.Shell.Menu.EncodingWindows}"
                                IsCheckable="True"
                                IsChecked="{Binding UseWindowsMessageEncoding, Mode=TwoWay}" />
                            <MenuItem
                                Header="{DynamicResource Str.Shell.Menu.EncodingOem}"
                                IsCheckable="True"
                                IsChecked="{Binding UseOemMessageEncoding, Mode=TwoWay}" />
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="{DynamicResource Str.Shell.MenuBar.Help}" HeaderTemplate="{StaticResource ShellMenuBarHeaderTemplate}">
                        <MenuItem Command="{Binding HelpCommand}" Header="{DynamicResource Str.Shell.Menu.Documentation}" />
                        <MenuItem Command="{Binding AssociateFileTypesCommand}" Header="{DynamicResource Str.Shell.Menu.AssociateFiles}" />
                        <MenuItem Command="{Binding AboutCommand}" Header="{DynamicResource Str.Shell.Menu.About}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Info24" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </Menu>
            </Border>
        </StackPanel>

        <!--  Toolbar  -->
        <Border
            Grid.Row="1"
            Padding="8,2"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Command="{Binding NewScriptCommand}"
                        Icon="{ui:SymbolIcon DocumentAdd24}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.NewScript}" />
                    <ui:Button
                        Command="{Binding OpenCommand}"
                        Icon="{ui:SymbolIcon FolderOpen24}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.Open}" />
                    <ui:Button
                        Command="{Binding SaveCommand}"
                        Icon="{ui:SymbolIcon Save24}"
                        IsEnabled="{Binding HasDocument}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.Save}" />
                    <ui:Button
                        Command="{Binding SaveAllCommand}"
                        Icon="{ui:SymbolIcon SaveMultiple24}"
                        IsEnabled="{Binding HasDocument}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.SaveAll}" />
                    <Rectangle Style="{StaticResource ShellToolbarSeparatorStyle}" />
                    <ui:Button
                        Command="{Binding UndoCommand}"
                        Icon="{ui:SymbolIcon ArrowUndo24}"
                        IsEnabled="{Binding CanUndo}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.Undo}" />
                    <ui:Button
                        Command="{Binding RedoCommand}"
                        Icon="{ui:SymbolIcon ArrowRedo24}"
                        IsEnabled="{Binding CanRedo}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.Redo}" />
                    <Rectangle Style="{StaticResource ShellToolbarSeparatorStyle}" />
                    <ui:Button
                        Command="{Binding ShowSearchBarCommand}"
                        Icon="{ui:SymbolIcon Search24}"
                        IsEnabled="{Binding HasDocument}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.FindReplaceBar}" />
                    <ui:Button
                        Command="{Binding GoBackCommand}"
                        Icon="{ui:SymbolIcon ArrowLeft24}"
                        IsEnabled="{Binding CanGoBack}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.Back}" />
                    <ui:Button
                        Command="{Binding GoForwardCommand}"
                        Icon="{ui:SymbolIcon ArrowRight24}"
                        IsEnabled="{Binding CanGoForward}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.Forward}" />
                    <ui:Button
                        x:Name="GoToProcedureButton"
                        Command="{Binding GoToProcedureCommand}"
                        Icon="{ui:SymbolIcon TextBulletListSquare24}"
                        IsEnabled="{Binding IsParsable}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.GoToProcedure}" />
                    <Rectangle Style="{StaticResource ShellToolbarSeparatorStyle}" />
                    <ui:Button
                        Command="{Binding EditCommand}"
                        CommandParameter="{x:Static docs:EditorCommand.ToggleLineComment}"
                        Icon="{ui:SymbolIcon CommentAdd24}"
                        IsEnabled="{Binding IsParsable}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.ToggleComment}" />
                    <ui:Button
                        Command="{Binding EditCommand}"
                        CommandParameter="{x:Static docs:EditorCommand.DecreaseIndent}"
                        Icon="{ui:SymbolIcon TextIndentDecrease24}"
                        IsEnabled="{Binding IsParsable}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.DecreaseIndent}" />
                    <ui:Button
                        Command="{Binding EditCommand}"
                        CommandParameter="{x:Static docs:EditorCommand.ToggleOutline}"
                        Icon="{ui:SymbolIcon ChevronUpDown24}"
                        IsEnabled="{Binding IsParsable}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.ToggleOutline}" />
                    <Rectangle Style="{StaticResource ShellToolbarSeparatorStyle}" />
                    <ui:Button
                        Command="{Binding CompileCommand}"
                        Icon="{ui:SymbolIcon Play24}"
                        IsEnabled="{Binding IsScript}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.Compile}" />
                    <ui:Button
                        Command="{Binding CompileAllOpenCommand}"
                        Icon="{ui:SymbolIcon PlayCircle24}"
                        IsEnabled="{Binding HasDocument}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.CompileAllOpen}" />
                    <ui:Button
                        Command="{Binding MassCompileCommand}"
                        Icon="{ui:SymbolIcon Rocket24}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.MassCompile}" />
                    <ComboBox
                        AutomationProperties.Name="{DynamicResource Str.Shell.Tip.CompileProfile}"
                        ItemsSource="{Binding CompileProfileOptions}"
                        SelectedValue="{Binding SelectedCompileProfile, Mode=TwoWay}"
                        SelectedValuePath="Value"
                        Style="{StaticResource ToolbarComboBoxStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.CompileProfile}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Caption}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox
                        AutomationProperties.Name="{DynamicResource Str.Shell.Tip.PreprocessorDefine}"
                        ItemsSource="{Binding PreprocessorDefineOptions}"
                        SelectedValue="{Binding SelectedPreprocessorDefine, Mode=TwoWay}"
                        SelectedValuePath="Value"
                        Style="{StaticResource DefineComboBoxStyle}">
                        <!--  A template (not DisplayMemberPath) keeps the selection box live when the caption changes with the language.  -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Caption}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Rectangle Style="{StaticResource ShellToolbarSeparatorStyle}" />
                    <ui:Button
                        Command="{Binding OpenMessageEditorCommand}"
                        Icon="{ui:SymbolIcon Chat24}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.MessageEditor}" />
                    <ui:Button
                        Command="{Binding ShowFlowchartCommand}"
                        Icon="{ui:SymbolIcon Organization24}"
                        IsEnabled="{Binding IsScript}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.Flowchart}" />
                    <Rectangle Style="{StaticResource ShellToolbarSeparatorStyle}" />
                    <ToggleButton
                        Width="32"
                        Height="32"
                        Margin="1,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        IsChecked="{Binding ShowFunctionTree, Mode=TwoWay}"
                        Style="{StaticResource ShellIconToggleStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.ToggleFunctionTree}">
                        <ui:SymbolIcon FontSize="16" Symbol="PanelLeft24" />
                    </ToggleButton>
                    <ToggleButton
                        Width="32"
                        Height="32"
                        Margin="1,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        IsChecked="{Binding ShowRightBrowser, Mode=TwoWay}"
                        Style="{StaticResource ShellIconToggleStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.ToggleRightBrowser}">
                        <ui:SymbolIcon FontSize="16" Symbol="PanelRight24" />
                    </ToggleButton>
                    <ui:Button
                        Command="{Binding SettingsCommand}"
                        Icon="{ui:SymbolIcon Settings24}"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Common.Settings}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  Body  -->
        <Grid x:Name="BodyGrid" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="140" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="OutputRow" Height="220" />
            </Grid.RowDefinitions>

            <Grid x:Name="EditorArea" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="RightColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="LeftPanel"
                    Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="Collapsed">
                    <panels:FunctionsPanelView DataContext="{Binding Functions}" />
                </Border>
                <GridSplitter
                    x:Name="LeftSplitter"
                    Grid.Column="1"
                    Width="5"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    ShowsPreview="False"
                    Visibility="Collapsed" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <shell:DocumentTabStrip
                        Grid.Row="0"
                        Margin="8,4,8,0"
                        Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}" />
                    <shell:SearchBarView
                        Grid.Row="1"
                        DataContext="{Binding Search}"
                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                    <ContentControl
                        Grid.Row="2"
                        Content="{Binding ActiveDocument}"
                        Focusable="False"
                        IsTabStop="False" />
                    <shell:WelcomeView
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Visibility="{Binding HasDocument, Converter={StaticResource InvertedBoolToVisibility}}" />
                </Grid>

                <GridSplitter
                    x:Name="RightSplitter"
                    Grid.Column="3"
                    Width="5"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    ShowsPreview="False"
                    Visibility="Collapsed" />
                <panels:RightBrowserView
                    x:Name="RightPanel"
                    Grid.Column="4"
                    Visibility="Collapsed" />
            </Grid>

            <GridSplitter
                x:Name="OutputSplitter"
                Grid.Row="1"
                Height="5"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                ShowsPreview="False" />
            <shell:OutputPanelView x:Name="OutputPanel" Grid.Row="2" />
        </Grid>

        <!--  Status bar  -->
        <Border
            Grid.Row="3"
            Padding="12,4"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    a11y:LiveRegion.Text="{Binding StatusMessage}"
                    Style="{StaticResource ShellCaptionTextStyle}"
                    Text="{Binding StatusMessage}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,12,0"
                    Orientation="Horizontal"
                    Visibility="{Binding IsOperationRunning, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar
                        Width="120"
                        Height="6"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource Str.Shell.A11y.Progress}"
                        IsIndeterminate="{Binding IsOperationIndeterminate, Mode=OneWay}"
                        Maximum="1"
                        Minimum="0"
                        Value="{Binding OperationFraction, Mode=OneWay}" />
                    <TextBlock
                        MaxWidth="320"
                        Margin="8,0,0,0"
                        a11y:LiveRegion.Text="{Binding OperationText}"
                        Style="{StaticResource ShellCaptionTextStyle}"
                        Text="{Binding OperationText}"
                        TextTrimming="CharacterEllipsis" />
                    <ui:Button
                        Margin="6,0,0,0"
                        Command="{Binding CancelOperationCommand}"
                        Icon="{ui:SymbolIcon Stop24}"
                        Style="{StaticResource ShellStatusButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Operation.CancelTip}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button
                        a11y:LiveRegion.Text="{Binding ProblemsTip}"
                        Command="{Binding ShowProblemsCommand}"
                        Style="{StaticResource ShellStatusButtonStyle}"
                        ToolTip="{Binding ProblemsTip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                FontSize="14"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Symbol="ErrorCircle24" />
                            <TextBlock
                                Margin="4,0,10,0"
                                Style="{StaticResource ShellCaptionTextStyle}"
                                Text="{Binding Output.ProblemErrorCount}" />
                            <ui:SymbolIcon
                                FontSize="14"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Symbol="Warning24" />
                            <TextBlock
                                Margin="4,0,0,0"
                                Style="{StaticResource ShellCaptionTextStyle}"
                                Text="{Binding Output.ProblemWarningCount}" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button
                        Command="{Binding UpdateParserDataCommand}"
                        Content="{Binding ParserStatusText}"
                        Style="{StaticResource ShellStatusTextButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.ParserStatus}" />
                    <TextBlock
                        MinWidth="44"
                        Margin="0,0,12,0"
                        Style="{StaticResource ShellCaptionTextStyle}"
                        Text="{Binding LineText}" />
                    <TextBlock
                        MinWidth="44"
                        Margin="0,0,16,0"
                        Style="{StaticResource ShellCaptionTextStyle}"
                        Text="{Binding ColumnText}" />
                    <ui:Button
                        Click="OnZoomClick"
                        Content="{Binding ZoomText}"
                        PreviewMouseLeftButtonUp="OnZoomPreviewMouseUp"
                        Style="{StaticResource ShellStatusTextButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Tip.Zoom}" />
                    <ui:Button
                        Margin="0"
                        Command="{Binding ProjectSettingsCommand}"
                        Style="{StaticResource ShellStatusTextButtonStyle}"
                        ToolTip="{Binding ProjectTip}">
                        <TextBlock
                            MaxWidth="340"
                            Text="{Binding ProjectText}"
                            TextTrimming="CharacterEllipsis" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Go to procedure popup  -->
        <Popup
            x:Name="GoToProcedurePopup"
            Grid.Row="1"
            AllowsTransparency="True"
            IsOpen="{Binding IsGoToProcedureOpen, Mode=TwoWay}"
            Opened="OnGoToProcedureOpened"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=GoToProcedureButton}"
            PopupAnimation="Fade"
            StaysOpen="False">
            <Border
                Width="320"
                Margin="8"
                Padding="8"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ShellCornerRadius}">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="16"
                        Opacity="0.3"
                        ShadowDepth="2" />
                </Border.Effect>
                <StackPanel>
                    <ui:TextBox
                        x:Name="ProcedureFilterBox"
                        AutomationProperties.Name="{DynamicResource Str.Shell.Popup.GoToProcedure}"
                        PlaceholderText="{DynamicResource Str.Shell.Popup.GoToProcedure}"
                        PreviewKeyDown="OnProcedureFilterKeyDown"
                        Text="{Binding GoToProcedureFilter, UpdateSourceTrigger=PropertyChanged}" />
                    <ListBox
                        x:Name="ProcedureList"
                        MaxHeight="320"
                        Margin="0,8,0,0"
                        AutomationProperties.Name="{DynamicResource Str.Shell.Popup.GoToProcedure}"
                        Background="Transparent"
                        BorderThickness="0"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding GoToProcedureItems}"
                        MouseDoubleClick="OnProcedureListDoubleClick"
                        PreviewKeyDown="OnProcedureListKeyDown" />
                </StackPanel>
            </Border>
        </Popup>

        <!--  Toast  -->
        <Border
            x:Name="Toast"
            Grid.Row="0"
            Grid.RowSpan="4"
            MinWidth="200"
            Padding="24,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="100"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="24"
                    Opacity="0.35"
                    ShadowDepth="4" />
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon
                    x:Name="ToastIcon"
                    HorizontalAlignment="Center"
                    FontSize="40"
                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                    Symbol="CheckmarkCircle24" />
                <TextBlock
                    x:Name="ToastTitle"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="ToastMessage"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ShellCaptionTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>

</ui:FluentWindow>