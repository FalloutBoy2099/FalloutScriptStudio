<ui:FluentWindow FontSize="12" x:Class="FalloutScriptStudio.Views.Shell.MainWindow"
				 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
				 xmlns:docs="clr-namespace:FalloutScriptStudio.Documents"
				 xmlns:svc="clr-namespace:FalloutScriptStudio.Services"
				 xmlns:panels="clr-namespace:FalloutScriptStudio.Views.Panels"
				 xmlns:shell="clr-namespace:FalloutScriptStudio.Views.Shell"
				 Title="{Binding Title}"
				 Width="1360"
				 Height="860"
				 MinWidth="720"
				 MinHeight="480"
				 AllowDrop="True"
				 ExtendsContentIntoTitleBar="True"
				 WindowBackdropType="Mica"
				 WindowCornerPreference="Round"
				 Drop="OnWindowDrop"
				 DragOver="OnWindowDragOver">
	<Window.Resources>
		<Style x:Key="DocumentMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
			<Setter Property="IsEnabled" Value="{Binding HasDocument}" />
		</Style>
		<Style x:Key="ScriptMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
			<Setter Property="IsEnabled" Value="{Binding IsScript}" />
		</Style>
		<Style x:Key="ParsableMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
			<Setter Property="IsEnabled" Value="{Binding IsParsable}" />
		</Style>
		<Style x:Key="ToolbarComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
			<Setter Property="Height" Value="32" />
			<Setter Property="MinWidth" Value="130" />
			<Setter Property="Margin" Value="4,0" />
		</Style>
	</Window.Resources>

	<Window.InputBindings>
		<KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewScriptCommand}" />
		<KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}" />
		<KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
		<KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAllCommand}" />
		<KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseDocumentCommand}" />
		<KeyBinding Key="Tab" Modifiers="Ctrl" Command="{Binding NextDocumentCommand}" />
		<KeyBinding Key="Tab" Modifiers="Ctrl+Shift" Command="{Binding PreviousDocumentCommand}" />
		<KeyBinding Key="PageDown" Modifiers="Ctrl" Command="{Binding NextDocumentCommand}" />
		<KeyBinding Key="PageUp" Modifiers="Ctrl" Command="{Binding PreviousDocumentCommand}" />
		<KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding AdvancedSearchCommand}" />
		<KeyBinding Key="H" Modifiers="Ctrl" Command="{Binding ShowSearchBarCommand}" />
		<KeyBinding Key="F3" Modifiers="Ctrl" Command="{Binding QuickFindCommand}" />
		<KeyBinding Key="F3" Command="{Binding FindNextCommand}" />
		<KeyBinding Key="F3" Modifiers="Shift" Command="{Binding FindPreviousCommand}" />
		<KeyBinding Key="G" Modifiers="Ctrl" Command="{Binding GoToLineCommand}" />
		<KeyBinding Key="P" Modifiers="Alt" Command="{Binding GoToProcedureCommand}" />
		<KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding Procedures.CreateProcedureCommand}" />
		<KeyBinding Key="E" Modifiers="Alt" Command="{Binding ToggleFunctionTreeCommand}" />
		<KeyBinding Key="R" Modifiers="Alt" Command="{Binding ToggleRightBrowserCommand}" />
		<KeyBinding Key="L" Modifiers="Alt" Command="{Binding ToggleLogCommand}" />
		<KeyBinding Key="F7" Command="{Binding ScriptsListCommand}" />
		<KeyBinding Key="F8" Command="{Binding CompileCommand}" />
		<KeyBinding Key="F4" Command="{Binding PreprocessCommand}" />
		<KeyBinding Key="F5" Command="{Binding RoundTripCommand}" />
		<KeyBinding Key="G" Modifiers="Alt+Shift" Command="{Binding OpenAllIncludesCommand}" />
		<KeyBinding Key="M" Modifiers="Alt" Command="{Binding CheckMessageStructureCommand}" />
		<KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ZoomInCommand}" />
		<KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}" />
		<KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding ResetZoomCommand}" />
	</Window.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Title bar with the menu -->
		<StackPanel Grid.Row="0">
		<ui:TitleBar x:Name="TitleBar" Title="" Height="30">
			<ui:TitleBar.Icon>
				<ui:ImageIcon Source="pack://application:,,,/Assets/Icons/app.ico" />
			</ui:TitleBar.Icon>
			<ui:TitleBar.TrailingContent>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Top">
					<ui:Button x:Name="ThemeButton" Width="44" Height="30" MinWidth="0" MinHeight="0" Margin="0" BorderThickness="0" CornerRadius="0" Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon DarkTheme24}" ToolTip="{DynamicResource Str.Common.Theme}" AutomationProperties.Name="{DynamicResource Str.Common.Theme}" Click="OnThemeButtonClick" />
					<ui:Button x:Name="LanguageButton" Width="44" Height="30" MinWidth="0" MinHeight="0" Margin="0" BorderThickness="0" CornerRadius="0" Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon LocalLanguage24}" ToolTip="{DynamicResource Str.Common.LanguageTip}" AutomationProperties.Name="{DynamicResource Str.Common.LanguageTip}" Click="OnLanguageButtonClick" />
				</StackPanel>
			</ui:TitleBar.TrailingContent>
			<ui:TitleBar.CenterContent>
				<TextBlock Text="{Binding Title}"
						   Style="{StaticResource ShellCaptionTextStyle}"
						   TextTrimming="CharacterEllipsis"
						   MaxWidth="520" />
			</ui:TitleBar.CenterContent>
		</ui:TitleBar>

		<!-- Menu bar (under the slim title bar, like DatExplorerIII) -->
		<Border Padding="4,0,4,0">
			<Menu x:Name="MainMenu" Margin="0" VerticalAlignment="Center" Background="Transparent">
					<MenuItem Header="{DynamicResource Str.Common.File}">
						<MenuItem Header="{DynamicResource Str.Shell.Menu.NewScript}" InputGestureText="Ctrl+N" Command="{Binding NewScriptCommand}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="DocumentAdd24" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem x:Name="TemplatesMenu" Header="{DynamicResource Str.Shell.Menu.NewFromTemplate}" SubmenuOpened="OnTemplatesMenuOpened">
							<MenuItem Header="{DynamicResource Str.Common.Loading}" IsEnabled="False" />
						</MenuItem>
						<MenuItem Header="{DynamicResource Str.Shell.Menu.Open}" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="FolderOpen24" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem x:Name="RecentMenu" Header="{DynamicResource Str.Shell.Menu.OpenRecent}" SubmenuOpened="OnRecentMenuOpened">
							<MenuItem Header="{DynamicResource Str.Common.Loading}" IsEnabled="False" />
						</MenuItem>
						<MenuItem Header="{DynamicResource Str.Shell.Menu.OpenFromArchive}" Command="{Binding OpenFromArchiveCommand}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Common.Save}" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" Style="{StaticResource DocumentMenuItemStyle}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="Save24" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="{DynamicResource Str.Shell.Menu.SaveAll}" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAllCommand}" Style="{StaticResource DocumentMenuItemStyle}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="SaveMultiple24" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="{DynamicResource Str.Shell.Menu.SaveAs}" Command="{Binding SaveAsCommand}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.SaveAsTemplate}" Command="{Binding SaveAsTemplateCommand}" Style="{StaticResource ScriptMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.SaveUtf8}" IsCheckable="True" IsChecked="{Binding SaveAsUtf8, Mode=TwoWay}"
								  ToolTip="{DynamicResource Str.Shell.Tip.SaveUtf8}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Common.Close}" InputGestureText="Ctrl+W" Command="{Binding CloseDocumentCommand}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.CloseAll}" Command="{Binding CloseAllCommand}" Style="{StaticResource DocumentMenuItemStyle}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.Exit}" InputGestureText="Alt+F4" Command="{Binding ExitCommand}" />
					</MenuItem>

					<MenuItem Header="{DynamicResource Str.Shell.Menu.Edit}">
						<MenuItem Header="{DynamicResource Str.Common.Undo}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="ArrowUndo24" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="{DynamicResource Str.Common.Redo}" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="ArrowRedo24" />
							</MenuItem.Icon>
						</MenuItem>
						<Separator />
						<MenuItem Header="{DynamicResource Str.Common.Cut}" InputGestureText="Ctrl+X" Command="{Binding CutCommand}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Common.Copy}" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Common.Paste}" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Common.SelectAll}" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" Style="{StaticResource DocumentMenuItemStyle}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.FindInFiles}" InputGestureText="Ctrl+F" Command="{Binding AdvancedSearchCommand}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="Search24" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="{DynamicResource Str.Shell.Menu.FindReplaceBar}" InputGestureText="Ctrl+H" Command="{Binding ShowSearchBarCommand}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.QuickFind}" InputGestureText="Ctrl+F3" Command="{Binding QuickFindCommand}" Style="{StaticResource DocumentMenuItemStyle}"
								  ToolTip="{DynamicResource Str.Shell.Tip.QuickFind}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.FindNext}" InputGestureText="F3" Command="{Binding FindNextCommand}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.FindPrevious}" InputGestureText="Shift+F3" Command="{Binding FindPreviousCommand}" Style="{StaticResource DocumentMenuItemStyle}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.GoToLine}" InputGestureText="Ctrl+G" Command="{Binding GoToLineCommand}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.GoToProcedure}" InputGestureText="Alt+P" Command="{Binding GoToProcedureCommand}" Style="{StaticResource ParsableMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.Back}" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="ArrowLeft24" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="{DynamicResource Str.Shell.Menu.Forward}" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="ArrowRight24" />
							</MenuItem.Icon>
						</MenuItem>
						<Separator />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.SplitDocument}" InputGestureText="Alt+S" Command="{Binding EditCommand}"
								  CommandParameter="{x:Static docs:EditorCommand.SplitDocument}" Style="{StaticResource DocumentMenuItemStyle}" />
					</MenuItem>

					<MenuItem Header="{DynamicResource Str.Shell.Menu.Code}">
						<MenuItem Header="{DynamicResource Str.Shell.Menu.CommentText}" InputGestureText="Alt+C" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.CommentSelection}" Style="{StaticResource ParsableMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.UncommentText}" InputGestureText="Alt+X" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.UncommentSelection}" Style="{StaticResource ParsableMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.ToggleLineComment}" InputGestureText="Ctrl+/" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.ToggleLineComment}" Style="{StaticResource ParsableMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.ToggleRegionComment}" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.ToggleBlockComment}" Style="{StaticResource ParsableMenuItemStyle}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.AlignSelectedText}" InputGestureText="Alt+A" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.AlignSelectionLeft}" Style="{StaticResource ParsableMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.DecreaseIndent}" InputGestureText="Alt+Q" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.DecreaseIndent}" Style="{StaticResource ParsableMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.IncreaseIndent}" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.IncreaseIndent}" Style="{StaticResource ParsableMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.FormatDocument}" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.FormatDocument}" Style="{StaticResource ParsableMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.FormatSelection}" InputGestureText="Alt+F" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.FormatSelection}" Style="{StaticResource ParsableMenuItemStyle}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.UpperCase}" InputGestureText="Ctrl+Shift+A" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.UpperCase}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.LowerCase}" InputGestureText="Ctrl+Shift+Z" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.LowerCase}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.CapitalizeWord}" InputGestureText="Ctrl+Shift+W" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.CapitalizeWord}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.ConvertHexDec}" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.ConvertHexDec}" Style="{StaticResource DocumentMenuItemStyle}"
								  ToolTip="{DynamicResource Str.Shell.Tip.ConvertHexDec}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.ConvertLeadingTabsToSpaces}" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.ConvertLeadingTabsToSpaces}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.ConvertAllTabsToSpaces}" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.ConvertAllTabsToSpaces}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.ConvertLeadingSpacesToTabs}" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.ConvertLeadingSpacesToTabs}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.TrimTrailingSpaces}" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.TrimTrailingSpaces}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.AutoTrimTrailing}" IsCheckable="True" IsChecked="{Binding AutoTrimTrailingSpaces, Mode=TwoWay}"
								  ToolTip="{DynamicResource Str.Shell.Tip.AutoTrimTrailing}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.AutoFormatCode}" IsCheckable="True" IsChecked="{Binding FormatCodeOnOpen, Mode=TwoWay}"
								  ToolTip="{DynamicResource Str.Shell.Tip.AutoFormatCode}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.ShowWhitespace}" IsCheckable="True" IsChecked="{Binding ShowWhitespace, Mode=TwoWay}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.HighlightWord}" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.HighlightWord}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.Autocomplete}" InputGestureText="Ctrl+Space / Alt+Space" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.ShowCompletion}" Style="{StaticResource ParsableMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.ToggleOutline}" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.ToggleOutline}" Style="{StaticResource ParsableMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.CollapseAll}" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.CollapseAll}" Style="{StaticResource ParsableMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.ExpandAll}" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.ExpandAll}" Style="{StaticResource ParsableMenuItemStyle}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.GoToDeclaration}" InputGestureText="Ctrl+F12" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.GoToDeclaration}" Style="{StaticResource ParsableMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.GoToDefinition}" InputGestureText="F12" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.GoToDefinition}" Style="{StaticResource ParsableMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.FindReferences}" InputGestureText="Alt+F12" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.FindReferences}" Style="{StaticResource ParsableMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Common.Rename}" InputGestureText="F2" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.RenameSymbol}" Style="{StaticResource ParsableMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.OpenInclude}" InputGestureText="Alt+G" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.OpenInclude}" Style="{StaticResource ParsableMenuItemStyle}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.CheckMessageStructure}" InputGestureText="Alt+M" Command="{Binding CheckMessageStructureCommand}" IsEnabled="{Binding IsMessage}" />
					</MenuItem>

					<MenuItem Header="{DynamicResource Str.Shell.Menu.Script}">
						<MenuItem Header="{DynamicResource Str.Shell.Menu.ScriptsListEditor}" InputGestureText="F7" Command="{Binding ScriptsListCommand}"
								  ToolTip="{DynamicResource Str.Shell.Tip.ScriptsListEditor}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.RegisterScript}" Command="{Binding RegisterScriptCommand}" Style="{StaticResource ScriptMenuItemStyle}"
								  ToolTip="{DynamicResource Str.Shell.Tip.RegisterScript}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.DefineToScriptsHeader}" IsCheckable="True" IsChecked="{Binding DefineToScriptsHeader, Mode=TwoWay}"
								  ToolTip="{DynamicResource Str.Shell.Tip.DefineToScriptsHeader}" />
					</MenuItem>

					<MenuItem Header="{DynamicResource Str.Shell.Menu.Headers}">
						<MenuItem Header="{DynamicResource Str.Shell.Menu.IncludeFile}" Command="{Binding IncludeFileToCodeCommand}" Style="{StaticResource ParsableMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.OpenHeader}" Command="{Binding OpenHeaderFileCommand}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.BrowseHeaders}" Command="{Binding BrowseHeadersCommand}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.OpenAllIncludes}" InputGestureText="Alt+Shift+G" Command="{Binding OpenAllIncludesCommand}" Style="{StaticResource ParsableMenuItemStyle}" />
					</MenuItem>

					<MenuItem Header="{DynamicResource Str.Shell.Menu.Dialog}">
						<MenuItem Header="{DynamicResource Str.Shell.Menu.MessageEditor}" Command="{Binding OpenMessageEditorCommand}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.AssociatedMessageFile}" Command="{Binding AssociateMessageFileCommand}" Style="{StaticResource ScriptMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.NodesFlowchart}" Command="{Binding ShowFlowchartCommand}" Style="{StaticResource ScriptMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.DialoguePreview}" Command="{Binding ShowDialoguePreviewCommand}" Style="{StaticResource ScriptMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.FunctionsConfig}" Command="{Binding ShowFunctionRulesCommand}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.AutoOpenMessageEditor}" IsCheckable="True" IsChecked="{Binding AutoOpenMessageEditor, Mode=TwoWay}"
								  ToolTip="{DynamicResource Str.Shell.Tip.AutoOpenMessageEditor}" />
					</MenuItem>

					<MenuItem Header="{DynamicResource Str.Shell.Menu.Compile}">
						<MenuItem Header="{DynamicResource Str.Shell.Menu.CompileScript}" InputGestureText="F8" Command="{Binding CompileCommand}" Style="{StaticResource ScriptMenuItemStyle}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="Play24" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="{DynamicResource Str.Shell.Menu.CompileAllOpen}" Command="{Binding CompileAllOpenCommand}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.MassCompile}" Command="{Binding MassCompileCommand}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.Preprocess}" InputGestureText="F4" Command="{Binding PreprocessCommand}" Style="{StaticResource ScriptMenuItemStyle}"
								  ToolTip="{DynamicResource Str.Shell.Tip.Preprocess}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.Roundtrip}" InputGestureText="F5" Command="{Binding RoundTripCommand}" Style="{StaticResource ScriptMenuItemStyle}"
								  ToolTip="{DynamicResource Str.Shell.Tip.Roundtrip}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.DecompileFallout1}" IsCheckable="True" IsChecked="{Binding DecompileAsFallout1, Mode=TwoWay}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.UseOldDecompiler}" IsCheckable="True" IsChecked="{Binding UseOldDecompiler, Mode=TwoWay}" IsEnabled="{Binding CanUseOldDecompiler}" ToolTip="{DynamicResource Str.Shell.Menu.UseOldDecompilerTip}" ToolTipService.ShowOnDisabled="True" />
					</MenuItem>

					<MenuItem Header="{DynamicResource Str.Shell.Menu.View}">
						<MenuItem Header="{DynamicResource Str.Shell.Menu.LineNumbers}" IsCheckable="True" IsChecked="{Binding ShowLineNumbers, Mode=TwoWay}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.ShowIndentLine}" IsCheckable="True" IsChecked="{Binding ShowIndentLine, Mode=TwoWay}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.HighlightParseErrors}" IsCheckable="True" IsChecked="{Binding HighlightParseErrors, Mode=TwoWay}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.RightBrowser}" InputGestureText="Alt+R" IsCheckable="True" IsChecked="{Binding ShowRightBrowser, Mode=TwoWay}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.FunctionTree}" InputGestureText="Alt+E" IsCheckable="True" IsChecked="{Binding ShowFunctionTree, Mode=TwoWay}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.LogWindow}" InputGestureText="Alt+L" IsCheckable="True" IsChecked="{Binding ShowLog, Mode=TwoWay}" />
						<Separator />
						<MenuItem Header="{DynamicResource Str.Common.Theme}">
							<MenuItem Header="{DynamicResource Str.Common.ThemeSystem}" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.System}" />
							<MenuItem Header="{DynamicResource Str.Common.ThemeLight}" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.Light}" />
							<MenuItem Header="{DynamicResource Str.Common.ThemeDark}" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.Dark}" />
						</MenuItem>
						<MenuItem x:Name="LanguageMenu" Header="{DynamicResource Str.Common.LanguageTip}" SubmenuOpened="OnLanguageMenuOpened">
							<MenuItem Header="{DynamicResource Str.Common.Loading}" IsEnabled="False" />
						</MenuItem>
						<Separator />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.ZoomIn}" InputGestureText="Ctrl++" Command="{Binding ZoomInCommand}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.ZoomOut}" InputGestureText="Ctrl+-" Command="{Binding ZoomOutCommand}" Style="{StaticResource DocumentMenuItemStyle}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.ResetZoom}" InputGestureText="Ctrl+0" Command="{Binding ResetZoomCommand}" Style="{StaticResource DocumentMenuItemStyle}" />
					</MenuItem>

					<MenuItem Header="{DynamicResource Str.Shell.Menu.Options}">
						<MenuItem Header="{DynamicResource Str.Shell.Menu.Settings}" Command="{Binding SettingsCommand}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="Settings24" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="{DynamicResource Str.Shell.Menu.SetProjectFolder}" Command="{Binding SetProjectFolderCommand}"
								  ToolTip="{DynamicResource Str.Shell.Tip.SetProjectFolder}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.MessageEncoding}">
							<MenuItem Header="{DynamicResource Str.Shell.Menu.EncodingWindows}" IsCheckable="True" IsChecked="{Binding UseWindowsMessageEncoding, Mode=TwoWay}" />
							<MenuItem Header="{DynamicResource Str.Shell.Menu.EncodingOem}" IsCheckable="True" IsChecked="{Binding UseOemMessageEncoding, Mode=TwoWay}" />
						</MenuItem>
					</MenuItem>

					<MenuItem Header="{DynamicResource Str.Common.Help}">
						<MenuItem Header="{DynamicResource Str.Shell.Menu.Documentation}" Command="{Binding HelpCommand}" />
						<MenuItem Header="{DynamicResource Str.Shell.Menu.About}" Command="{Binding AboutCommand}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="Info24" />
							</MenuItem.Icon>
						</MenuItem>
					</MenuItem>
				</Menu>
		</Border>
	</StackPanel>

		<!-- Toolbar -->
		<Border Grid.Row="1"
				Padding="8,2"
				Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
				BorderThickness="0,0,0,1">
			<ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
				<StackPanel Orientation="Horizontal">
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon DocumentAdd24}" ToolTip="{DynamicResource Str.Shell.Tip.NewScript}" Command="{Binding NewScriptCommand}" />
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{DynamicResource Str.Shell.Tip.Open}" Command="{Binding OpenCommand}" />
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon Save24}" ToolTip="{DynamicResource Str.Shell.Tip.Save}" Command="{Binding SaveCommand}" IsEnabled="{Binding HasDocument}" />
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon SaveMultiple24}" ToolTip="{DynamicResource Str.Shell.Tip.SaveAll}" Command="{Binding SaveAllCommand}" IsEnabled="{Binding HasDocument}" />
					<Rectangle Style="{StaticResource ShellToolbarSeparatorStyle}" />
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon ArrowUndo24}" ToolTip="{DynamicResource Str.Shell.Tip.Undo}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon ArrowRedo24}" ToolTip="{DynamicResource Str.Shell.Tip.Redo}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" />
					<Rectangle Style="{StaticResource ShellToolbarSeparatorStyle}" />
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon Search24}" ToolTip="{DynamicResource Str.Shell.Tip.FindReplaceBar}" Command="{Binding ShowSearchBarCommand}" IsEnabled="{Binding HasDocument}" />
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon ArrowLeft24}" ToolTip="{DynamicResource Str.Shell.Tip.Back}" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" />
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon ArrowRight24}" ToolTip="{DynamicResource Str.Shell.Tip.Forward}" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" />
					<ui:Button x:Name="GoToProcedureButton" Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon TextBulletListSquare24}" ToolTip="{DynamicResource Str.Shell.Tip.GoToProcedure}" Command="{Binding GoToProcedureCommand}" IsEnabled="{Binding IsParsable}" />
					<Rectangle Style="{StaticResource ShellToolbarSeparatorStyle}" />
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon CommentAdd24}" ToolTip="{DynamicResource Str.Shell.Tip.ToggleComment}" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.ToggleLineComment}" IsEnabled="{Binding IsParsable}" />
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon TextIndentDecrease24}" ToolTip="{DynamicResource Str.Shell.Tip.DecreaseIndent}" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.DecreaseIndent}" IsEnabled="{Binding IsParsable}" />
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon ChevronUpDown24}" ToolTip="{DynamicResource Str.Shell.Tip.ToggleOutline}" Command="{Binding EditCommand}" CommandParameter="{x:Static docs:EditorCommand.ToggleOutline}" IsEnabled="{Binding IsParsable}" />
					<Rectangle Style="{StaticResource ShellToolbarSeparatorStyle}" />
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon Play24}" ToolTip="{DynamicResource Str.Shell.Tip.Compile}" Command="{Binding CompileCommand}" IsEnabled="{Binding IsScript}" />
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon PlayCircle24}" ToolTip="{DynamicResource Str.Shell.Tip.CompileAllOpen}" Command="{Binding CompileAllOpenCommand}" IsEnabled="{Binding HasDocument}" />
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon Rocket24}" ToolTip="{DynamicResource Str.Shell.Tip.MassCompile}" Command="{Binding MassCompileCommand}" />
					<ComboBox Style="{StaticResource ToolbarComboBoxStyle}"
							  ItemsSource="{Binding PreprocessorDefineOptions}"
							  SelectedValuePath="Value"
							  SelectedValue="{Binding SelectedPreprocessorDefine, Mode=TwoWay}"
							  ToolTip="{DynamicResource Str.Shell.Tip.PreprocessorDefine}">
						<!-- A template (not DisplayMemberPath) keeps the selection box live when the caption changes with the language. -->
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Caption}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<Rectangle Style="{StaticResource ShellToolbarSeparatorStyle}" />
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon Chat24}" ToolTip="{DynamicResource Str.Shell.Tip.MessageEditor}" Command="{Binding OpenMessageEditorCommand}" />
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon Organization24}" ToolTip="{DynamicResource Str.Shell.Tip.Flowchart}" Command="{Binding ShowFlowchartCommand}" IsEnabled="{Binding IsScript}" />
					<Rectangle Style="{StaticResource ShellToolbarSeparatorStyle}" />
					<ToggleButton Width="32" Height="32" Padding="0" Margin="1,0" Background="Transparent" BorderThickness="0"
								  ToolTip="{DynamicResource Str.Shell.Tip.ToggleFunctionTree}"
								  IsChecked="{Binding ShowFunctionTree, Mode=TwoWay}">
						<ui:SymbolIcon Symbol="PanelLeft24" FontSize="16" />
					</ToggleButton>
					<ToggleButton Width="32" Height="32" Padding="0" Margin="1,0" Background="Transparent" BorderThickness="0"
								  ToolTip="{DynamicResource Str.Shell.Tip.ToggleRightBrowser}"
								  IsChecked="{Binding ShowRightBrowser, Mode=TwoWay}">
						<ui:SymbolIcon Symbol="PanelRight24" FontSize="16" />
					</ToggleButton>
					<ui:Button Style="{StaticResource ShellIconButtonStyle}" Icon="{ui:SymbolIcon Settings24}" ToolTip="{DynamicResource Str.Common.Settings}" Command="{Binding SettingsCommand}" />
				</StackPanel>
			</ScrollViewer>
		</Border>

		<!-- Body -->
		<Grid x:Name="BodyGrid" Grid.Row="2">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" MinHeight="140" />
				<RowDefinition Height="Auto" />
				<RowDefinition x:Name="OutputRow" Height="220" />
			</Grid.RowDefinitions>

			<Grid x:Name="EditorArea" Grid.Row="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition x:Name="LeftColumn" Width="0" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" MinWidth="320" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition x:Name="RightColumn" Width="0" />
				</Grid.ColumnDefinitions>

				<Border x:Name="LeftPanel"
						Grid.Column="0"
						Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
						BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
						BorderThickness="0,0,1,0"
						Visibility="Collapsed">
					<panels:FunctionsPanelView DataContext="{Binding Functions}" />
				</Border>
				<GridSplitter x:Name="LeftSplitter"
							  Grid.Column="1"
							  Width="5"
							  HorizontalAlignment="Stretch"
							  Background="Transparent"
							  ShowsPreview="False"
							  Visibility="Collapsed" />

				<Grid Grid.Column="2">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<shell:DocumentTabStrip Grid.Row="0" Margin="8,4,8,0" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}" />
					<shell:SearchBarView Grid.Row="1" DataContext="{Binding Search}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
					<ContentControl Grid.Row="2"
									Content="{Binding ActiveDocument}"
									Focusable="False"
									IsTabStop="False" />
					<shell:WelcomeView Grid.Row="0"
									   Grid.RowSpan="3"
									   Visibility="{Binding HasDocument, Converter={StaticResource InvertedBoolToVisibility}}" />
				</Grid>

				<GridSplitter x:Name="RightSplitter"
							  Grid.Column="3"
							  Width="5"
							  HorizontalAlignment="Stretch"
							  Background="Transparent"
							  ShowsPreview="False"
							  Visibility="Collapsed" />
				<panels:RightBrowserView x:Name="RightPanel" Grid.Column="4" Visibility="Collapsed" />
			</Grid>

			<GridSplitter x:Name="OutputSplitter"
						  Grid.Row="1"
						  Height="5"
						  HorizontalAlignment="Stretch"
						  Background="Transparent"
						  ShowsPreview="False" />
			<shell:OutputPanelView x:Name="OutputPanel" Grid.Row="2" />
		</Grid>

		<!-- Status bar -->
		<Border Grid.Row="3"
				Padding="12,4"
				Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
				BorderThickness="0,1,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock Style="{StaticResource ShellCaptionTextStyle}"
						   Text="{Binding StatusMessage}"
						   TextTrimming="CharacterEllipsis" />
				<StackPanel Grid.Column="1" Orientation="Horizontal">
					<TextBlock Style="{StaticResource ShellCaptionTextStyle}"
							   Text="{Binding ParserStatusText}"
							   Cursor="Hand"
							   Margin="0,0,16,0"
							   ToolTip="{DynamicResource Str.Shell.Tip.ParserStatus}"
							   MouseLeftButtonUp="OnParserStatusClick" />
					<TextBlock Style="{StaticResource ShellCaptionTextStyle}" Text="{Binding LineText}" Margin="0,0,12,0" MinWidth="44" />
					<TextBlock Style="{StaticResource ShellCaptionTextStyle}" Text="{Binding ColumnText}" Margin="0,0,16,0" MinWidth="44" />
					<TextBlock Style="{StaticResource ShellCaptionTextStyle}"
							   Text="{Binding ZoomText}"
							   Cursor="Hand"
							   Margin="0,0,16,0"
							   ToolTip="{DynamicResource Str.Shell.Tip.Zoom}"
							   MouseLeftButtonUp="OnZoomClick" />
					<TextBlock Style="{StaticResource ShellCaptionTextStyle}"
							   Text="{Binding ProjectText}"
							   Cursor="Hand"
							   MaxWidth="360"
							   TextTrimming="CharacterEllipsis"
							   ToolTip="{DynamicResource Str.Shell.Tip.Project}"
							   MouseLeftButtonUp="OnProjectClick" />
				</StackPanel>
			</Grid>
		</Border>

		<!-- Go to procedure popup -->
		<Popup x:Name="GoToProcedurePopup"
			   Grid.Row="1"
			   IsOpen="{Binding IsGoToProcedureOpen, Mode=TwoWay}"
			   PlacementTarget="{Binding ElementName=GoToProcedureButton}"
			   Placement="Bottom"
			   StaysOpen="False"
			   AllowsTransparency="True"
			   PopupAnimation="Fade"
			   Opened="OnGoToProcedureOpened">
			<Border Margin="8"
					Padding="8"
					Width="320"
					CornerRadius="{StaticResource ShellCornerRadius}"
					Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
					BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
					BorderThickness="1">
				<Border.Effect>
					<DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" />
				</Border.Effect>
				<StackPanel>
					<ui:TextBox x:Name="ProcedureFilterBox"
								Text="{Binding GoToProcedureFilter, UpdateSourceTrigger=PropertyChanged}"
								PlaceholderText="{DynamicResource Str.Shell.Popup.GoToProcedure}"
								PreviewKeyDown="OnProcedureFilterKeyDown" />
					<ListBox x:Name="ProcedureList"
							 Margin="0,8,0,0"
							 MaxHeight="320"
							 ItemsSource="{Binding GoToProcedureItems}"
							 DisplayMemberPath="Name"
							 Background="Transparent"
							 BorderThickness="0"
							 MouseDoubleClick="OnProcedureListDoubleClick"
							 PreviewKeyDown="OnProcedureListKeyDown" />
				</StackPanel>
			</Border>
		</Popup>

		<!-- Toast -->
		<Border x:Name="Toast"
				Grid.Row="0"
				Grid.RowSpan="4"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Padding="24,16"
				MinWidth="200"
				CornerRadius="10"
				Opacity="0"
				IsHitTestVisible="False"
				Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
				BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				Panel.ZIndex="100">
			<Border.Effect>
				<DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" />
			</Border.Effect>
			<StackPanel HorizontalAlignment="Center">
				<ui:SymbolIcon x:Name="ToastIcon" Symbol="CheckmarkCircle24" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
				<TextBlock x:Name="ToastTitle" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
				<TextBlock x:Name="ToastMessage" HorizontalAlignment="Center" Style="{StaticResource ShellCaptionTextStyle}" />
			</StackPanel>
		</Border>
	</Grid>
</ui:FluentWindow>
