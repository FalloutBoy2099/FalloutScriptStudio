<UserControl
    x:Class="FalloutScriptStudio.Views.Shell.OutputPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:FalloutScriptStudio.ViewModels.Main"
    x:Name="Root"
    PreviewKeyDown="OnPreviewKeyDown">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ParserLogTabViewModel}">
            <TextBox
                AutomationProperties.Name="{DynamicResource Str.Shell.Output.TabParser}"
                Style="{StaticResource ShellLogTextBoxStyle}"
                Text="{Binding Output.ParserText, Mode=OneWay}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BuildLogTabViewModel}">
            <TextBox
                AutomationProperties.Name="{DynamicResource Str.Shell.Output.TabBuild}"
                Style="{StaticResource ShellLogTextBoxStyle}"
                Text="{Binding Output.BuildText, Mode=OneWay}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ErrorsTabViewModel}">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical"
                    Visibility="{Binding Output.HasNoProblems, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        FontSize="28"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Symbol="CheckmarkCircle24" />
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Str.Shell.Problems.NoProblems}" />
                </StackPanel>
                <DataGrid
                    AutoGenerateColumns="False"
                    AutomationProperties.Name="{DynamicResource Str.Shell.Output.TabErrors}"
                    Background="Transparent"
                    BorderThickness="0"
                    CanUserAddRows="False"
                    CanUserResizeRows="False"
                    ColumnHeaderHeight="22"
                    ColumnHeaderStyle="{StaticResource ShellCompactColumnHeaderStyle}"
                    FontSize="12"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Output.Errors}"
                    MinRowHeight="22"
                    MouseDoubleClick="OnErrorsDoubleClick"
                    PreviewKeyDown="OnErrorsKeyDown"
                    RowHeaderWidth="0"
                    RowHeight="22"
                    SelectedItem="{Binding Output.SelectedError, Mode=TwoWay}"
                    SelectionMode="Single">
                    <DataGrid.Style>
                        <Style BasedOn="{StaticResource {x:Type DataGrid}}" TargetType="{x:Type DataGrid}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Output.HasNoProblems}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Height="20"
                                        Margin="8,2,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Name}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <StackPanel>
                                                    <ContentPresenter />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="30"
                            MinWidth="30"
                            SortMemberPath="TypeText">
                            <DataGridTemplateColumn.Header>
                                <TextBlock
                                    AutomationProperties.Name="{DynamicResource Str.Common.Type}"
                                    Text=" "
                                    ToolTip="{DynamicResource Str.Common.Type}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ErrorItemViewModel}">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        Orientation="Horizontal"
                                        ToolTip="{Binding TypeText}">
                                        <ui:SymbolIcon
                                            x:Name="TypeIcon"
                                            FontSize="12"
                                            Symbol="{Binding Type, Converter={StaticResource ErrorTypeToSymbol}}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Error">
                                            <Setter TargetName="TypeIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="Warning">
                                            <Setter TargetName="TypeIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="Search">
                                            <Setter TargetName="TypeIcon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="130"
                            MinWidth="110"
                            Binding="{Binding FileName}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Str.Common.File}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="56"
                            MinWidth="52"
                            Binding="{Binding LineText}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Str.Common.Line}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="*" MinWidth="200">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Str.Common.Message}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ErrorItemViewModel}">
                                    <Grid ToolTip="{Binding ClipboardText}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="4,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding Message}"
                                            TextTrimming="CharacterEllipsis" />
                                        <ui:HyperlinkButton
                                            Grid.Column="1"
                                            Height="20"
                                            Margin="0,0,6,0"
                                            Padding="4,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.Output.RunProblemActionCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding ActionLabel}"
                                            FontSize="11"
                                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding Output.CopySelectedCommand}" Header="{DynamicResource Str.Shell.Output.CopySelected}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Copy24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding Output.CopyAllCommand}" Header="{DynamicResource Str.Shell.Problems.CopyAll}" />
                            <MenuItem Command="{Binding Output.RefreshCommand}" Header="{DynamicResource Str.Shell.Output.Refresh}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSync24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding Output.ClearAllCommand}" Header="{DynamicResource Str.Shell.Output.ClearAll}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Delete24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem
                                Header="{DynamicResource Str.Shell.Output.AutoRefresh}"
                                IsCheckable="True"
                                IsChecked="{Binding Output.AutoRefresh, Mode=TwoWay}" />
                            <MenuItem
                                Header="{DynamicResource Str.Shell.Output.ShowParserLog}"
                                IsCheckable="True"
                                IsChecked="{Binding Output.ShowParserEntries, Mode=TwoWay}" />
                            <MenuItem
                                Header="{DynamicResource Str.Shell.Output.ShowBuildLog}"
                                IsCheckable="True"
                                IsChecked="{Binding Output.ShowBuildEntries, Mode=TwoWay}" />
                            <MenuItem
                                Header="{DynamicResource Str.Shell.Output.GroupTools}"
                                IsCheckable="True"
                                IsChecked="{Binding Output.ShowToolEntries, Mode=TwoWay}" />
                            <MenuItem
                                Header="{DynamicResource Str.Shell.Output.GroupFiles}"
                                IsCheckable="True"
                                IsChecked="{Binding Output.ShowFileEntries, Mode=TwoWay}" />
                            <MenuItem
                                Header="{DynamicResource Str.Shell.Output.GroupSettings}"
                                IsCheckable="True"
                                IsChecked="{Binding Output.ShowSettingsEntries, Mode=TwoWay}" />
                            <MenuItem
                                Header="{DynamicResource Str.Shell.Output.GroupMessages}"
                                IsCheckable="True"
                                IsChecked="{Binding Output.ShowMessageEntries, Mode=TwoWay}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ResultsTabViewModel}">
            <DataGrid
                AutoGenerateColumns="False"
                AutomationProperties.Name="{Binding Title}"
                Background="Transparent"
                BorderThickness="0"
                CanUserAddRows="False"
                CanUserResizeRows="False"
                ColumnHeaderHeight="22"
                ColumnHeaderStyle="{StaticResource ShellCompactColumnHeaderStyle}"
                FontSize="12"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding Results}"
                MinRowHeight="22"
                MouseDoubleClick="OnErrorsDoubleClick"
                PreviewKeyDown="OnErrorsKeyDown"
                RowHeaderWidth="0"
                RowHeight="22"
                SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTemplateColumn
                        Width="30"
                        MinWidth="30"
                        SortMemberPath="TypeText">
                        <DataGridTemplateColumn.Header>
                            <TextBlock
                                AutomationProperties.Name="{DynamicResource Str.Common.Type}"
                                Text=" "
                                ToolTip="{DynamicResource Str.Common.Type}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:ErrorItemViewModel}">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Orientation="Horizontal"
                                    ToolTip="{Binding TypeText}">
                                    <ui:SymbolIcon
                                        x:Name="TypeIcon"
                                        FontSize="12"
                                        Symbol="{Binding Type, Converter={StaticResource ErrorTypeToSymbol}}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="Error">
                                        <Setter TargetName="TypeIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="Warning">
                                        <Setter TargetName="TypeIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="Search">
                                        <Setter TargetName="TypeIcon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="130"
                        MinWidth="110"
                        Binding="{Binding FileName}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str.Common.File}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="56"
                        MinWidth="52"
                        Binding="{Binding LineText}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str.Common.Line}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="200"
                        Binding="{Binding Message}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Str.Common.Message}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding CopySelectedCommand}" Header="{DynamicResource Str.Shell.Output.CopySelected}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </DataTemplate>

        <DataTemplate x:Key="ParserHeader">
            <TextBlock Text="{DynamicResource Str.Shell.Output.TabParser}" ToolTip="{DynamicResource Str.Shell.Output.TipParser}" />
        </DataTemplate>

        <DataTemplate x:Key="BuildHeader">
            <TextBlock Text="{DynamicResource Str.Shell.Output.TabBuild}" ToolTip="{DynamicResource Str.Shell.Output.TipBuild}" />
        </DataTemplate>

        <DataTemplate x:Key="ErrorsHeader">
            <StackPanel Orientation="Horizontal" ToolTip="{DynamicResource Str.Shell.Output.TipErrors}">
                <TextBlock Text="{DynamicResource Str.Shell.Output.TabErrors}" />
                <Border
                    Margin="4,0,0,0"
                    Padding="4,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                    CornerRadius="7"
                    Visibility="{Binding Output.ErrorCount, Converter={StaticResource CountToVisibility}}">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Text="{Binding Output.ErrorCount}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ResultsHeader">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Title}">
                <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
                <ui:Button
                    Margin="6,0,0,0"
                    Command="{Binding CloseCommand}"
                    Icon="{ui:SymbolIcon Dismiss12}"
                    Style="{StaticResource ShellCompactIconButtonStyle}"
                    ToolTip="{DynamicResource Str.Common.Close}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Border
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0">
        <Grid>
            <TabControl
                x:Name="OutputTabs"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                FontSize="12"
                ItemsSource="{Binding Output.Tabs}"
                SelectedIndex="{Binding Output.SelectedTab, Mode=TwoWay}"
                SelectionChanged="OnOutputTabsSelectionChanged">
                <TabControl.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type TabItem}}" TargetType="{x:Type TabItem}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Null}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Parser">
                                <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Shell.Output.TabParser}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Build">
                                <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Shell.Output.TabBuild}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Errors">
                                <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Shell.Output.TabErrors}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" Focusable="False">
                            <ContentControl.Style>
                                <Style TargetType="{x:Type ContentControl}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ResultsHeader}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Parser">
                                            <Setter Property="ContentTemplate" Value="{StaticResource ParserHeader}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Build">
                                            <Setter Property="ContentTemplate" Value="{StaticResource BuildHeader}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Errors">
                                            <Setter Property="ContentTemplate" Value="{StaticResource ErrorsHeader}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>

            <StackPanel
                Margin="0,3,6,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <ui:Button
                    Command="{Binding CancelOperationCommand}"
                    Icon="{ui:SymbolIcon Stop24}"
                    Style="{StaticResource ShellCompactIconButtonStyle}"
                    ToolTip="{DynamicResource Str.Shell.Operation.CancelTip}"
                    Visibility="{Binding IsOperationRunning, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding Output.IsErrorsTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <ToggleButton
                        IsChecked="{Binding Output.ShowErrors, Mode=TwoWay}"
                        Style="{StaticResource ShellCounterToggleStyle}"
                        ToolTip="{DynamicResource Str.Shell.Problems.ShowErrors}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                FontSize="12"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Symbol="ErrorCircle24" />
                            <TextBlock
                                Margin="3,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Output.ProblemErrorCount}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton
                        IsChecked="{Binding Output.ShowWarnings, Mode=TwoWay}"
                        Style="{StaticResource ShellCounterToggleStyle}"
                        ToolTip="{DynamicResource Str.Shell.Problems.ShowWarnings}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                FontSize="12"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Symbol="Warning24" />
                            <TextBlock
                                Margin="3,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Output.ProblemWarningCount}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton
                        IsChecked="{Binding Output.ShowInfos, Mode=TwoWay}"
                        Style="{StaticResource ShellCounterToggleStyle}"
                        ToolTip="{DynamicResource Str.Shell.Problems.ShowInfo}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="12" Symbol="Info24" />
                            <TextBlock
                                Margin="3,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Output.ProblemInfoCount}" />
                        </StackPanel>
                    </ToggleButton>
                    <ui:Button
                        Click="OnSourcesClick"
                        Icon="{ui:SymbolIcon Filter24}"
                        Style="{StaticResource ShellCompactIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Problems.FilterSources}">
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Header="{DynamicResource Str.Shell.Output.GroupParser}"
                                    IsCheckable="True"
                                    IsChecked="{Binding Output.ShowParserEntries, Mode=TwoWay}" />
                                <MenuItem
                                    Header="{DynamicResource Str.Shell.Output.GroupBuild}"
                                    IsCheckable="True"
                                    IsChecked="{Binding Output.ShowBuildEntries, Mode=TwoWay}" />
                                <MenuItem
                                    Header="{DynamicResource Str.Shell.Output.GroupTools}"
                                    IsCheckable="True"
                                    IsChecked="{Binding Output.ShowToolEntries, Mode=TwoWay}" />
                                <MenuItem
                                    Header="{DynamicResource Str.Shell.Output.GroupFiles}"
                                    IsCheckable="True"
                                    IsChecked="{Binding Output.ShowFileEntries, Mode=TwoWay}" />
                                <MenuItem
                                    Header="{DynamicResource Str.Shell.Output.GroupSettings}"
                                    IsCheckable="True"
                                    IsChecked="{Binding Output.ShowSettingsEntries, Mode=TwoWay}" />
                                <MenuItem
                                    Header="{DynamicResource Str.Shell.Output.GroupMessages}"
                                    IsCheckable="True"
                                    IsChecked="{Binding Output.ShowMessageEntries, Mode=TwoWay}" />
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                    <ui:Button
                        Command="{Binding Output.PreviousProblemCommand}"
                        Icon="{ui:SymbolIcon ArrowUp24}"
                        Style="{StaticResource ShellCompactIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Problems.Previous}" />
                    <ui:Button
                        Command="{Binding Output.NextProblemCommand}"
                        Icon="{ui:SymbolIcon ArrowDown24}"
                        Style="{StaticResource ShellCompactIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Problems.Next}" />
                    <ui:Button
                        Command="{Binding Output.CopyAllCommand}"
                        Icon="{ui:SymbolIcon Copy24}"
                        Style="{StaticResource ShellCompactIconButtonStyle}"
                        ToolTip="{DynamicResource Str.Shell.Problems.CopyAll}" />
                </StackPanel>
                <ui:Button
                    Command="{Binding Output.RefreshCommand}"
                    Icon="{ui:SymbolIcon ArrowSync24}"
                    Style="{StaticResource ShellCompactIconButtonStyle}"
                    ToolTip="{DynamicResource Str.Shell.Output.Refresh}" />
                <ui:Button
                    Command="{Binding Output.ClearAllCommand}"
                    Icon="{ui:SymbolIcon Delete24}"
                    Style="{StaticResource ShellCompactIconButtonStyle}"
                    ToolTip="{DynamicResource Str.Shell.Output.ClearAll}" />
                <ui:Button
                    x:Name="MinimizeButton"
                    Command="{Binding ToggleOutputMinimizedCommand}"
                    Icon="{ui:SymbolIcon ChevronDown24}"
                    Style="{StaticResource ShellCompactIconButtonStyle}"
                    ToolTip="{DynamicResource Str.Shell.Output.Minimize}" />
            </StackPanel>
        </Grid>
    </Border>

</UserControl>