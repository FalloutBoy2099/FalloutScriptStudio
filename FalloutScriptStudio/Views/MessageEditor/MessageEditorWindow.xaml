<ui:FluentWindow FontSize="12" x:Class="FalloutScriptStudio.Views.MessageEditor.MessageEditorWindow"
				 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
				 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
				 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
				 xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
				 xmlns:vm="clr-namespace:FalloutScriptStudio.ViewModels.MessageEditor"
				 mc:Ignorable="d"
				 d:DataContext="{d:DesignInstance Type=vm:MessageEditorViewModel}"
				 Title="{Binding WindowTitle}"
				 Width="980" Height="640" MinWidth="620" MinHeight="340"
				 Icon="/FalloutScriptStudio;component/Assets/Icons/icon_msg.ico"
				 ExtendsContentIntoTitleBar="True"
				 WindowBackdropType="Mica"
				 WindowStartupLocation="CenterScreen">

	<ui:FluentWindow.InputBindings>
		<KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
		<KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
		<KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
		<KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
		<KeyBinding Gesture="F5" Command="{Binding ReloadCommand}" />
		<KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
		<KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
		<KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
		<KeyBinding Gesture="Alt+A" Command="{Binding AddNextLineCommand}" />
		<KeyBinding Gesture="Alt+C" Command="{Binding InsertCommentCommand}" />
		<KeyBinding Gesture="Alt+O" Command="{Binding TogglePlayerLineCommand}" />
		<KeyBinding Gesture="Alt+S" Command="{Binding SendLineCommand}" />
		<KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateRowsCommand}" />
		<KeyBinding Gesture="F3" Command="{Binding FindNextCommand}" />
		<KeyBinding Gesture="Shift+F3" Command="{Binding FindPreviousCommand}" />
		<KeyBinding Gesture="F8" Command="{Binding GoToNextIssueCommand}" />
		<KeyBinding Gesture="Shift+F8" Command="{Binding GoToPreviousIssueCommand}" />
		<KeyBinding Gesture="Ctrl+Add" Command="{Binding IncreaseFontSizeCommand}" />
		<KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding IncreaseFontSizeCommand}" />
		<KeyBinding Gesture="Ctrl+Subtract" Command="{Binding DecreaseFontSizeCommand}" />
		<KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding DecreaseFontSizeCommand}" />
	</ui:FluentWindow.InputBindings>

	<ui:FluentWindow.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />

		<!-- These brushes are replaced from code when the theme or the comment color option changes. -->
		<SolidColorBrush x:Key="MessageCommentRowBrush" Color="#FFFFC8" />
		<SolidColorBrush x:Key="MessageLineColumnBrush" Color="#FFFFE0" />
		<SolidColorBrush x:Key="MessageLineForegroundBrush" Color="#D2691E" />
		<SolidColorBrush x:Key="MessageSearchMatchBrush" Color="#66FFD54F" />

		<Style x:Key="ToolButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
			<Setter Property="Appearance" Value="Transparent" />
			<Setter Property="MinWidth" Value="34" />
			<Setter Property="Height" Value="34" />
			<Setter Property="Padding" Value="8,0" />
			<Setter Property="Margin" Value="1,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style x:Key="ToolDivider" TargetType="Border">
			<Setter Property="Width" Value="1" />
			<Setter Property="Height" Value="20" />
			<Setter Property="Margin" Value="6,0" />
			<Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!-- The WPF-UI grid templates ignore the Background of rows and cells, so these templates honour it. -->
		<ControlTemplate x:Key="MessageRowTemplate" TargetType="DataGridRow">
			<Border x:Name="RowBackground" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
				<Border x:Name="RowOverlay" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}">
					<SelectiveScrollingGrid>
						<SelectiveScrollingGrid.RowDefinitions>
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</SelectiveScrollingGrid.RowDefinitions>
						<DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
						<Rectangle x:Name="ActiveRectangle" Width="3" Height="18" RadiusX="2" RadiusY="2" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
								   Fill="{DynamicResource ListViewItemPillFillBrush}" Visibility="Collapsed" />
					</SelectiveScrollingGrid>
				</Border>
			</Border>
			<ControlTemplate.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter TargetName="RowOverlay" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
				</Trigger>
				<Trigger Property="IsSelected" Value="True">
					<Setter TargetName="RowOverlay" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
					<Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
				</Trigger>
			</ControlTemplate.Triggers>
		</ControlTemplate>

		<ControlTemplate x:Key="MessageCellTemplate" TargetType="DataGridCell">
			<Border x:Name="CellBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3"
					Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
				<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
			</Border>
			<ControlTemplate.Triggers>
				<Trigger Property="IsKeyboardFocusWithin" Value="True">
					<Setter TargetName="CellBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
				</Trigger>
			</ControlTemplate.Triggers>
		</ControlTemplate>

		<Style x:Key="MessageCell" TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
			<Setter Property="Template" Value="{StaticResource MessageCellTemplate}" />
			<Setter Property="Padding" Value="4,0" />
			<Setter Property="MinHeight" Value="32" />
		</Style>

		<Style x:Key="LineColumnCell" TargetType="DataGridCell" BasedOn="{StaticResource MessageCell}">
			<Setter Property="Background" Value="{DynamicResource MessageLineColumnBrush}" />
		</Style>

		<Style x:Key="MessageRow" TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
			<Setter Property="Template" Value="{StaticResource MessageRowTemplate}" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
					<Setter Property="Background" Value="{DynamicResource MessageSearchMatchBrush}" />
				</DataTrigger>
				<MultiDataTrigger>
					<MultiDataTrigger.Conditions>
						<Condition Binding="{Binding IsComment}" Value="True" />
						<Condition Binding="{Binding DataContext.HighlightComments, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
					</MultiDataTrigger.Conditions>
					<Setter Property="Background" Value="{DynamicResource MessageCommentRowBrush}" />
				</MultiDataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="LineCell" TargetType="TextBlock">
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="{DynamicResource MessageLineForegroundBrush}" />
			<Setter Property="FontSize" Value="{Binding DataContext.LineFontSize, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsLineChanged}" Value="True">
					<Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="LineCellEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
			<Setter Property="TextAlignment" Value="Center" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Padding" Value="2,4" />
			<Setter Property="FontSize" Value="{Binding DataContext.LineFontSize, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
		</Style>

		<Style x:Key="TextCell" TargetType="TextBlock">
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="6,6" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsPlayerLine}" Value="True">
					<Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsTextChanged}" Value="True">
					<Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="CommentCell" TargetType="TextBlock">
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="6,6" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsCommentChanged}" Value="True">
					<Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SoundCell" TargetType="TextBlock">
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="6,6" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsSoundChanged}" Value="True">
					<Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="WrappingEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="AcceptsReturn" Value="False" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Padding" Value="6,4" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<EventSetter Event="PreviewKeyDown" Handler="OnCellEditorPreviewKeyDown" />
		</Style>

		<Style x:Key="IssueIcon" TargetType="ui:SymbolIcon">
			<Setter Property="Visibility" Value="Collapsed" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontSize" Value="16" />
			<Setter Property="ToolTip" Value="{Binding IssueText}" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:MessageIssueSeverity.Error}">
					<Setter Property="Visibility" Value="Visible" />
					<Setter Property="Symbol" Value="ErrorCircle24" />
					<Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:MessageIssueSeverity.Warning}">
					<Setter Property="Visibility" Value="Visible" />
					<Setter Property="Symbol" Value="Warning24" />
					<Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:MessageIssueSeverity.Hint}">
					<Setter Property="Visibility" Value="Visible" />
					<Setter Property="Symbol" Value="Info24" />
					<Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<ContextMenu x:Key="RowMenu">
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.SendLine}" InputGestureText="MMB / Alt+S" Command="{Binding SendLineCommand}" ToolTip="{DynamicResource Str.MessageEditor.Menu.SendLineTip}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="Send24" />
				</MenuItem.Icon>
			</MenuItem>
			<Separator />
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.SetPlayerMarker}" InputGestureText="Alt+O" Command="{Binding TogglePlayerLineCommand}" ToolTip="{DynamicResource Str.MessageEditor.Menu.SetPlayerMarkerTip}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="PersonChat24" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.EditComment}" Command="{Binding EditCommentCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="CommentEdit24" />
				</MenuItem.Icon>
			</MenuItem>
			<Separator />
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.AddNext}" InputGestureText="Alt+A" Command="{Binding AddNextLineCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="Add24" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.InsertComment}" InputGestureText="Alt+C" Command="{Binding InsertCommentCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="CommentAdd24" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.InsertBlankBelow}" InputGestureText="Ctrl+Enter" Command="{Binding InsertBlankBelowCommand}" />
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.InsertBlankAbove}" InputGestureText="Shift+Enter" Command="{Binding InsertBlankAboveCommand}" />
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.Duplicate}" InputGestureText="Ctrl+D" Command="{Binding DuplicateRowsCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="CopyAdd24" />
				</MenuItem.Icon>
			</MenuItem>
			<Separator />
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.MoveUp}" InputGestureText="Ctrl+Up" Command="{Binding MoveUpCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="ArrowUp24" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.MoveDown}" InputGestureText="Ctrl+Down" Command="{Binding MoveDownCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="ArrowDown24" />
				</MenuItem.Icon>
			</MenuItem>
			<Separator />
			<MenuItem Header="{DynamicResource Str.Common.Delete}" InputGestureText="Ctrl+Delete" Command="{Binding DeleteRowsCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="Delete24" />
				</MenuItem.Icon>
			</MenuItem>
		</ContextMenu>

		<ContextMenu x:Key="OptionsMenu">
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.WindowOnTop}" IsCheckable="True" IsChecked="{Binding IsWindowOnTop, Mode=TwoWay}" IsEnabled="{Binding HasTarget}" ToolTip="{DynamicResource Str.MessageEditor.Menu.WindowOnTopTip}" />
			<Separator />
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.HighlightComments}" IsCheckable="True" IsChecked="{Binding HighlightComments, Mode=TwoWay}" ToolTip="{DynamicResource Str.MessageEditor.Menu.HighlightCommentsTip}" />
			<MenuItem Tag="colors" Header="{DynamicResource Str.MessageEditor.Menu.CommentColor}" />
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.ShowLip}" IsCheckable="True" IsChecked="{Binding ShowLipColumn, Mode=TwoWay}" ToolTip="{DynamicResource Str.MessageEditor.Menu.ShowLipTip}" />
			<MenuItem Tag="fonts" Header="{DynamicResource Str.MessageEditor.Menu.FontSize}" ToolTip="{DynamicResource Str.MessageEditor.Menu.FontSizeTip}" />
			<Separator />
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.EncodingOem866}" IsCheckable="True" IsChecked="{Binding UseOem866, Mode=TwoWay}" ToolTip="{DynamicResource Str.MessageEditor.Menu.EncodingOem866Tip}" />
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.ShowDetails}" IsCheckable="True" IsChecked="{Binding IsDetailsVisible, Mode=TwoWay}" ToolTip="{DynamicResource Str.MessageEditor.Menu.ShowDetailsTip}" />
		</ContextMenu>

		<ContextMenu x:Key="OpenWithMenu">
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.OpenExternal}" Command="{Binding OpenInExternalEditorCommand}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="Open24" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Header="{DynamicResource Str.MessageEditor.Menu.OpenAsText}" Command="{Binding OpenAsTextCommand}" ToolTip="{DynamicResource Str.MessageEditor.Menu.OpenAsTextTip}">
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="DocumentText24" />
				</MenuItem.Icon>
			</MenuItem>
		</ContextMenu>
	</ui:FluentWindow.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="{Binding WindowTitle}" ShowMaximize="True" ShowMinimize="True">
			<ui:TitleBar.Icon>
				<ui:ImageIcon Source="/FalloutScriptStudio;component/Assets/Icons/icon_msg.ico" />
			</ui:TitleBar.Icon>
		</ui:TitleBar>

		<!-- Toolbar. -->
		<Border Grid.Row="1" Padding="8,2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
			<WrapPanel Orientation="Horizontal">
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding NewCommand}" ToolTip="{DynamicResource Str.MessageEditor.Tip.New}" Icon="{ui:SymbolIcon DocumentAdd24}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding OpenCommand}" ToolTip="{DynamicResource Str.MessageEditor.Tip.Open}" Icon="{ui:SymbolIcon FolderOpen24}" />
				<ui:Button x:Name="RecentButton" Style="{StaticResource ToolButton}" MinWidth="24" Padding="4,0" ToolTip="{DynamicResource Str.MessageEditor.Tip.Recent}"
						   Icon="{ui:SymbolIcon ChevronDown24}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}" ToolTip="{DynamicResource Str.MessageEditor.Tip.Save}" Icon="{ui:SymbolIcon Save24}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding SaveAsCommand}" ToolTip="{DynamicResource Str.MessageEditor.Tip.SaveAs}" Icon="{ui:SymbolIcon SaveCopy24}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding ReloadCommand}" ToolTip="{DynamicResource Str.MessageEditor.Tip.Reload}" Icon="{ui:SymbolIcon ArrowSync24}" />
				<Border Style="{StaticResource ToolDivider}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding UndoCommand}" ToolTip="{DynamicResource Str.MessageEditor.Tip.Undo}" Icon="{ui:SymbolIcon ArrowUndo24}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding RedoCommand}" ToolTip="{DynamicResource Str.MessageEditor.Tip.Redo}" Icon="{ui:SymbolIcon ArrowRedo24}" />
				<Border Style="{StaticResource ToolDivider}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding AddNextLineCommand}" ToolTip="{DynamicResource Str.MessageEditor.Tip.AddNext}" Icon="{ui:SymbolIcon Add24}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding InsertBlankBelowCommand}"
						   ToolTip="{DynamicResource Str.MessageEditor.Tip.InsertBlank}" Icon="{ui:SymbolIcon TextAddSpaceAfter24}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding InsertCommentCommand}" ToolTip="{DynamicResource Str.MessageEditor.Tip.InsertComment}" Icon="{ui:SymbolIcon CommentAdd24}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding DuplicateRowsCommand}" ToolTip="{DynamicResource Str.MessageEditor.Tip.Duplicate}" Icon="{ui:SymbolIcon CopyAdd24}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding DeleteRowsCommand}" ToolTip="{DynamicResource Str.MessageEditor.Tip.Delete}" Icon="{ui:SymbolIcon Delete24}" />
				<Border Style="{StaticResource ToolDivider}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding MoveUpCommand}"
						   ToolTip="{DynamicResource Str.MessageEditor.Tip.MoveUp}" Icon="{ui:SymbolIcon ArrowUp24}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding MoveDownCommand}" ToolTip="{DynamicResource Str.MessageEditor.Tip.MoveDown}" Icon="{ui:SymbolIcon ArrowDown24}" />
				<Border Style="{StaticResource ToolDivider}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding TogglePlayerLineCommand}" ToolTip="{DynamicResource Str.MessageEditor.Tip.PlayerMarker}" Icon="{ui:SymbolIcon PersonChat24}" />
				<ui:Button Style="{StaticResource ToolButton}" Command="{Binding SendLineCommand}"
						   ToolTip="{DynamicResource Str.MessageEditor.Tip.Send}" Icon="{ui:SymbolIcon Send24}" />
				<Border Style="{StaticResource ToolDivider}" />
				<TextBlock Text="{DynamicResource Str.MessageEditor.Label.Step}" VerticalAlignment="Center" Margin="2,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
						   ToolTip="{DynamicResource Str.MessageEditor.Tip.Step}" />
				<ComboBox x:Name="StepBox" Width="68" Height="34" VerticalAlignment="Center" ItemsSource="{Binding CommentSteps}" SelectedItem="{Binding CommentStep, Mode=TwoWay}"
						  ToolTip="{DynamicResource Str.MessageEditor.Tip.Step}" />
				<Border Style="{StaticResource ToolDivider}" />
				<ui:Button x:Name="OpenWithButton" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource Str.MessageEditor.Tip.OpenWith}"
						   Icon="{ui:SymbolIcon DocumentText24}" />
				<ui:Button x:Name="OptionsButton" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource Str.MessageEditor.Tip.Options}" Icon="{ui:SymbolIcon Settings24}" />
			</WrapPanel>
		</Border>

		<!-- Notifications: a refused edit and a file changed by another program. -->
		<StackPanel Grid.Row="2">
			<Border x:Name="NotificationBar" Margin="8,6,8,0" Padding="14,8" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}"
					Background="{DynamicResource InfoBarWarningSeverityBackgroundBrush}" BorderBrush="{DynamicResource InfoBarWarningSeverityBorderBrush}"
					Visibility="{Binding HasNotification, Converter={StaticResource BoolToVisibility}}">
				<DockPanel>
					<ui:Button DockPanel.Dock="Right" Content="{DynamicResource Str.MessageEditor.Btn.Dismiss}" Command="{Binding DismissNotificationCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
					<ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning24" Filled="True" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"
								   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
					<TextBlock Text="{Binding NotificationMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
				</DockPanel>
			</Border>
			<Border x:Name="ExternalChangeBar" Margin="8,6,8,0" Padding="14,8" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}"
					Background="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}" BorderBrush="{DynamicResource InfoBarInformationalSeverityBorderBrush}"
					Visibility="{Binding HasExternalChange, Converter={StaticResource BoolToVisibility}}">
				<DockPanel>
					<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
						<ui:Button Content="{DynamicResource Str.MessageEditor.Btn.Reload}" Command="{Binding ReloadCommand}" Appearance="Primary" Margin="0,0,8,0" />
						<ui:Button Content="{DynamicResource Str.MessageEditor.Btn.KeepMine}" Command="{Binding IgnoreExternalChangeCommand}" />
					</StackPanel>
					<ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"
								   Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
					<TextBlock Text="{Binding ExternalChangeMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
				</DockPanel>
			</Border>
		</StackPanel>

		<!-- The grid with its header line and the optional details pane. -->
		<Grid Grid.Row="3" Margin="8,6,8,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<DockPanel Grid.Row="0" Margin="2,0,2,6">
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
					<ui:TextBox x:Name="SearchBox" Width="220" Height="34" PlaceholderText="{DynamicResource Str.MessageEditor.Search.Placeholder}" ClearButtonEnabled="True"
								Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
								ToolTip="{DynamicResource Str.MessageEditor.Tip.Search}">
						<ui:TextBox.Icon>
							<ui:SymbolIcon Symbol="Search24" />
						</ui:TextBox.Icon>
						<ui:TextBox.InputBindings>
							<KeyBinding Key="Return" Command="{Binding FindNextCommand}" />
							<KeyBinding Key="Return" Modifiers="Shift" Command="{Binding FindPreviousCommand}" />
						</ui:TextBox.InputBindings>
					</ui:TextBox>
					<ui:Button Style="{StaticResource ToolButton}" Command="{Binding FindPreviousCommand}" ToolTip="{DynamicResource Str.MessageEditor.Tip.FindPrevious}" Icon="{ui:SymbolIcon ArrowUp24}" />
					<ui:Button Style="{StaticResource ToolButton}" Command="{Binding FindNextCommand}" ToolTip="{DynamicResource Str.MessageEditor.Tip.FindNext}" Icon="{ui:SymbolIcon ArrowDown24}" />
					<ToggleButton x:Name="FilterToggle" IsChecked="{Binding IsFilterActive}" Width="34" Height="34" Margin="1,0" Padding="0" VerticalAlignment="Center"
								  ToolTip="{DynamicResource Str.MessageEditor.Tip.Filter}">
						<ui:SymbolIcon Symbol="Filter24" />
					</ToggleButton>
				</StackPanel>
				<TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Text="{Binding ScriptCaption}" Margin="12,0"
						   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
				<TextBlock VerticalAlignment="Center" Text="{Binding PathCaption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathCaption}"
						   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
			</DockPanel>

			<ui:DataGrid x:Name="MessageGrid" Grid.Row="1"
						 ItemsSource="{Binding RowsView}"
						 AutoGenerateColumns="False"
						 CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" CanUserResizeRows="False" CanUserSortColumns="False"
						 SelectionMode="Extended" SelectionUnit="FullRow"
						 HeadersVisibility="Column" GridLinesVisibility="Horizontal"
						 RowHeaderWidth="0" ClipboardCopyMode="None" EnableRowVirtualization="True"
						 RowStyle="{StaticResource MessageRow}"
						 CellStyle="{StaticResource MessageCell}"
						 ContextMenu="{StaticResource RowMenu}"
						 FontSize="{Binding FontSize}">
				<ui:DataGrid.Columns>
					<DataGridTemplateColumn x:Name="IssueColumn" Header="" Width="30" CanUserResize="False" IsReadOnly="True">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<ui:SymbolIcon Style="{StaticResource IssueIcon}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTextColumn x:Name="LineColumn" Header="" Width="54" CanUserResize="False"
										Binding="{Binding LineText, UpdateSourceTrigger=LostFocus}"
										CellStyle="{StaticResource LineColumnCell}"
										ElementStyle="{StaticResource LineCell}" EditingElementStyle="{StaticResource LineCellEditor}" />
					<DataGridTemplateColumn x:Name="PlayerColumn" Header="" Width="46" CanUserResize="False" IsReadOnly="True">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<CheckBox IsChecked="{Binding IsPlayerLine}" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0" Margin="10,0,0,0"
										  Visibility="{Binding IsMessage, Converter={StaticResource BoolToVisibility}}"
										  ToolTip="{DynamicResource Str.MessageEditor.Tip.PlayerCheck}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTextColumn x:Name="TextColumn" Header="" Width="*"
										Binding="{Binding Text, UpdateSourceTrigger=LostFocus}"
										ElementStyle="{StaticResource TextCell}" EditingElementStyle="{StaticResource WrappingEditor}" />
					<DataGridTextColumn x:Name="CommentColumn" Header="" Width="190"
										Binding="{Binding Comment, UpdateSourceTrigger=LostFocus}"
										ElementStyle="{StaticResource CommentCell}" EditingElementStyle="{StaticResource WrappingEditor}" />
					<DataGridTextColumn x:Name="SoundColumn" Header="" Width="110"
										Binding="{Binding SoundName, UpdateSourceTrigger=LostFocus}"
										ElementStyle="{StaticResource SoundCell}" EditingElementStyle="{StaticResource WrappingEditor}" />
				</ui:DataGrid.Columns>
			</ui:DataGrid>

			<Border x:Name="DetailsPane" Grid.Row="2" Height="150" Margin="0,8,0,0" CornerRadius="4"
					Visibility="{Binding IsDetailsVisible, Converter={StaticResource BoolToVisibility}}"
					BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
				<DockPanel>
					<TextBlock x:Name="DetailsCaption" DockPanel.Dock="Top" Margin="8,4" Text="{DynamicResource Str.MessageEditor.Details.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
					<ae:TextEditor x:Name="DetailsEditor" WordWrap="True" ShowLineNumbers="False" Padding="6,2"
								   HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" />
				</DockPanel>
			</Border>
		</Grid>

		<!-- Status bar. -->
		<Border Grid.Row="4" Padding="12,5" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<DockPanel Grid.Column="0">
					<ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
									 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
					<TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
				</DockPanel>
				<TextBlock Grid.Column="1" Text="{Binding SearchStatus}" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
				<ui:HyperlinkButton Grid.Column="2" Content="{Binding IssueSummary}" Command="{Binding GoToNextIssueCommand}" Padding="4,0" Margin="12,0,0,0"
									ToolTip="{DynamicResource Str.MessageEditor.Tip.NextIssue}" />
				<TextBlock Grid.Column="3" Text="{Binding MessageCountCaption}" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
				<TextBlock Grid.Column="4" Text="{Binding EncodingName}" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
			</Grid>
		</Border>
	</Grid>
</ui:FluentWindow>
