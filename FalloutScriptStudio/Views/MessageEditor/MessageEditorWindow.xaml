<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.MessageEditor.MessageEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:FalloutScriptStudio.ViewModels.MessageEditor"
    Title="{Binding WindowTitle}"
    Width="980"
    Height="640"
    MinWidth="620"
    MinHeight="340"
    d:DataContext="{d:DesignInstance Type=vm:MessageEditorViewModel}"
    ExtendsContentIntoTitleBar="True"
    FontSize="12"
    Icon="/FalloutScriptStudio;component/Assets/Icons/icon_msg.ico"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Command="{Binding NewCommand}" Gesture="Ctrl+N" />
        <KeyBinding Command="{Binding OpenCommand}" Gesture="Ctrl+O" />
        <KeyBinding Command="{Binding SaveCommand}" Gesture="Ctrl+S" />
        <KeyBinding Command="{Binding SaveAsCommand}" Gesture="Ctrl+Shift+S" />
        <KeyBinding Command="{Binding ReloadCommand}" Gesture="F5" />
        <KeyBinding Command="{Binding UndoCommand}" Gesture="Ctrl+Z" />
        <KeyBinding Command="{Binding RedoCommand}" Gesture="Ctrl+Y" />
        <KeyBinding Command="{Binding RedoCommand}" Gesture="Ctrl+Shift+Z" />
        <KeyBinding Command="{Binding AddNextLineCommand}" Gesture="Alt+A" />
        <KeyBinding Command="{Binding InsertCommentCommand}" Gesture="Alt+C" />
        <KeyBinding Command="{Binding TogglePlayerLineCommand}" Gesture="Alt+O" />
        <KeyBinding Command="{Binding SendLineCommand}" Gesture="Alt+S" />
        <KeyBinding Command="{Binding DuplicateRowsCommand}" Gesture="Ctrl+D" />
        <KeyBinding Command="{Binding FindNextCommand}" Gesture="F3" />
        <KeyBinding Command="{Binding FindPreviousCommand}" Gesture="Shift+F3" />
        <KeyBinding Command="{Binding GoToNextIssueCommand}" Gesture="F8" />
        <KeyBinding Command="{Binding GoToPreviousIssueCommand}" Gesture="Shift+F8" />
        <KeyBinding Command="{Binding IncreaseFontSizeCommand}" Gesture="Ctrl+Add" />
        <KeyBinding Command="{Binding IncreaseFontSizeCommand}" Gesture="Ctrl+OemPlus" />
        <KeyBinding Command="{Binding DecreaseFontSizeCommand}" Gesture="Ctrl+Subtract" />
        <KeyBinding Command="{Binding DecreaseFontSizeCommand}" Gesture="Ctrl+OemMinus" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  These brushes are replaced from code when the theme or the comment color option changes.  -->
        <SolidColorBrush x:Key="MessageCommentRowBrush" Color="#FFFFC8" />
        <SolidColorBrush x:Key="MessageLineColumnBrush" Color="#FFFFE0" />
        <SolidColorBrush x:Key="MessageLineForegroundBrush" Color="#D2691E" />
        <SolidColorBrush x:Key="MessageSearchMatchBrush" Color="#66FFD54F" />

        <Style
            x:Key="ToolButton"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  The WPF-UI grid templates ignore the Background of rows and cells, so these templates honour it.  -->
        <ControlTemplate x:Key="MessageRowTemplate" TargetType="DataGridRow">
            <Border
                x:Name="RowBackground"
                Background="{TemplateBinding Background}"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                SnapsToDevicePixels="True">
                <Border
                    x:Name="RowOverlay"
                    Background="Transparent"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                    <SelectiveScrollingGrid>
                        <SelectiveScrollingGrid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </SelectiveScrollingGrid.RowDefinitions>
                        <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        <Rectangle
                            x:Name="ActiveRectangle"
                            Width="3"
                            Height="18"
                            Margin="2,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource ListViewItemPillFillBrush}"
                            RadiusX="2"
                            RadiusY="2"
                            Visibility="Collapsed" />
                    </SelectiveScrollingGrid>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowOverlay" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="RowOverlay" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                    <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="MessageCellTemplate" TargetType="DataGridCell">
            <Border
                x:Name="CellBorder"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="3"
                SnapsToDevicePixels="True">
                <ContentPresenter
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="CellBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style
            x:Key="MessageCell"
            BasedOn="{StaticResource DefaultDataGridCellStyle}"
            TargetType="DataGridCell">
            <Setter Property="Template" Value="{StaticResource MessageCellTemplate}" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style
            x:Key="LineColumnCell"
            BasedOn="{StaticResource MessageCell}"
            TargetType="DataGridCell">
            <Setter Property="Background" Value="{DynamicResource MessageLineColumnBrush}" />
        </Style>

        <Style
            x:Key="MessageRow"
            BasedOn="{StaticResource DefaultDataGridRowStyle}"
            TargetType="DataGridRow">
            <Setter Property="Template" Value="{StaticResource MessageRowTemplate}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MessageSearchMatchBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsComment}" Value="True" />
                        <Condition Binding="{Binding DataContext.HighlightComments, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource MessageCommentRowBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LineCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource MessageLineForegroundBrush}" />
            <Setter Property="FontSize" Value="{Binding DataContext.LineFontSize, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLineChanged}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="LineCellEditor"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="2,4" />
            <Setter Property="FontSize" Value="{Binding DataContext.LineFontSize, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
        </Style>

        <Style x:Key="TextCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlayerLine}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTextChanged}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CommentCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCommentChanged}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SoundCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSoundChanged}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="WrappingEditor"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="TextBox">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <EventSetter Event="PreviewKeyDown" Handler="OnCellEditorPreviewKeyDown" />
        </Style>

        <Style x:Key="IssueIcon" TargetType="ui:SymbolIcon">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="ToolTip" Value="{Binding IssueText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:MessageIssueSeverity.Error}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Symbol" Value="ErrorCircle24" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:MessageIssueSeverity.Warning}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Symbol" Value="Warning24" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:MessageIssueSeverity.Hint}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Symbol" Value="Info24" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="RowMenu">
            <MenuItem
                Command="{Binding SendLineCommand}"
                Header="{DynamicResource Str.MessageEditor.Menu.SendLine}"
                InputGestureText="MMB / Alt+S"
                ToolTip="{DynamicResource Str.MessageEditor.Menu.SendLineTip}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Send24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding TogglePlayerLineCommand}"
                Header="{DynamicResource Str.MessageEditor.Menu.SetPlayerMarker}"
                InputGestureText="Alt+O"
                ToolTip="{DynamicResource Str.MessageEditor.Menu.SetPlayerMarkerTip}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="PersonChat24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding EditCommentCommand}" Header="{DynamicResource Str.MessageEditor.Menu.EditComment}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="CommentEdit24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding AddNextLineCommand}"
                Header="{DynamicResource Str.MessageEditor.Menu.AddNext}"
                InputGestureText="Alt+A">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Add24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding InsertCommentCommand}"
                Header="{DynamicResource Str.MessageEditor.Menu.InsertComment}"
                InputGestureText="Alt+C">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="CommentAdd24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding InsertBlankBelowCommand}"
                Header="{DynamicResource Str.MessageEditor.Menu.InsertBlankBelow}"
                InputGestureText="Ctrl+Enter" />
            <MenuItem
                Command="{Binding InsertBlankAboveCommand}"
                Header="{DynamicResource Str.MessageEditor.Menu.InsertBlankAbove}"
                InputGestureText="Shift+Enter" />
            <MenuItem
                Command="{Binding DuplicateRowsCommand}"
                Header="{DynamicResource Str.MessageEditor.Menu.Duplicate}"
                InputGestureText="Ctrl+D">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="CopyAdd24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding MoveUpCommand}"
                Header="{DynamicResource Str.MessageEditor.Menu.MoveUp}"
                InputGestureText="Ctrl+Up">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowUp24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding MoveDownCommand}"
                Header="{DynamicResource Str.MessageEditor.Menu.MoveDown}"
                InputGestureText="Ctrl+Down">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowDown24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding DeleteRowsCommand}"
                Header="{DynamicResource Str.Common.Delete}"
                InputGestureText="Ctrl+Delete">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="OptionsMenu">
            <MenuItem
                Header="{DynamicResource Str.MessageEditor.Menu.WindowOnTop}"
                IsCheckable="True"
                IsChecked="{Binding IsWindowOnTop, Mode=TwoWay}"
                IsEnabled="{Binding HasTarget}"
                ToolTip="{DynamicResource Str.MessageEditor.Menu.WindowOnTopTip}" />
            <Separator />
            <MenuItem
                Header="{DynamicResource Str.MessageEditor.Menu.HighlightComments}"
                IsCheckable="True"
                IsChecked="{Binding HighlightComments, Mode=TwoWay}"
                ToolTip="{DynamicResource Str.MessageEditor.Menu.HighlightCommentsTip}" />
            <MenuItem Header="{DynamicResource Str.MessageEditor.Menu.CommentColor}" Tag="colors" />
            <MenuItem
                Header="{DynamicResource Str.MessageEditor.Menu.ShowLip}"
                IsCheckable="True"
                IsChecked="{Binding ShowLipColumn, Mode=TwoWay}"
                ToolTip="{DynamicResource Str.MessageEditor.Menu.ShowLipTip}" />
            <MenuItem
                Header="{DynamicResource Str.MessageEditor.Menu.FontSize}"
                Tag="fonts"
                ToolTip="{DynamicResource Str.MessageEditor.Menu.FontSizeTip}" />
            <Separator />
            <MenuItem
                Header="{DynamicResource Str.MessageEditor.Menu.EncodingOem866}"
                IsCheckable="True"
                IsChecked="{Binding UseOem866, Mode=TwoWay}"
                ToolTip="{DynamicResource Str.MessageEditor.Menu.EncodingOem866Tip}" />
            <MenuItem
                Header="{DynamicResource Str.MessageEditor.Menu.ShowDetails}"
                IsCheckable="True"
                IsChecked="{Binding IsDetailsVisible, Mode=TwoWay}"
                ToolTip="{DynamicResource Str.MessageEditor.Menu.ShowDetailsTip}" />
        </ContextMenu>

        <ContextMenu x:Key="OpenWithMenu">
            <MenuItem Command="{Binding OpenInExternalEditorCommand}" Header="{DynamicResource Str.MessageEditor.Menu.OpenExternal}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Open24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding OpenAsTextCommand}"
                Header="{DynamicResource Str.MessageEditor.Menu.OpenAsText}"
                ToolTip="{DynamicResource Str.MessageEditor.Menu.OpenAsTextTip}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="DocumentText24" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding WindowTitle}"
            Grid.Row="0"
            ShowMaximize="True"
            ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/FalloutScriptStudio;component/Assets/Icons/icon_msg.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--  Toolbar.  -->
        <Border
            Grid.Row="1"
            Padding="8,2"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">
                <ui:Button
                    Command="{Binding NewCommand}"
                    Icon="{ui:SymbolIcon DocumentAdd24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.New}" />
                <ui:Button
                    Command="{Binding OpenCommand}"
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.Open}" />
                <ui:Button
                    x:Name="RecentButton"
                    MinWidth="24"
                    Padding="4,0"
                    Icon="{ui:SymbolIcon ChevronDown24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.Recent}" />
                <ui:Button
                    Command="{Binding SaveCommand}"
                    Icon="{ui:SymbolIcon Save24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.Save}" />
                <ui:Button
                    Command="{Binding SaveAsCommand}"
                    Icon="{ui:SymbolIcon SaveCopy24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.SaveAs}" />
                <ui:Button
                    Command="{Binding ReloadCommand}"
                    Icon="{ui:SymbolIcon ArrowSync24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.Reload}" />
                <Border Style="{StaticResource ToolDivider}" />
                <ui:Button
                    Command="{Binding UndoCommand}"
                    Icon="{ui:SymbolIcon ArrowUndo24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.Undo}" />
                <ui:Button
                    Command="{Binding RedoCommand}"
                    Icon="{ui:SymbolIcon ArrowRedo24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.Redo}" />
                <Border Style="{StaticResource ToolDivider}" />
                <ui:Button
                    Command="{Binding AddNextLineCommand}"
                    Icon="{ui:SymbolIcon Add24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.AddNext}" />
                <ui:Button
                    Command="{Binding InsertBlankBelowCommand}"
                    Icon="{ui:SymbolIcon TextAddSpaceAfter24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.InsertBlank}" />
                <ui:Button
                    Command="{Binding InsertCommentCommand}"
                    Icon="{ui:SymbolIcon CommentAdd24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.InsertComment}" />
                <ui:Button
                    Command="{Binding DuplicateRowsCommand}"
                    Icon="{ui:SymbolIcon CopyAdd24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.Duplicate}" />
                <ui:Button
                    Command="{Binding DeleteRowsCommand}"
                    Icon="{ui:SymbolIcon Delete24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.Delete}" />
                <Border Style="{StaticResource ToolDivider}" />
                <ui:Button
                    Command="{Binding MoveUpCommand}"
                    Icon="{ui:SymbolIcon ArrowUp24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.MoveUp}" />
                <ui:Button
                    Command="{Binding MoveDownCommand}"
                    Icon="{ui:SymbolIcon ArrowDown24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.MoveDown}" />
                <Border Style="{StaticResource ToolDivider}" />
                <ui:Button
                    Command="{Binding TogglePlayerLineCommand}"
                    Icon="{ui:SymbolIcon PersonChat24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.PlayerMarker}" />
                <ui:Button
                    Command="{Binding SendLineCommand}"
                    Icon="{ui:SymbolIcon Send24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.Send}" />
                <Border Style="{StaticResource ToolDivider}" />
                <TextBlock
                    Margin="2,0,4,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource Str.MessageEditor.Label.Step}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.Step}" />
                <ComboBox
                    x:Name="StepBox"
                    Width="68"
                    Height="34"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding CommentSteps}"
                    SelectedItem="{Binding CommentStep, Mode=TwoWay}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.Step}" />
                <Border Style="{StaticResource ToolDivider}" />
                <ui:Button
                    x:Name="OpenWithButton"
                    Icon="{ui:SymbolIcon DocumentText24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.OpenWith}" />
                <ui:Button
                    x:Name="OptionsButton"
                    Icon="{ui:SymbolIcon Settings24}"
                    Style="{StaticResource ToolButton}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.Options}" />
            </WrapPanel>
        </Border>

        <!--  Notifications: a refused edit and a file changed by another program.  -->
        <StackPanel Grid.Row="2">
            <Border
                x:Name="NotificationBar"
                Margin="8,6,8,0"
                Padding="14,8"
                Background="{DynamicResource InfoBarWarningSeverityBackgroundBrush}"
                BorderBrush="{DynamicResource InfoBarWarningSeverityBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Visibility="{Binding HasNotification, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <ui:Button
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding DismissNotificationCommand}"
                        Content="{DynamicResource Str.MessageEditor.Btn.Dismiss}"
                        DockPanel.Dock="Right" />
                    <ui:SymbolIcon
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Filled="True"
                        FontSize="18"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Symbol="Warning24" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding NotificationMessage}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <Border
                x:Name="ExternalChangeBar"
                Margin="8,6,8,0"
                Padding="14,8"
                Background="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}"
                BorderBrush="{DynamicResource InfoBarInformationalSeverityBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Visibility="{Binding HasExternalChange, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Command="{Binding ReloadCommand}"
                            Content="{DynamicResource Str.MessageEditor.Btn.Reload}" />
                        <ui:Button Command="{Binding IgnoreExternalChangeCommand}" Content="{DynamicResource Str.MessageEditor.Btn.KeepMine}" />
                    </StackPanel>
                    <ui:SymbolIcon
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        FontSize="18"
                        Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"
                        Symbol="Info24" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding ExternalChangeMessage}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!--  The grid with its header line and the optional details pane.  -->
        <Grid Grid.Row="3" Margin="8,6,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="2,0,2,6">
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <ui:TextBox
                        x:Name="SearchBox"
                        Width="220"
                        Height="34"
                        ClearButtonEnabled="True"
                        PlaceholderText="{DynamicResource Str.MessageEditor.Search.Placeholder}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{DynamicResource Str.MessageEditor.Tip.Search}">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" />
                        </ui:TextBox.Icon>
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding FindNextCommand}" />
                            <KeyBinding
                                Key="Return"
                                Command="{Binding FindPreviousCommand}"
                                Modifiers="Shift" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <ui:Button
                        Command="{Binding FindPreviousCommand}"
                        Icon="{ui:SymbolIcon ArrowUp24}"
                        Style="{StaticResource ToolButton}"
                        ToolTip="{DynamicResource Str.MessageEditor.Tip.FindPrevious}" />
                    <ui:Button
                        Command="{Binding FindNextCommand}"
                        Icon="{ui:SymbolIcon ArrowDown24}"
                        Style="{StaticResource ToolButton}"
                        ToolTip="{DynamicResource Str.MessageEditor.Tip.FindNext}" />
                    <ToggleButton
                        x:Name="FilterToggle"
                        Width="34"
                        Height="34"
                        Margin="1,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsFilterActive}"
                        ToolTip="{DynamicResource Str.MessageEditor.Tip.Filter}">
                        <ui:SymbolIcon Symbol="Filter24" />
                    </ToggleButton>
                </StackPanel>
                <TextBlock
                    Margin="12,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ScriptCaption}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding PathCaption}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding PathCaption}" />
            </DockPanel>

            <ui:DataGrid
                x:Name="MessageGrid"
                Grid.Row="1"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="True"
                CanUserResizeRows="False"
                CanUserSortColumns="False"
                CellStyle="{StaticResource MessageCell}"
                ClipboardCopyMode="None"
                ContextMenu="{StaticResource RowMenu}"
                EnableRowVirtualization="True"
                FontSize="{Binding FontSize}"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                ItemsSource="{Binding RowsView}"
                RowHeaderWidth="0"
                RowStyle="{StaticResource MessageRow}"
                SelectionMode="Extended"
                SelectionUnit="FullRow">
                <ui:DataGrid.Columns>
                    <DataGridTemplateColumn
                        x:Name="IssueColumn"
                        Width="30"
                        CanUserResize="False"
                        Header=""
                        IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:SymbolIcon Style="{StaticResource IssueIcon}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        x:Name="LineColumn"
                        Width="54"
                        Binding="{Binding LineText, UpdateSourceTrigger=LostFocus}"
                        CanUserResize="False"
                        CellStyle="{StaticResource LineColumnCell}"
                        EditingElementStyle="{StaticResource LineCellEditor}"
                        ElementStyle="{StaticResource LineCell}"
                        Header="" />
                    <DataGridTemplateColumn
                        x:Name="PlayerColumn"
                        Width="46"
                        CanUserResize="False"
                        Header=""
                        IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    MinWidth="0"
                                    Margin="10,0,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsPlayerLine}"
                                    ToolTip="{DynamicResource Str.MessageEditor.Tip.PlayerCheck}"
                                    Visibility="{Binding IsMessage, Converter={StaticResource BoolToVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        x:Name="TextColumn"
                        Width="*"
                        Binding="{Binding Text, UpdateSourceTrigger=LostFocus}"
                        EditingElementStyle="{StaticResource WrappingEditor}"
                        ElementStyle="{StaticResource TextCell}"
                        Header="" />
                    <DataGridTextColumn
                        x:Name="CommentColumn"
                        Width="190"
                        Binding="{Binding Comment, UpdateSourceTrigger=LostFocus}"
                        EditingElementStyle="{StaticResource WrappingEditor}"
                        ElementStyle="{StaticResource CommentCell}"
                        Header="" />
                    <DataGridTextColumn
                        x:Name="SoundColumn"
                        Width="110"
                        Binding="{Binding SoundName, UpdateSourceTrigger=LostFocus}"
                        EditingElementStyle="{StaticResource WrappingEditor}"
                        ElementStyle="{StaticResource SoundCell}"
                        Header="" />
                </ui:DataGrid.Columns>
            </ui:DataGrid>

            <Border
                x:Name="DetailsPane"
                Grid.Row="2"
                Height="150"
                Margin="0,8,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding IsDetailsVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock
                        x:Name="DetailsCaption"
                        Margin="8,4"
                        DockPanel.Dock="Top"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Str.MessageEditor.Details.Caption}" />
                    <ae:TextEditor
                        x:Name="DetailsEditor"
                        Padding="6,2"
                        HorizontalScrollBarVisibility="Disabled"
                        ShowLineNumbers="False"
                        VerticalScrollBarVisibility="Auto"
                        WordWrap="True" />
                </DockPanel>
            </Border>
        </Grid>

        <!--  Status bar.  -->
        <Border
            Grid.Row="4"
            Padding="12,5"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                    <ui:ProgressRing
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding StatusMessage}"
                        TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding SearchStatus}" />
                <ui:HyperlinkButton
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    Padding="4,0"
                    Command="{Binding GoToNextIssueCommand}"
                    Content="{Binding IssueSummary}"
                    ToolTip="{DynamicResource Str.MessageEditor.Tip.NextIssue}" />
                <TextBlock
                    Grid.Column="3"
                    Margin="12,0,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding MessageCountCaption}" />
                <TextBlock
                    Grid.Column="4"
                    Margin="12,0,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding EncodingName}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
