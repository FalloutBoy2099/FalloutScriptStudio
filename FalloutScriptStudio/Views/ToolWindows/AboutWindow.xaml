<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.ToolWindows.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Str.ToolWindows.About.WindowTitle}"
    Width="600"
    Height="700"
    MinWidth="480"
    MinHeight="460"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{DynamicResource Str.Common.About}"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/FalloutScriptStudio;component/Assets/Icons/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,8,28,16">
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="64"
                        Height="64"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="pack://application:,,,/FalloutScriptStudio;component/Assets/Icons/app_64.png" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="{Binding ProductName}" />
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Version}" />
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding AuthorLine}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    Margin="0,16,0,0"
                    Text="{Binding Description}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding OriginalWork}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Copyright}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Margin="0,20,0,8"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{DynamicResource Str.ToolWindows.About.Credits}" />
                <ItemsControl ItemsSource="{Binding Credits}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Margin="0,16,0,8"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{DynamicResource Str.ToolWindows.About.License}" />
                <TextBox
                    MaxHeight="190"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    Text="{Binding License, Mode=OneWay}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />

                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Links}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:HyperlinkButton
                                Margin="0,0,12,0"
                                Content="{Binding Title}"
                                NavigateUri="{Binding Url.AbsoluteUri}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="28,0,28,16"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                MinWidth="96"
                Appearance="Primary"
                Command="{Binding CloseCommand}"
                Content="{DynamicResource Str.Common.Ok}"
                IsCancel="True"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
