<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.ToolWindows.BatchCompileWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a11y="clr-namespace:FalloutScriptStudio.Views.Accessibility"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="780"
    Height="620"
    MinWidth="560"
    MinHeight="460"
    a11y:WindowFit.FitToWorkArea="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Closing="OnClosing"
    ExtendsContentIntoTitleBar="True"
    FocusManager.FocusedElement="{Binding ElementName=FailureList}"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{Binding Title}"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="20,8,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{Binding StatusText}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis">
                    <Run Text="{DynamicResource Str.ToolWindows.Batch.LastFinished}" />
                    <Run Text="{Binding CurrentFile, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <ProgressBar
                Grid.Row="1"
                Height="6"
                Margin="0,12,0,0"
                AutomationProperties.Name="{Binding ProgressText}"
                Maximum="{Binding Total}"
                Minimum="0"
                Value="{Binding Completed, Mode=OneWay}" />

            <StackPanel
                Grid.Row="2"
                Margin="0,8,0,12"
                Orientation="Horizontal">
                <TextBlock Text="{Binding ProgressText}" />
                <TextBlock Margin="24,0,0,0" Text="{Binding CompiledText}" />
                <TextBlock Margin="24,0,0,0" Text="{Binding FailedText}" />
            </StackPanel>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" MinWidth="140" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="{DynamicResource Str.ToolWindows.Batch.FailedScripts}" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="{DynamicResource Str.ToolWindows.Batch.CompilerOutput}" />

                <ListBox
                    x:Name="FailureList"
                    Grid.Row="1"
                    Grid.Column="0"
                    AutomationProperties.Name="{DynamicResource Str.ToolWindows.Batch.FailedScripts}"
                    ItemsSource="{Binding Failures}"
                    SelectedItem="{Binding SelectedFailure, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="2,2"
                                Text="{Binding FileName}"
                                ToolTip="{Binding ScriptPath}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBox
                    Grid.Row="1"
                    Grid.Column="2"
                    AcceptsReturn="True"
                    AutomationProperties.Name="{DynamicResource Str.ToolWindows.Batch.CompilerOutput}"
                    FontFamily="Consolas"
                    FontSize="12"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    Text="{Binding SelectedFailure.Output, Mode=OneWay}"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>

            <TextBox
                x:Name="LogBox"
                Grid.Row="4"
                Height="110"
                Margin="0,12,0,0"
                AcceptsReturn="True"
                AutomationProperties.Name="{DynamicResource Str.ToolWindows.A11y.BatchLog}"
                FontFamily="Consolas"
                FontSize="12"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                Text="{Binding LogText, Mode=OneWay}"
                TextChanged="OnLogChanged"
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto" />
        </Grid>

        <StackPanel
            Grid.Row="2"
            Margin="20,12,20,16"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                MinWidth="96"
                Command="{Binding CancelCommand}"
                Content="{DynamicResource Str.Common.Cancel}"
                IsCancel="True"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button
                MinWidth="96"
                Appearance="Primary"
                Command="{Binding CloseCommand}"
                Content="{DynamicResource Str.Common.Close}"
                IsCancel="True"
                IsDefault="True"
                Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
