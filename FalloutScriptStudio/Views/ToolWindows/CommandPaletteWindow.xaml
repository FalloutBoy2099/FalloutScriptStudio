<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.ToolWindows.CommandPaletteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a11y="clr-namespace:FalloutScriptStudio.Views.Accessibility"
    xmlns:local="clr-namespace:FalloutScriptStudio.Views.ToolWindows"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="620"
    Height="420"
    MinWidth="380"
    MinHeight="240"
    a11y:WindowFit.FitToWorkArea="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnLoaded"
    PreviewKeyDown="OnPreviewKeyDown"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!--  One thin row per command: a light accent wash marks the selection, the text keeps its color in both themes  -->
        <Style x:Key="PaletteRowStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,0,14,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid>
                            <Border
                                x:Name="Hover"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="Selection"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="4"
                                Opacity="0" />
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selection" Property="Opacity" Value="0.22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasReason}" Value="True">
                    <Setter Property="ToolTip" Value="{Binding ReasonText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{Binding Title}"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <ui:TextBox
            x:Name="FilterBox"
            Grid.Row="1"
            Height="28"
            MinHeight="28"
            Margin="10,2,10,6"
            Padding="8,0"
            VerticalContentAlignment="Center"
            AutomationProperties.Name="{DynamicResource Str.Shell.Palette.Search}"
            ClearButtonEnabled="True"
            FontSize="12"
            PlaceholderText="{DynamicResource Str.Shell.Palette.Search}"
            Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />

        <ListBox
            x:Name="CommandList"
            Grid.Row="2"
            Margin="10,0"
            AutomationProperties.Name="{Binding Title}"
            ItemContainerStyle="{StaticResource PaletteRowStyle}"
            ItemsSource="{Binding Items}"
            MouseDoubleClick="OnListDoubleClick"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid x:Name="Row">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            local:PaletteNameText.Parts="{Binding NameParts}"
                            FontSize="12"
                            FontWeight="Normal"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding PathText}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding TrailingText}" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel
            Grid.Row="3"
            Margin="10,6,10,8"
            LastChildFill="False">
            <ui:Button
                Height="28"
                MinWidth="72"
                MinHeight="28"
                Margin="6,0,0,0"
                Padding="12,0"
                Command="{Binding CancelCommand}"
                Content="{DynamicResource Str.Common.Cancel}"
                DockPanel.Dock="Right"
                FontSize="12"
                IsCancel="True" />
            <ui:Button
                Height="28"
                MinWidth="72"
                MinHeight="28"
                Padding="12,0"
                Appearance="Primary"
                Command="{Binding AcceptCommand}"
                Content="{DynamicResource Str.Shell.Palette.Run}"
                DockPanel.Dock="Right"
                FontSize="12"
                IsDefault="True" />
            <TextBlock
                VerticalAlignment="Center"
                a11y:LiveRegion.Text="{Binding StatusText}"
                DockPanel.Dock="Left"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusText}"
                TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>

</ui:FluentWindow>