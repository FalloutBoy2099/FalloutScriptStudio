<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.ToolWindows.FormatProjectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a11y="clr-namespace:FalloutScriptStudio.Views.Accessibility"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Str.ToolWindows.Format.Title}"
    Width="980"
    Height="640"
    MinWidth="720"
    MinHeight="440"
    a11y:WindowFit.FitToWorkArea="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FocusManager.FocusedElement="{Binding ElementName=OpenDocumentsOption}"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{DynamicResource Str.ToolWindows.Format.Title}"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="16,8,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <RadioButton
                x:Name="OpenDocumentsOption"
                Grid.Column="0"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                Content="{DynamicResource Str.ToolWindows.Format.ScopeOpen}"
                GroupName="Scope"
                IsChecked="{Binding IsOpenDocumentsScope, Mode=TwoWay}"
                IsEnabled="{Binding IsIdle}" />
            <RadioButton
                Grid.Column="1"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                Content="{DynamicResource Str.ToolWindows.Format.ScopeProject}"
                GroupName="Scope"
                IsChecked="{Binding IsProjectScope, Mode=TwoWay}">
                <RadioButton.Style>
                    <Style BasedOn="{StaticResource {x:Type RadioButton}}" TargetType="RadioButton">
                        <Setter Property="IsEnabled" Value="False" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasProjectFolder}" Value="True" />
                                    <Condition Binding="{Binding IsIdle}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="True" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </RadioButton.Style>
            </RadioButton>
            <TextBlock
                x:Name="MasksLabel"
                Grid.Column="2"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="{DynamicResource Str.ToolWindows.Format.Masks}" />
            <ui:TextBox
                Grid.Column="3"
                MinWidth="160"
                AutomationProperties.LabeledBy="{Binding ElementName=MasksLabel}"
                IsEnabled="{Binding AreMasksEnabled}"
                Text="{Binding Masks, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button
                Grid.Column="4"
                MinWidth="96"
                Margin="12,0,0,0"
                Appearance="Primary"
                Command="{Binding PreviewCommand}"
                Content="{DynamicResource Str.ToolWindows.Format.Preview}"
                IsDefault="True" />
        </Grid>

        <Grid Grid.Row="2" Margin="16,4,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                a11y:LiveRegion.Text="{Binding StatusText}"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusText}"
                TextWrapping="Wrap" />
            <ProgressBar
                Grid.Column="1"
                Height="6"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{DynamicResource Str.ToolWindows.Format.Progress}"
                IsIndeterminate="{Binding IsIndeterminate}"
                Maximum="1"
                Minimum="0"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                Value="{Binding Progress, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="3" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="0,0,0,4"
                    FontWeight="SemiBold"
                    Text="{DynamicResource Str.ToolWindows.Format.Files}" />
                <ListBox
                    x:Name="FileList"
                    Grid.Row="1"
                    AutomationProperties.Name="{DynamicResource Str.ToolWindows.Format.Files}"
                    ItemsSource="{Binding Items}"
                    KeyDown="OnFileListKeyDown"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Grid.Column="0"
                                    MinWidth="0"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding AccessibleName}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding DisplayName}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding ChangedLinesText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel
                    Grid.Row="2"
                    Margin="0,6,0,0"
                    Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,6,0"
                        Command="{Binding SelectAllCommand}"
                        Content="{DynamicResource Str.ToolWindows.Format.SelectAll}" />
                    <ui:Button Command="{Binding SelectNoneCommand}" Content="{DynamicResource Str.ToolWindows.Format.SelectNone}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="DiffLabel"
                    Margin="0,0,0,4"
                    FontWeight="SemiBold"
                    Text="{DynamicResource Str.ToolWindows.Format.Changes}" />
                <TextBox
                    Grid.Row="1"
                    AutomationProperties.LabeledBy="{Binding ElementName=DiffLabel}"
                    FontFamily="Consolas"
                    FontSize="12"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    IsReadOnlyCaretVisible="True"
                    Text="{Binding DiffText, Mode=OneWay}"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>

        <DockPanel Grid.Row="4" Margin="16,4,16,14">
            <ui:Button
                MinWidth="96"
                Margin="8,0,0,0"
                Command="{Binding CloseCommand}"
                Content="{DynamicResource Str.Common.Close}"
                DockPanel.Dock="Right"
                IsCancel="True" />
            <ui:Button
                MinWidth="96"
                Margin="8,0,0,0"
                Command="{Binding CancelCommand}"
                Content="{DynamicResource Str.ToolWindows.Format.Stop}"
                DockPanel.Dock="Right" />
            <ui:Button
                MinWidth="120"
                Appearance="Primary"
                Command="{Binding ApplyCommand}"
                Content="{DynamicResource Str.ToolWindows.Format.Apply}"
                DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>

</ui:FluentWindow>