<ui:FluentWindow FontSize="12" x:Class="FalloutScriptStudio.Views.ToolWindows.GoToLineWindow"
				 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
				 Title="{DynamicResource Str.ToolWindows.GoToLine.Title}"
				 Width="360" Height="230" ResizeMode="NoResize"
				 ShowInTaskbar="False" Topmost="False"
				 WindowStartupLocation="CenterOwner"
				 ExtendsContentIntoTitleBar="True"
				 WindowBackdropType="Mica"
				 Background="{DynamicResource ApplicationBackgroundBrush}"
				 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
				 Loaded="OnLoaded">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ui:TitleBar Grid.Row="0" Title="{DynamicResource Str.ToolWindows.GoToLine.Title}" ShowMinimize="False" ShowMaximize="False" />

		<StackPanel Grid.Row="1" Margin="20,8,20,20">
			<TextBlock Text="{Binding Prompt}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
			<ui:TextBox x:Name="LineBox"
						Text="{Binding LineText, UpdateSourceTrigger=PropertyChanged}"
						PlaceholderText="{DynamicResource Str.ToolWindows.GoToLine.Placeholder}"
						TextAlignment="Right"
						InputMethod.IsInputMethodEnabled="False" />
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
				<ui:Button Content="{DynamicResource Str.ToolWindows.GoToLine.Go}" Appearance="Primary" IsDefault="True" MinWidth="88" Command="{Binding GoCommand}" />
				<ui:Button Content="{DynamicResource Str.Common.Cancel}" IsCancel="True" MinWidth="88" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
			</StackPanel>
		</StackPanel>
	</Grid>
</ui:FluentWindow>
