<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.ToolWindows.GoToLineWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Str.ToolWindows.GoToLine.Title}"
    Width="360"
    Height="230"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnLoaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{DynamicResource Str.ToolWindows.GoToLine.Title}"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <TextBlock
                Margin="0,0,0,8"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding Prompt}" />
            <ui:TextBox
                x:Name="LineBox"
                InputMethod.IsInputMethodEnabled="False"
                PlaceholderText="{DynamicResource Str.ToolWindows.GoToLine.Placeholder}"
                Text="{Binding LineText, UpdateSourceTrigger=PropertyChanged}"
                TextAlignment="Right" />
            <StackPanel
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    MinWidth="88"
                    Appearance="Primary"
                    Command="{Binding GoCommand}"
                    Content="{DynamicResource Str.ToolWindows.GoToLine.Go}"
                    IsDefault="True" />
                <ui:Button
                    MinWidth="88"
                    Margin="8,0,0,0"
                    Command="{Binding CancelCommand}"
                    Content="{DynamicResource Str.Common.Cancel}"
                    IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
