<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.ToolWindows.SnippetPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a11y="clr-namespace:FalloutScriptStudio.Views.Accessibility"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="620"
    Height="480"
    MinWidth="380"
    MinHeight="280"
    a11y:WindowFit.FitToWorkArea="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnLoaded"
    PreviewKeyDown="OnPreviewKeyDown"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{Binding Title}"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <ui:TextBox
            x:Name="FilterBox"
            Grid.Row="1"
            Margin="16,8,16,8"
            AutomationProperties.Name="{DynamicResource Str.ToolWindows.Snippets.Search}"
            ClearButtonEnabled="True"
            PlaceholderText="{DynamicResource Str.ToolWindows.Snippets.Search}"
            Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />

        <ListBox
            x:Name="SnippetList"
            Grid.Row="2"
            Margin="16,0,16,0"
            AutomationProperties.Name="{Binding Title}"
            ItemsSource="{Binding Items}"
            MouseDoubleClick="OnListDoubleClick"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <ListBox.ItemContainerStyle>
                <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,2" />
                    <Setter Property="Margin" Value="0,0,0,1" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Symbol="CodeBlock24" />
                        <StackPanel Grid.Column="1">
                            <DockPanel LastChildFill="False">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SourceText}" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontWeight="SemiBold"
                                    Text="{Binding Trigger}" />
                                <TextBlock
                                    Margin="12,0,0,0"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Preview}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel
            Grid.Row="3"
            Margin="16,10,16,14"
            LastChildFill="False">
            <TextBlock
                VerticalAlignment="Center"
                a11y:LiveRegion.Text="{Binding StatusText}"
                DockPanel.Dock="Left"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusText}" />
            <ui:Button
                MinWidth="80"
                Margin="8,0,0,0"
                Command="{Binding CancelCommand}"
                Content="{DynamicResource Str.Common.Cancel}"
                DockPanel.Dock="Right"
                IsCancel="True" />
            <ui:Button
                MinWidth="80"
                Appearance="Primary"
                Command="{Binding AcceptCommand}"
                Content="{Binding AcceptText}"
                DockPanel.Dock="Right"
                IsDefault="True" />
        </DockPanel>
    </Grid>

</ui:FluentWindow>