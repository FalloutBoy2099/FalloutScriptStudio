<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.ToolWindows.SnippetManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a11y="clr-namespace:FalloutScriptStudio.Views.Accessibility"
    xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Str.ToolWindows.Snippets.Title}"
    Width="1000"
    Height="680"
    MinWidth="760"
    MinHeight="480"
    a11y:WindowFit.FitToWorkArea="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FocusManager.FocusedElement="{Binding ElementName=SnippetList}"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{DynamicResource Str.ToolWindows.Snippets.Title}"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <WrapPanel Grid.Row="1" Margin="16,8,16,4">
            <ui:Button
                Margin="0,0,6,4"
                Command="{Binding AddCommand}"
                Content="{DynamicResource Str.ToolWindows.Snippets.Add}" />
            <ui:Button
                Margin="0,0,6,4"
                Command="{Binding DuplicateCommand}"
                Content="{DynamicResource Str.ToolWindows.Snippets.Duplicate}" />
            <ui:Button
                Margin="0,0,6,4"
                Command="{Binding DeleteCommand}"
                Content="{DynamicResource Str.Common.Delete}" />
            <ui:Button
                Margin="0,0,6,4"
                Command="{Binding CustomizeCommand}"
                Content="{DynamicResource Str.ToolWindows.Snippets.Customize}"
                ToolTip="{DynamicResource Str.ToolWindows.Snippets.CustomizeTip}" />
            <ui:Button
                Margin="0,0,18,4"
                Command="{Binding DisableCommand}"
                Content="{DynamicResource Str.ToolWindows.Snippets.Disable}" />
            <ui:Button
                Margin="0,0,6,4"
                Command="{Binding ImportCommand}"
                Content="{DynamicResource Str.ToolWindows.Snippets.Import}" />
            <ui:Button
                Margin="0,0,6,4"
                Command="{Binding ExportCommand}"
                Content="{DynamicResource Str.ToolWindows.Snippets.Export}" />
            <ui:Button
                Margin="0,0,18,4"
                Command="{Binding ImportFunctionsCommand}"
                Content="{DynamicResource Str.ToolWindows.Snippets.ImportFunctions}"
                ToolTip="{DynamicResource Str.ToolWindows.Snippets.ImportFunctionsTip}" />
            <TextBlock
                Margin="0,0,8,4"
                VerticalAlignment="Center"
                Text="{DynamicResource Str.ToolWindows.Snippets.Target}" />
            <ComboBox
                MinWidth="180"
                Margin="0,0,0,4"
                AutomationProperties.Name="{DynamicResource Str.ToolWindows.Snippets.Target}"
                DisplayMemberPath="Text"
                ItemsSource="{Binding TargetChoices}"
                SelectedValue="{Binding Target, Mode=TwoWay}"
                SelectedValuePath="Value" />
        </WrapPanel>

        <Grid Grid.Row="2" Margin="16,4,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <ListBox
                x:Name="SnippetList"
                Grid.Column="0"
                AutomationProperties.Name="{DynamicResource Str.ToolWindows.Snippets.List}"
                ItemsSource="{Binding Rows}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,2" />
                        <Setter Property="Margin" Value="0,0,0,1" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <DockPanel LastChildFill="False">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{DynamicResource ShellListSecondaryTextStyle}"
                                    Text="{Binding SourceText}" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontWeight="SemiBold"
                                    Text="{Binding Trigger}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    Style="{DynamicResource ShellListSecondaryTextStyle}"
                                    Text="{Binding StateText}" />
                            </DockPanel>
                            <TextBlock
                                Style="{DynamicResource ShellListSecondaryTextStyle}"
                                Text="{Binding Description}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Center"
                Background="Transparent"
                ResizeBehavior="PreviousAndNext" />

            <Grid
                Grid.Column="2"
                DataContext="{Binding SelectedRow}"
                IsEnabled="{Binding IsEditable}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,10,8"
                    VerticalAlignment="Center"
                    Text="{DynamicResource Str.ToolWindows.Snippets.Trigger}" />
                <DockPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,8">
                    <CheckBox
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Content="{DynamicResource Str.ToolWindows.Snippets.Enabled}"
                        DockPanel.Dock="Right"
                        IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                    <ui:TextBox
                        x:Name="TriggerBox"
                        AutomationProperties.Name="{DynamicResource Str.ToolWindows.Snippets.Trigger}"
                        FontFamily="Consolas"
                        Text="{Binding Trigger, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,10,8"
                    VerticalAlignment="Center"
                    Text="{DynamicResource Str.ToolWindows.Snippets.Description}" />
                <ui:TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{DynamicResource Str.ToolWindows.Snippets.Description}"
                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,4"
                    Text="{DynamicResource Str.ToolWindows.Snippets.Body}" />

                <Border
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <ae:TextEditor
                        x:Name="BodyEditor"
                        Padding="4,2,0,0"
                        a11y:EditorAutomation.NameResource="Str.ToolWindows.Snippets.Body"
                        HorizontalScrollBarVisibility="Auto"
                        ShowLineNumbers="False"
                        VerticalScrollBarVisibility="Auto"
                        WordWrap="False" />
                </Border>

                <StackPanel
                    Grid.Row="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0">
                    <TextBlock
                        Margin="0,0,0,6"
                        a11y:LiveRegion.Text="{Binding Message}"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{Binding Message}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Margin="16,4,16,0">
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding SyntaxHelp}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,6,0,0"
                a11y:LiveRegion.Text="{Binding FileMessage}"
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                Text="{Binding FileMessage}"
                TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel
            Grid.Row="4"
            Margin="16,8,16,14"
            LastChildFill="False">
            <TextBlock
                VerticalAlignment="Center"
                a11y:LiveRegion.Text="{Binding StatusText}"
                DockPanel.Dock="Left"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusText}" />
            <ui:Button
                MinWidth="80"
                Margin="8,0,0,0"
                Command="{Binding CancelCommand}"
                Content="{DynamicResource Str.Common.Cancel}"
                DockPanel.Dock="Right"
                IsCancel="True" />
            <ui:Button
                MinWidth="80"
                Appearance="Primary"
                Command="{Binding SaveCommand}"
                Content="{DynamicResource Str.Common.Save}"
                DockPanel.Dock="Right"
                IsDefault="True" />
        </DockPanel>
    </Grid>

</ui:FluentWindow>