<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.ToolWindows.CompareMessagesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a11y="clr-namespace:FalloutScriptStudio.Views.Accessibility"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Str.ToolWindows.Compare.Title}"
    Width="1100"
    Height="700"
    MinWidth="760"
    MinHeight="460"
    a11y:WindowFit.FitToWorkArea="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FocusManager.FocusedElement="{Binding ElementName=Table}"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="FieldCaption" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!--  A text button grows with its text (never a fixed width), so the longest translation is not clipped  -->
        <Style
            x:Key="CompareButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="{x:Type ui:Button}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,2,6,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{DynamicResource Str.ToolWindows.Compare.Title}"
            Grid.Row="0"
            ShowMaximize="True"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="16,8,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="ReferenceCaption"
                Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource FieldCaption}"
                Text="{DynamicResource Str.ToolWindows.Compare.Reference}" />
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    Grid.Column="0"
                    AutomationProperties.LabeledBy="{Binding ElementName=ReferenceCaption}"
                    IsReadOnly="True"
                    Text="{Binding ReferencePath, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ReferenceInfo}" />
            </Grid>
            <ui:Button
                Grid.Row="0"
                Grid.Column="2"
                Margin="8,2,0,2"
                Command="{Binding ChooseReferenceCommand}"
                Content="{DynamicResource Str.ToolWindows.Compare.ChooseReference}"
                Style="{StaticResource CompareButtonStyle}" />

            <TextBlock
                x:Name="TargetCaption"
                Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource FieldCaption}"
                Text="{DynamicResource Str.ToolWindows.Compare.Target}" />
            <ComboBox
                x:Name="TargetBox"
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,2"
                AutomationProperties.LabeledBy="{Binding ElementName=TargetCaption}"
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding Targets}"
                SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" />
            <StackPanel
                Grid.Row="1"
                Grid.Column="2"
                Orientation="Horizontal">
                <ui:Button
                    Margin="8,2,6,2"
                    Command="{Binding AddTargetCommand}"
                    Content="{DynamicResource Str.ToolWindows.Compare.AddTarget}"
                    Style="{StaticResource CompareButtonStyle}" />
                <ui:Button
                    Margin="0,2,0,2"
                    Command="{Binding RemoveTargetCommand}"
                    Content="{DynamicResource Str.Common.Remove}"
                    Style="{StaticResource CompareButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="16,2,16,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl Grid.Column="0" ItemsSource="{Binding Filters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton
                            Content="{Binding Label}"
                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            Style="{StaticResource ShellCounterToggleStyle}"
                            ToolTip="{Binding Label}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <CheckBox
                    MinHeight="24"
                    Margin="8,0,12,0"
                    Content="{DynamicResource Str.ToolWindows.Compare.IssuesOnly}"
                    IsChecked="{Binding IssuesOnly, Mode=TwoWay}" />
                <ui:TextBox
                    Width="200"
                    AutomationProperties.Name="{DynamicResource Str.ToolWindows.Compare.FilterBox}"
                    PlaceholderText="{DynamicResource Str.ToolWindows.Compare.FilterBox}"
                    Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Margin="16,2,16,4">
            <TextBlock
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding SummaryText}"
                TextWrapping="Wrap" />
            <StackPanel
                Margin="0,2,0,0"
                Orientation="Horizontal"
                Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
                <ui:SymbolIcon
                    Margin="0,2,8,0"
                    VerticalAlignment="Top"
                    FontSize="14"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Symbol="Warning24" />
                <TextBlock Text="{Binding NotesText}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <Border
            Grid.Row="4"
            Margin="16,0,16,6"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource ControlCornerRadius}">
            <DataGrid
                x:Name="Table"
                AutoGenerateColumns="False"
                AutomationProperties.Name="{DynamicResource Str.ToolWindows.Compare.Table}"
                Background="Transparent"
                BorderThickness="0"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeRows="False"
                ColumnHeaderHeight="22"
                ColumnHeaderStyle="{StaticResource ShellCompactColumnHeaderStyle}"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                FontSize="12"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding Rows}"
                MinRowHeight="22"
                MouseDoubleClick="OnTableDoubleClick"
                PreviewKeyDown="OnTableKeyDown"
                RowHeaderWidth="0"
                RowHeight="22"
                ScrollViewer.CanContentScroll="True"
                SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding PlacementTarget.DataContext.OpenRowCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Header="{DynamicResource Str.ToolWindows.Compare.OpenTarget}" />
                        <MenuItem Command="{Binding PlacementTarget.DataContext.OpenReferenceRowCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Header="{DynamicResource Str.ToolWindows.Compare.OpenReference}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource DefaultDataGridRowStyle}" TargetType="DataGridRow">
                        <Setter Property="Height" Value="22" />
                        <Setter Property="MinHeight" Value="22" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Resources>
                    <Style x:Key="TrimmedCell" TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Padding" Value="6,0" />
                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="64"
                        MinWidth="52"
                        Binding="{Binding Number}"
                        ElementStyle="{StaticResource TrimmedCell}"
                        Header="{DynamicResource Str.ToolWindows.Compare.Col.Number}" />
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="140"
                        Binding="{Binding ReferenceText}"
                        ElementStyle="{StaticResource TrimmedCell}"
                        Header="{DynamicResource Str.ToolWindows.Compare.Col.Reference}" />
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="140"
                        Binding="{Binding TargetText}"
                        ElementStyle="{StaticResource TrimmedCell}"
                        Header="{DynamicResource Str.ToolWindows.Compare.Col.Target}" />
                    <DataGridTextColumn
                        Width="210"
                        MinWidth="90"
                        Binding="{Binding StatusText}"
                        ElementStyle="{StaticResource TrimmedCell}"
                        Header="{DynamicResource Str.ToolWindows.Compare.Col.Status}" />
                    <DataGridTextColumn
                        Width="190"
                        MinWidth="90"
                        Binding="{Binding IssuesText}"
                        ElementStyle="{StaticResource TrimmedCell}"
                        Header="{DynamicResource Str.ToolWindows.Compare.Col.Issues}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock
            Grid.Row="5"
            Margin="16,0,16,4"
            a11y:LiveRegion.Text="{Binding StatusText}"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding StatusText}"
            TextWrapping="Wrap" />

        <DockPanel Grid.Row="6" Margin="16,2,16,12">
            <ui:Button
                Margin="8,2,0,2"
                Command="{Binding CloseCommand}"
                Content="{DynamicResource Str.Common.Close}"
                DockPanel.Dock="Right"
                IsCancel="True"
                Style="{StaticResource CompareButtonStyle}" />
            <WrapPanel Orientation="Horizontal">
                <ui:Button
                    Command="{Binding AddMissingCommand}"
                    Content="{DynamicResource Str.ToolWindows.Compare.AddMissing}"
                    Style="{StaticResource CompareButtonStyle}" />
                <CheckBox
                    MinHeight="24"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    Content="{DynamicResource Str.ToolWindows.Compare.MarkUntranslated}"
                    IsChecked="{Binding MarkUntranslated, Mode=TwoWay}"
                    ToolTip="{DynamicResource Str.ToolWindows.Compare.MarkUntranslatedTip}" />
                <ui:Button
                    Command="{Binding CopyNumbersCommand}"
                    Content="{DynamicResource Str.ToolWindows.Compare.CopyNumbers}"
                    Style="{StaticResource CompareButtonStyle}" />
                <ui:Button
                    Command="{Binding ExportCommand}"
                    Content="{DynamicResource Str.ToolWindows.Compare.Export}"
                    Style="{StaticResource CompareButtonStyle}" />
                <ui:Button
                    Command="{Binding ShowAsProblemsCommand}"
                    Content="{DynamicResource Str.ToolWindows.Compare.ShowAsProblems}"
                    Style="{StaticResource CompareButtonStyle}" />
                <ui:Button
                    Command="{Binding CompareCommand}"
                    Content="{DynamicResource Str.ToolWindows.Compare.Refresh}"
                    Style="{StaticResource CompareButtonStyle}" />
            </WrapPanel>
        </DockPanel>
    </Grid>

</ui:FluentWindow>