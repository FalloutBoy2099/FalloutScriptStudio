<ui:FluentWindow FontSize="12" x:Class="FalloutScriptStudio.Views.ToolWindows.HeadersWindow"
				 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
				 Title="{DynamicResource Str.ToolWindows.Headers.Title}"
				 Width="420" Height="520" MinWidth="320" MinHeight="260"
				 ShowInTaskbar="False"
				 WindowStartupLocation="CenterOwner"
				 ExtendsContentIntoTitleBar="True"
				 WindowBackdropType="Mica"
				 Background="{DynamicResource ApplicationBackgroundBrush}"
				 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
				 Loaded="OnLoaded"
				 Closing="OnClosing"
				 Deactivated="OnDeactivated"
				 PreviewKeyDown="OnPreviewKeyDown">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ui:TitleBar Grid.Row="0" Title="{DynamicResource Str.ToolWindows.Headers.Title}" ShowMinimize="False" ShowMaximize="False" />

		<ui:TextBox x:Name="FilterBox" Grid.Row="1" Margin="16,8,16,8"
					Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
					PlaceholderText="{DynamicResource Str.ToolWindows.Headers.Search}"
					ClearButtonEnabled="True" />

		<ListBox x:Name="HeaderList" Grid.Row="2" Margin="16,0,16,0"
				 ItemsSource="{Binding Items}"
				 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
				 MouseDoubleClick="OnListDoubleClick"
				 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
			<ListBox.ItemContainerStyle>
				<Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
					<Setter Property="Padding" Value="8,2" />
					<Setter Property="Margin" Value="0,0,0,1" />
				</Style>
			</ListBox.ItemContainerStyle>
			<ListBox.ItemTemplate>
				<DataTemplate>
					<StackPanel Margin="4,3" ToolTip="{Binding FullPath}">
						<TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
						<TextBlock Text="{Binding RelativePath}" FontSize="11" TextTrimming="CharacterEllipsis"
								   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<DockPanel Grid.Row="3" Margin="16,10,16,14" LastChildFill="False">
			<TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="{Binding StatusText}"
					   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
			<ui:Button DockPanel.Dock="Right" Content="{DynamicResource Str.Common.Cancel}" IsCancel="True" MinWidth="80" Margin="8,0,0,0"
					   Command="{Binding CancelCommand}" />
			<ui:Button DockPanel.Dock="Right" Content="{DynamicResource Str.ToolWindows.Headers.Open}" Appearance="Primary" IsDefault="True" MinWidth="80"
					   Command="{Binding AcceptCommand}" />
		</DockPanel>
	</Grid>
</ui:FluentWindow>
