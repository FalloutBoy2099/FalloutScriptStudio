<ui:FluentWindow
    x:Class="FalloutScriptStudio.Views.ToolWindows.HeadersWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a11y="clr-namespace:FalloutScriptStudio.Views.Accessibility"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Str.ToolWindows.Headers.Title}"
    Width="420"
    Height="520"
    MinWidth="320"
    MinHeight="260"
    a11y:WindowFit.FitToWorkArea="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Closing="OnClosing"
    Deactivated="OnDeactivated"
    ExtendsContentIntoTitleBar="True"
    FontSize="12"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnLoaded"
    PreviewKeyDown="OnPreviewKeyDown"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{DynamicResource Str.ToolWindows.Headers.Title}"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <ui:TextBox
            x:Name="FilterBox"
            Grid.Row="1"
            Margin="16,8,16,8"
            AutomationProperties.Name="{DynamicResource Str.ToolWindows.Headers.Search}"
            ClearButtonEnabled="True"
            PlaceholderText="{DynamicResource Str.ToolWindows.Headers.Search}"
            Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />

        <ListBox
            x:Name="HeaderList"
            Grid.Row="2"
            Margin="16,0,16,0"
            AutomationProperties.Name="{DynamicResource Str.ToolWindows.Headers.Title}"
            ItemsSource="{Binding Items}"
            MouseDoubleClick="OnListDoubleClick"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <ListBox.ItemContainerStyle>
                <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,2" />
                    <Setter Property="Margin" Value="0,0,0,1" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,3" ToolTip="{Binding FullPath}">
                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding RelativePath}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel
            Grid.Row="3"
            Margin="16,10,16,14"
            LastChildFill="False">
            <TextBlock
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusText}" />
            <ui:Button
                MinWidth="80"
                Margin="8,0,0,0"
                Command="{Binding CancelCommand}"
                Content="{DynamicResource Str.Common.Cancel}"
                DockPanel.Dock="Right"
                IsCancel="True" />
            <ui:Button
                MinWidth="80"
                Appearance="Primary"
                Command="{Binding AcceptCommand}"
                Content="{DynamicResource Str.ToolWindows.Headers.Open}"
                DockPanel.Dock="Right"
                IsDefault="True" />
        </DockPanel>
    </Grid>

</ui:FluentWindow>