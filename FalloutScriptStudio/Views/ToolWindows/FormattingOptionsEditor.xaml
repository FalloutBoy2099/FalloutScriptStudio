<UserControl
    x:Class="FalloutScriptStudio.Views.ToolWindows.FormattingOptionsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FalloutScriptStudio.Views.ToolWindows"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <StackPanel>
        <DockPanel Margin="0,0,0,6" LastChildFill="False">
            <TextBlock
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                FontWeight="SemiBold"
                Text="{DynamicResource Str.ToolWindows.Fmt.Preview}" />
            <ui:Button
                Command="{Binding ResetCommand}"
                Content="{DynamicResource Str.ToolWindows.Fmt.Reset}"
                DockPanel.Dock="Right"
                ToolTip="{DynamicResource Str.ToolWindows.Fmt.ResetTip}" />
        </DockPanel>
        <TextBox
            Height="250"
            Margin="0,0,0,12"
            AutomationProperties.HelpText="{DynamicResource Str.ToolWindows.Fmt.PreviewHelp}"
            AutomationProperties.Name="{DynamicResource Str.ToolWindows.Fmt.Preview}"
            FontFamily="Consolas"
            FontSize="12"
            HorizontalScrollBarVisibility="Auto"
            IsReadOnly="True"
            IsReadOnlyCaretVisible="True"
            Text="{Binding PreviewText, Mode=OneWay}"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto" />

        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.Indent.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.Indent.Desc}">
            <ComboBox
                MinWidth="240"
                DisplayMemberPath="Text"
                ItemsSource="{Binding IndentChoices}"
                SelectedValue="{Binding Indentation, Mode=TwoWay}"
                SelectedValuePath="Value" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.IndentSize.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.IndentSize.Desc}">
            <ui:NumberBox
                Width="140"
                MaxDecimalPlaces="0"
                Maximum="{Binding MaxIndentSize}"
                Minimum="0"
                SmallChange="1"
                Value="{Binding IndentSize, UpdateSourceTrigger=LostFocus}" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.Reindent.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.Reindent.Desc}">
            <ui:ToggleSwitch IsChecked="{Binding Reindent}" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.Continuation.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.Continuation.Desc}">
            <ui:NumberBox
                Width="140"
                MaxDecimalPlaces="0"
                Maximum="4"
                Minimum="1"
                SmallChange="1"
                Value="{Binding ContinuationIndent, UpdateSourceTrigger=LostFocus}" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.AlignBracket.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.AlignBracket.Desc}">
            <ui:ToggleSwitch IsChecked="{Binding AlignContinuationToBracket}" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.Begin.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.Begin.Desc}">
            <ComboBox
                MinWidth="240"
                DisplayMemberPath="Text"
                ItemsSource="{Binding BeginChoices}"
                SelectedValue="{Binding Begin, Mode=TwoWay}"
                SelectedValuePath="Value" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.ElseBegin.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.ElseBegin.Desc}">
            <ComboBox
                MinWidth="240"
                DisplayMemberPath="Text"
                ItemsSource="{Binding ElseBeginChoices}"
                SelectedValue="{Binding ElseBegin, Mode=TwoWay}"
                SelectedValuePath="Value" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.Else.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.Else.Desc}">
            <ComboBox
                MinWidth="240"
                DisplayMemberPath="Text"
                ItemsSource="{Binding ElseChoices}"
                SelectedValue="{Binding Else, Mode=TwoWay}"
                SelectedValuePath="Value" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.Operators.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.Operators.Desc}">
            <ComboBox
                MinWidth="240"
                DisplayMemberPath="Text"
                ItemsSource="{Binding SpacingChoices}"
                SelectedValue="{Binding OperatorSpacing, Mode=TwoWay}"
                SelectedValuePath="Value" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.Assignments.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.Assignments.Desc}">
            <ComboBox
                MinWidth="240"
                DisplayMemberPath="Text"
                ItemsSource="{Binding SpacingChoices}"
                SelectedValue="{Binding AssignmentSpacing, Mode=TwoWay}"
                SelectedValuePath="Value" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.Commas.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.Commas.Desc}">
            <ComboBox
                MinWidth="240"
                DisplayMemberPath="Text"
                ItemsSource="{Binding SpacingChoices}"
                SelectedValue="{Binding CommaSpacing, Mode=TwoWay}"
                SelectedValuePath="Value" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.Parentheses.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.Parentheses.Desc}">
            <ComboBox
                MinWidth="240"
                DisplayMemberPath="Text"
                ItemsSource="{Binding InnerSpacingChoices}"
                SelectedValue="{Binding ParenthesisSpacing, Mode=TwoWay}"
                SelectedValuePath="Value" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.Preprocessor.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.Preprocessor.Desc}">
            <ui:ToggleSwitch IsChecked="{Binding FormatPreprocessorLines}" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.ProcedureBlank.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.ProcedureBlank.Desc}">
            <ComboBox
                MinWidth="240"
                DisplayMemberPath="Text"
                ItemsSource="{Binding ProcedureBlankChoices}"
                SelectedValue="{Binding BlankLinesBetweenProcedures, Mode=TwoWay}"
                SelectedValuePath="Value" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.MaxBlank.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.MaxBlank.Desc}">
            <ComboBox
                MinWidth="240"
                DisplayMemberPath="Text"
                ItemsSource="{Binding MaxBlankChoices}"
                SelectedValue="{Binding MaxConsecutiveBlankLines, Mode=TwoWay}"
                SelectedValuePath="Value" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.Trim.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.Trim.Desc}">
            <ui:ToggleSwitch IsChecked="{Binding TrimTrailingWhitespace}" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.FinalNewline.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.FinalNewline.Desc}">
            <ui:ToggleSwitch IsChecked="{Binding EnsureFinalNewline}" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.AlignDefines.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.AlignDefines.Desc}">
            <ui:ToggleSwitch IsChecked="{Binding AlignDefines}" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.Wrap.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.Wrap.Desc}">
            <ui:NumberBox
                Width="140"
                MaxDecimalPlaces="0"
                Maximum="{Binding MaxLineLengthLimit}"
                Minimum="0"
                SmallChange="10"
                Value="{Binding MaxLineLength, UpdateSourceTrigger=LostFocus}" />
        </local:SettingCard>
        <local:SettingCard Title="{DynamicResource Str.ToolWindows.Fmt.OnSave.Title}" Description="{DynamicResource Str.ToolWindows.Fmt.OnSave.Desc}">
            <ui:ToggleSwitch IsChecked="{Binding FormatOnSave}" />
        </local:SettingCard>
    </StackPanel>

</UserControl>