<UserControl
    x:Class="FalloutScriptStudio.Views.Panels.ProjectExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:FalloutScriptStudio.ViewModels.Panels">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:ProjectNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon
                    x:Name="Icon"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="{Binding Converter={StaticResource ProjectNodeToSymbol}}" />
                <TextBlock
                    x:Name="Text"
                    VerticalAlignment="Center"
                    Text="{Binding Name}" />
            </StackPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter TargetName="Icon" Property="Symbol" Value="Folder24" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDirectory}" Value="True" />
                        <Condition Binding="{Binding IsExpanded}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Icon" Property="Symbol" Value="FolderOpen24" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsCompiled}" Value="True">
                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <Style
            x:Key="ProjectItemStyle"
            BasedOn="{StaticResource ShellTreeViewItemStyle}"
            TargetType="{x:Type TreeViewItem}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
            <Setter Property="ToolTip" Value="{Binding FullPath}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="{DynamicResource Str.Panels.MenuOpen}" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.RevealCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="{DynamicResource Str.Panels.MenuShowInExplorer}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="{DynamicResource Str.Panels.MenuCopyPath}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseDoubleClick" Handler="OnItemMouseDoubleClick" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="6,4,6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
                AutomationProperties.Name="{DynamicResource Str.Panels.TipFilter}"
                IsEnabled="{Binding HasProject}"
                PlaceholderText="{DynamicResource Str.Panels.FilterPlaceholder}"
                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{DynamicResource Str.Panels.TipFilter}" />
            <ui:Button
                Grid.Column="1"
                Margin="4,0,0,0"
                Command="{Binding ChooseFolderCommand}"
                Icon="{ui:SymbolIcon Folder24}"
                Style="{StaticResource ShellIconButtonStyle}"
                ToolTip="{DynamicResource Str.Panels.TipChooseFolder}" />
            <ui:Button
                Grid.Column="2"
                Command="{Binding ReloadCommand}"
                Icon="{ui:SymbolIcon ArrowSync24}"
                Style="{StaticResource ShellIconButtonStyle}"
                ToolTip="{DynamicResource Str.Panels.TipRefresh}" />
            <ToggleButton
                Grid.Column="3"
                Width="32"
                Height="32"
                Padding="0"
                AutomationProperties.Name="{DynamicResource Str.Panels.TipShowCompiled}"
                Background="Transparent"
                BorderThickness="0"
                IsChecked="{Binding ShowCompiled, Mode=TwoWay}"
                ToolTip="{DynamicResource Str.Panels.TipShowCompiled}">
                <ui:SymbolIcon FontSize="14" Symbol="Box24" />
            </ToggleButton>
        </Grid>

        <TreeView
            Grid.Row="1"
            AutomationProperties.Name="{DynamicResource Str.Panels.TabSolution}"
            Background="Transparent"
            BorderThickness="0"
            ItemContainerStyle="{StaticResource ProjectItemStyle}"
            ItemsSource="{Binding Nodes}"
            KeyDown="OnTreeKeyDown"
            PreviewMouseRightButtonDown="OnTreePreviewMouseRightButtonDown" />

        <StackPanel
            Grid.Row="1"
            Margin="16"
            VerticalAlignment="Top"
            Visibility="{Binding HasProject, Converter={StaticResource InvertedBoolToVisibility}}">
            <TextBlock
                Style="{StaticResource ShellCaptionTextStyle}"
                Text="{DynamicResource Str.Panels.EmptyProject}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <ui:Button
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Command="{Binding ChooseFolderCommand}"
                Content="{DynamicResource Str.Panels.ChooseFolderButton}" />
        </StackPanel>
    </Grid>
</UserControl>
