<UserControl x:Class="FalloutScriptStudio.Views.Panels.ProjectExplorerView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
			 xmlns:vm="clr-namespace:FalloutScriptStudio.ViewModels.Panels">
	<UserControl.Resources>
		<HierarchicalDataTemplate DataType="{x:Type vm:ProjectNodeViewModel}" ItemsSource="{Binding Children}">
			<StackPanel Orientation="Horizontal">
				<ui:SymbolIcon x:Name="Icon"
							   Symbol="{Binding Converter={StaticResource ProjectNodeToSymbol}}"
							   FontSize="14"
							   Margin="0,0,6,0"
							   VerticalAlignment="Center"
							   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
				<TextBlock x:Name="Text" Text="{Binding Name}" VerticalAlignment="Center" />
			</StackPanel>
			<HierarchicalDataTemplate.Triggers>
				<DataTrigger Binding="{Binding IsDirectory}" Value="True">
					<Setter TargetName="Icon" Property="Symbol" Value="Folder24" />
				</DataTrigger>
				<MultiDataTrigger>
					<MultiDataTrigger.Conditions>
						<Condition Binding="{Binding IsDirectory}" Value="True" />
						<Condition Binding="{Binding IsExpanded}" Value="True" />
					</MultiDataTrigger.Conditions>
					<Setter TargetName="Icon" Property="Symbol" Value="FolderOpen24" />
				</MultiDataTrigger>
				<DataTrigger Binding="{Binding IsCompiled}" Value="True">
					<Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
				</DataTrigger>
			</HierarchicalDataTemplate.Triggers>
		</HierarchicalDataTemplate>

		<Style x:Key="ProjectItemStyle" TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource ShellTreeViewItemStyle}">
			<Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
			<Setter Property="ToolTip" Value="{Binding FullPath}" />
			<Setter Property="ContextMenu">
				<Setter.Value>
					<ContextMenu>
						<MenuItem Header="{DynamicResource Str.Panels.MenuOpen}"
								  Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
								  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
						<MenuItem Header="{DynamicResource Str.Panels.MenuShowInExplorer}"
								  Command="{Binding PlacementTarget.Tag.RevealCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
								  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="FolderOpen24" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="{DynamicResource Str.Panels.MenuCopyPath}"
								  Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
								  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="Copy24" />
							</MenuItem.Icon>
						</MenuItem>
					</ContextMenu>
				</Setter.Value>
			</Setter>
			<EventSetter Event="MouseDoubleClick" Handler="OnItemMouseDoubleClick" />
		</Style>
	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid Margin="6,4,6,4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<ui:TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
						PlaceholderText="{DynamicResource Str.Panels.FilterPlaceholder}"
						ToolTip="{DynamicResource Str.Panels.TipFilter}"
						IsEnabled="{Binding HasProject}" />
			<ui:Button Grid.Column="1"
					   Style="{StaticResource ShellIconButtonStyle}"
					   Margin="4,0,0,0"
					   Icon="{ui:SymbolIcon Folder24}"
					   ToolTip="{DynamicResource Str.Panels.TipChooseFolder}"
					   Command="{Binding ChooseFolderCommand}" />
			<ui:Button Grid.Column="2"
					   Style="{StaticResource ShellIconButtonStyle}"
					   Icon="{ui:SymbolIcon ArrowSync24}"
					   ToolTip="{DynamicResource Str.Panels.TipRefresh}"
					   Command="{Binding ReloadCommand}" />
			<ToggleButton Grid.Column="3"
						  Width="32"
						  Height="32"
						  Padding="0"
						  Background="Transparent"
						  BorderThickness="0"
						  ToolTip="{DynamicResource Str.Panels.TipShowCompiled}"
						  IsChecked="{Binding ShowCompiled, Mode=TwoWay}">
				<ui:SymbolIcon Symbol="Box24" FontSize="14" />
			</ToggleButton>
		</Grid>

		<TreeView Grid.Row="1"
				  ItemsSource="{Binding Nodes}"
				  ItemContainerStyle="{StaticResource ProjectItemStyle}"
				  BorderThickness="0"
				  Background="Transparent"
				  PreviewMouseRightButtonDown="OnTreePreviewMouseRightButtonDown" />

		<StackPanel Grid.Row="1"
					VerticalAlignment="Top"
					Margin="16"
					Visibility="{Binding HasProject, Converter={StaticResource InvertedBoolToVisibility}}">
			<TextBlock Style="{StaticResource ShellCaptionTextStyle}"
					   Text="{DynamicResource Str.Panels.EmptyProject}"
					   TextAlignment="Center"
					   TextWrapping="Wrap" />
			<ui:Button Content="{DynamicResource Str.Panels.ChooseFolderButton}"
					   HorizontalAlignment="Center"
					   Margin="0,8,0,0"
					   Command="{Binding ChooseFolderCommand}" />
		</StackPanel>
	</Grid>
</UserControl>
