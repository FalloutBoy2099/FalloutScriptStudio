<UserControl
    x:Class="FalloutScriptStudio.Views.Panels.GlobalsPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:FalloutScriptStudio.ViewModels.Panels">

    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:TreeGroupNodeViewModel}" ItemsSource="{Binding Children}">
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                Text="{Binding Title}" />
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:GlobalVariableNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon
                    x:Name="Badge"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    ToolTip="{Binding FindingText}"
                    Visibility="Collapsed" />
                <ui:SymbolIcon
                    x:Name="Icon"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="BracesVariable24" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
                <TextBlock
                    Margin="6,0,0,0"
                    Style="{StaticResource ShellCaptionTextStyle}"
                    Text="{Binding AccessSymbol}" />
                <TextBlock
                    Margin="6,0,0,0"
                    Style="{StaticResource ShellCaptionTextStyle}"
                    Text="{Binding UseCount, StringFormat=({0})}" />
            </StackPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter TargetName="Badge" Property="Symbol" Value="Warning24" />
                    <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Info">
                    <Setter TargetName="Badge" Property="Symbol" Value="Info24" />
                    <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                    <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:GlobalUseNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
                <TextBlock
                    Margin="8,0,0,0"
                    Style="{StaticResource ShellCaptionTextStyle}"
                    Text="{Binding Procedure}" />
                <TextBlock
                    Margin="8,0,0,0"
                    Style="{StaticResource ShellCaptionTextStyle}"
                    Text="{Binding AccessText}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <Style
            x:Key="GlobalItemStyle"
            BasedOn="{StaticResource ShellTreeViewItemStyle}"
            TargetType="{x:Type TreeViewItem}">
            <Setter Property="Visibility" Value="{Binding IsFilterVisible, Converter={StaticResource BoolToVisibility}}" />
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="{DynamicResource Str.Panels.MenuGoTo}"
                            IsEnabled="{Binding PlacementTarget.DataContext.IsSymbol, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.FindAllCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="{DynamicResource Str.Panels.MenuGlobalsFindAll}"
                            IsEnabled="{Binding PlacementTarget.DataContext.IsSymbol, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.CopyNameCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="{DynamicResource Str.Panels.MenuGlobalsCopyName}"
                            IsEnabled="{Binding PlacementTarget.DataContext.IsSymbol, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.IgnoreCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="{DynamicResource Str.Panels.MenuGlobalsIgnore}"
                            IsEnabled="{Binding PlacementTarget.DataContext.IsSymbol, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <Separator />
                        <MenuItem Command="{Binding PlacementTarget.Tag.CheckCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Header="{DynamicResource Str.Panels.MenuGlobalsCheck}" />
                        <MenuItem Command="{Binding PlacementTarget.Tag.ExportCsvCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Header="{DynamicResource Str.Panels.MenuGlobalsExport}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseDoubleClick" Handler="OnItemMouseDoubleClick" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
                Grid.Column="0"
                Margin="6,4"
                AutomationProperties.Name="{DynamicResource Str.Panels.GlobalsFilterPlaceholder}"
                ClearButtonEnabled="True"
                PlaceholderText="{DynamicResource Str.Panels.GlobalsFilterPlaceholder}"
                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
            <StackPanel
                Grid.Column="1"
                Margin="0,0,4,0"
                Orientation="Horizontal">
                <ui:Button
                    Command="{Binding CheckCommand}"
                    Icon="{ui:SymbolIcon ShieldCheckmark24}"
                    Style="{StaticResource ShellSmallIconButtonStyle}"
                    ToolTip="{DynamicResource Str.Panels.TipGlobalsCheck}" />
                <ui:Button
                    Command="{Binding ExportCsvCommand}"
                    Icon="{ui:SymbolIcon ArrowExportUp24}"
                    Style="{StaticResource ShellSmallIconButtonStyle}"
                    ToolTip="{DynamicResource Str.Panels.TipGlobalsExport}" />
            </StackPanel>
        </Grid>

        <TextBlock
            Grid.Row="1"
            Margin="8,0,8,4"
            Style="{StaticResource ShellCaptionTextStyle}"
            Text="{Binding SummaryText}"
            TextTrimming="CharacterEllipsis"
            Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}" />

        <TreeView
            Grid.Row="2"
            AutomationProperties.Name="{DynamicResource Str.Panels.TabGlobals}"
            Background="Transparent"
            BorderThickness="0"
            ItemContainerStyle="{StaticResource GlobalItemStyle}"
            ItemsSource="{Binding Groups}"
            KeyDown="OnTreeKeyDown"
            PreviewMouseRightButtonDown="OnTreePreviewMouseRightButtonDown"
            VirtualizingStackPanel.IsVirtualizing="True" />
        <TextBlock
            Grid.Row="2"
            Margin="16"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Style="{StaticResource ShellCaptionTextStyle}"
            Text="{DynamicResource Str.Panels.EmptyGlobals}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{Binding HasData, Converter={StaticResource InvertedBoolToVisibility}}" />
    </Grid>

</UserControl>