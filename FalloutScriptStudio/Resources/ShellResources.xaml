<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a11y="clr-namespace:FalloutScriptStudio.Views.Accessibility"
    xmlns:conv="clr-namespace:FalloutScriptStudio.Resources.Converters"
    xmlns:panels="clr-namespace:FalloutScriptStudio.Views.Panels"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--  Converters  -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVisibility" />
    <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
    <conv:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsed" />
    <conv:DocumentKindToSymbolConverter x:Key="DocumentKindToSymbol" />
    <conv:ErrorTypeToSymbolConverter x:Key="ErrorTypeToSymbol" />
    <conv:ProjectNodeToSymbolConverter x:Key="ProjectNodeToSymbol" />
    <conv:PositiveNumberToVisibilityConverter x:Key="PositiveToVisibility" />

    <!--  Spacing and shape tokens  -->
    <CornerRadius x:Key="ShellCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ShellSmallCornerRadius">4</CornerRadius>
    <Thickness x:Key="ShellPagePadding">8</Thickness>
    <Thickness x:Key="ShellRowGap">0,0,0,8</Thickness>

    <!--  Every title bar names its minimize, maximize and close buttons for a screen reader  -->
    <Style BasedOn="{StaticResource {x:Type ui:TitleBar}}" TargetType="{x:Type ui:TitleBar}">
        <Setter Property="a11y:TitleBarNames.Localize" Value="True" />
    </Style>

    <!--  Every scroll bar names its arrows and the parts of its track for a screen reader  -->
    <Style BasedOn="{StaticResource {x:Type ScrollBar}}" TargetType="{x:Type ScrollBar}">
        <Setter Property="a11y:ScrollBarNames.Localize" Value="True" />
    </Style>

    <!--  Compact icon button used by the toolbar and the panel headers  -->
    <Style
        x:Key="ShellIconButtonStyle"
        BasedOn="{StaticResource {x:Type ui:Button}}"
        TargetType="{x:Type ui:Button}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="ShellSmallIconButtonStyle"
        BasedOn="{StaticResource ShellIconButtonStyle}"
        TargetType="{x:Type ui:Button}">
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
    </Style>

    <!--  Thin icon button (24 x 22, 12 px icon) for the toolbar of the log panel  -->
    <Style
        x:Key="ShellCompactIconButtonStyle"
        BasedOn="{StaticResource ShellIconButtonStyle}"
        TargetType="{x:Type ui:Button}">
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="22" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--  Thin column header (22 px, 11 px normal text) of the compact grids: the Errors tab and the results of the search window  -->
    <Style
        x:Key="ShellCompactColumnHeaderStyle"
        BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"
        TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Height" Value="22" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--  Counter toggle (icon and count): flat, only a light background when it is on  -->
    <Style x:Key="ShellCounterToggleStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="Chrome"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource ShellSmallCornerRadius}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Compact button with text used by the status bar  -->
    <Style
        x:Key="ShellStatusButtonStyle"
        BasedOn="{StaticResource {x:Type ui:Button}}"
        TargetType="{x:Type ui:Button}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  Status bar button that shows a text: the text is its name and the tool tip explains it  -->
    <Style
        x:Key="ShellStatusTextButtonStyle"
        BasedOn="{StaticResource {x:Type ui:Button}}"
        TargetType="{x:Type ui:Button}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  Icon toggle: the tool tip is also the accessible name  -->
    <Style
        x:Key="ShellIconToggleStyle"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="{x:Type ToggleButton}">
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!--  Arrow of a tab strip that scrolls: a flat icon button that is only there when the headers do not fit  -->
    <Style x:Key="ShellTabScrollButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Tab control whose headers stay on one row: when they do not fit (a narrow panel, a long translation) two arrows scroll them, and the selected tab is brought into view  -->
    <Style
        x:Key="ShellScrollingTabControlStyle"
        BasedOn="{StaticResource {x:Type TabControl}}"
        TargetType="{x:Type TabControl}">
        <Setter Property="panels:ScrollingTabs.BringSelectedIntoView" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <RepeatButton
                                Grid.Column="0"
                                AutomationProperties.Name="{DynamicResource Str.Panels.TabScrollLeft}"
                                Command="{x:Static ScrollBar.LineLeftCommand}"
                                CommandTarget="{Binding ElementName=HeaderScroller}"
                                Style="{StaticResource ShellTabScrollButtonStyle}"
                                ToolTip="{DynamicResource Str.Panels.TabScrollLeft}"
                                Visibility="{Binding ScrollableWidth, ElementName=HeaderScroller, Converter={StaticResource PositiveToVisibility}}">
                                <ui:SymbolIcon FontSize="12" Symbol="CaretLeft24" />
                            </RepeatButton>
                            <ScrollViewer
                                x:Name="HeaderScroller"
                                Grid.Column="1"
                                CanContentScroll="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Disabled">
                                <StackPanel
                                    x:Name="HeaderPanel"
                                    IsItemsHost="True"
                                    KeyboardNavigation.TabIndex="1"
                                    Orientation="Horizontal" />
                            </ScrollViewer>
                            <RepeatButton
                                Grid.Column="2"
                                AutomationProperties.Name="{DynamicResource Str.Panels.TabScrollRight}"
                                Command="{x:Static ScrollBar.LineRightCommand}"
                                CommandTarget="{Binding ElementName=HeaderScroller}"
                                Style="{StaticResource ShellTabScrollButtonStyle}"
                                ToolTip="{DynamicResource Str.Panels.TabScrollRight}"
                                Visibility="{Binding ScrollableWidth, ElementName=HeaderScroller, Converter={StaticResource PositiveToVisibility}}">
                                <ui:SymbolIcon FontSize="12" Symbol="CaretRight24" />
                            </RepeatButton>
                        </Grid>
                        <ContentPresenter
                            x:Name="PART_SelectedContentHost"
                            Grid.Row="1"
                            Margin="{TemplateBinding Padding}"
                            ContentSource="SelectedContent"
                            KeyboardNavigation.DirectionalNavigation="Contained"
                            KeyboardNavigation.TabIndex="2"
                            KeyboardNavigation.TabNavigation="Local" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShellToolbarSeparatorStyle" TargetType="{x:Type Rectangle}">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Fill" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!--  Tree view items bound to view models with IsExpanded / IsSelected  -->
    <Style
        x:Key="ShellTreeViewItemStyle"
        BasedOn="{StaticResource {x:Type TreeViewItem}}"
        TargetType="{x:Type TreeViewItem}">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--  Muted caption text  -->
    <Style x:Key="ShellCaptionTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Log text  -->
    <Style
        x:Key="ShellLogTextBoxStyle"
        BasedOn="{StaticResource {x:Type TextBox}}"
        TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <!--  Title of a top-level menu: WPF-UI draws it larger than the drop-down items and ignores FontSize here, so the size is set on the text itself  -->
    <DataTemplate x:Key="ShellMenuBarHeaderTemplate">
        <AccessText FontSize="12" Text="{Binding}" />
    </DataTemplate>
</ResourceDictionary>