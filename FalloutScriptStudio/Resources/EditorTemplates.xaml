<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="clr-namespace:FalloutScriptStudio.Documents"
    xmlns:editor="clr-namespace:FalloutScriptStudio.Views.Editor">

    <!--  A document is shown by the editor view written by the editor module.  -->
    <DataTemplate DataType="{x:Type docs:DocumentViewModel}">
        <editor:ScriptEditorView />
    </DataTemplate>
</ResourceDictionary>
