	<sys:String x:Key="Str.ToolWindows.Opt.ShortCircuit.Title">Zkrácené vyhodnocování</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.ShortCircuit.Desc">Pravá strana výrazů AND a OR se nevyhodnocuje, pokud je výsledek již znám. (X and Y): je-li X nepravda, Y se přeskočí. (X or Y): je-li X pravda, Y se přeskočí.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.Backward.Title">Použít zpětně kompatibilní režim</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.Backward.Desc">Přepne kompilátor sfall do režimu zpětné kompatibility s kompilátorem BIS. Umožňuje kompilovat staré skripty (bez funkcí sfall) bez jejich úprav.</sys:String>
