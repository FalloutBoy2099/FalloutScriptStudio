    <sys:String x:Key="Str.ToolWindows.Opt.ParserEnabled.Title">Zapnuto</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ParserEnabled.Desc">Spustí parser skriptů. Poskytuje funkce Najít deklaraci, Najít odkazy a podobné a boční panel s globálními proměnnými a procedurami.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ParserWarnings.Title">Upozornění</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ParserWarnings.Desc">Zobrazí upozornění parseru.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Preprocessor.Title">Preprocesor</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Preprocessor.Desc">Preprocesor spouštěný před kompilátorem.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.UseBatch.Title">Ke kompilaci použít dávkový soubor</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.UseBatch.Desc">Kompiluje skripty pomocí uživatelského dávkového souboru usercomp.bat.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Optimization.Title">Optimalizace</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Optimization.Desc">Žádná: bez optimalizace. Základní: odstraní nepoužívané procedury a proměnné. Úplná: skládání konstant, odstranění mrtvého kódu, slučování proměnných. Experimentální: ještě důkladnější optimalizace (opětovné použití proměnných, šíření konstant); v některých případech poškodí kód, použijte raději Úplnou.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.CompilerWarnings.Title">Upozornění</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.CompilerWarnings.Desc">Zobrazí upozornění kompilátoru a preprocesoru.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Debug.Title">Ladění</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Debug.Desc">Při kompilaci skriptu zobrazí další ladicí informace o optimalizaci.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShortCircuit.Title">Zkrácené vyhodnocování</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShortCircuit.Desc">Pravá strana výrazů AND a OR se nevyhodnocuje, pokud je výsledek již znám. (X and Y): je-li X nepravda, Y se přeskočí. (X or Y): je-li X pravda, Y se přeskočí.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Backward.Title">Použít zpětně kompatibilní režim</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Backward.Desc">Přepne kompilátor sfall do režimu zpětné kompatibility s kompilátorem BIS. Umožňuje kompilovat staré skripty (bez funkcí sfall) bez jejich úprav.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SearchIncludes.Title">Hledat vložené soubory</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SearchIncludes.Desc">Požadované hlavičkové soubory navíc hledá ve složce s hlavičkami.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.CompileNextToSource.Title">Kompilovat vedle zdrojového souboru</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.CompileNextToSource.Desc">Zapíše zkompilovaný skript do složky souboru .ssl místo výstupní složky.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowErrorLog.Title">Zobrazit protokol chyb při selhání</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowErrorLog.Desc">Přenese protokol chyb do popředí, když se skript nepodaří zkompilovat.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.MultiThread.Title">Vícevláknová hromadná kompilace</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.MultiThread.Desc">Při kompilaci mnoha skriptů najednou použije více vláken.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ListUpToDate.Title">Vypisovat aktuální skripty</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ListUpToDate.Desc">Protokol sestavení uvádí jméno každého skriptu, který byl přeskočen, protože je aktuální, nejen jejich počet.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Decompiler.Title">Dekompilátor</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Decompiler.Desc">Program, který převádí zkompilované skripty .int zpět na zdrojový kód. Vestavěný dekompilátor nepotřebuje nic dalšího; externí spouští int2ssl.exe.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ExternalDecompiler.Title">Externí dekompilátor</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ExternalDecompiler.Desc">Soubor int2ssl.exe ke spuštění. Pokud je prázdné, hledá se ve složce resources editoru.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.DecompileF1.Title">Dekompilovat pro Fallout 1</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.DecompileF1.Desc">Vytvoří kód pro skripty Falloutu 1.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.OldDecompiler.Title">Použít starý dekompilátor</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.OldDecompiler.Desc">Pouze externí dekompilátor: použije starou verzi int2ssl_v35.exe místo int2ssl.exe.</sys:String>
