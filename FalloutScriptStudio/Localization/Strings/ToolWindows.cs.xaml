    <sys:String x:Key="Str.ToolWindows.Section.PreprocessorDefines">Definice preprocesoru</sys:String>
    <sys:String x:Key="Str.ToolWindows.Section.CompileProfiles">Profily kompilace</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Help">Profil je pojmenovaná sada voleb kompilátoru. Aktivní profil, vybraný na panelu nástrojů, se použije nad výše uvedenými volbami a mění jen ty volby, které nastavuje. Při změně profilu se skripty zkompilují znovu.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.NewName">Nový profil</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Add">Přidat profil</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Delete">Odstranit profil</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Name">Název profilu</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Empty">Přidejte profil, abyste mohli upravit jeho volby.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Define">Definice preprocesoru</sys:String>
    <sys:String x:Key="Str.ToolWindows.PreprocessorDefines.Help">Definice nabízené na panelu nástrojů vedle tlačítek kompilace (pro direktivy #if). DEBUG a RELEASE jsou k dispozici vždy; vlastní definice přidejte sem.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Placeholder.NewDefine">Nová definice</sys:String>
