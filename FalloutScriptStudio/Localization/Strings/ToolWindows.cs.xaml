    <sys:String x:Key="Str.ToolWindows.Btn.DeleteDefine">_Odebrat</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ExternalEditor.Title">Externí editor</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ExternalEditor.Desc">Program použitý příkazem „Otevřít v externím editoru“. Je-li prázdné, budete o něj požádáni při prvním použití.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.SelectExternalEditor">Vyberte externí editor</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TabsToSpaces.Title">Převádět tabulátory na mezery</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TabsToSpaces.Desc">Při stisku klávesy Tab vloží mezery místo znaku tabulátoru. Počet mezer se nastavuje níže.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TabSize.Title">Velikost tabulátoru/odsazení v mezerách</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TabSize.Desc">Počet mezer, které nahrazují znak tabulátoru.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Autocomplete.Title">Automatické dokončování</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Autocomplete.Desc">Při psaní zobrazuje seznam názvů procedur, proměnných, konstant a maker. Seznam otevřete stisknutím Alt+Mezerník. Projeví se po restartu.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ColoredCompletion.Title">Barevný seznam dokončování</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ColoredCompletion.Desc">Použije barvy pro slova v seznamu automatického dokončování.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.PairedChars.Title">Vkládat párové závorky</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.PairedChars.Desc">Automaticky napíše uzavírací závorku nebo uvozovku.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TrimSpaces.Title">Odstraňovat mezery na konci řádků</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TrimSpaces.Desc">Při uložení souboru odstraní mezery na konci každého řádku.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowTips.Title">Zobrazit nápovědu</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowTips.Desc">Po napsání otevírací závorky zobrazí nápovědu k funkcím a kódu. Projeví se po restartu.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShortDescriptions.Title">Krátké popisy</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShortDescriptions.Desc">Zobrazí krátkou nápovědu k operačním kódům. Projeví se po restartu.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveCaret.Title">Ukládat pozici kurzoru</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveCaret.Desc">Zapamatuje si pozici kurzoru při zavření skriptu a obnoví ji při dalším otevření.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Encoding.Title">Kódování skriptů a souborů zpráv</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Encoding.Desc">Znaková sada používaná ke čtení a zápisu skriptů a souborů zpráv.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveUtf8.Title">Ukládat skripty jako UTF-8</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveUtf8.Desc">Zapisuje skripty v UTF-8 místo výše zvoleného kódování.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.FileAssociation">Přidružení souborů</sys:String>
    <sys:String x:Key="Str.ToolWindows.Btn.Associate">_Přidružit</sys:String>
    <sys:String x:Key="Str.ToolWindows.Tip.Associate">Přidružit soubory SSL, INT, MSG a FCD k editoru.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociationYes">Editor je výchozím programem pro soubory .ssl, .int, .msg a .fcd.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociationNo">Editor není přidružen k souborům .ssl, .int, .msg a .fcd.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociateQuestion">Přidružit soubory .ssl, .int, .msg a .fcd k aplikaci Fallout Script Studio?</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociateFailed">Typy souborů se nepodařilo přidružit: {0}</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociateDone">Typy souborů byly přidruženy k aplikaci Fallout Script Studio.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.SaveFailed" xml:space="preserve">Nastavení byla použita, ale nepodařilo se je uložit: {0}&#10;Zkontrolujte, že do složky nastavení lze zapisovat a že disk není plný.</sys:String>
