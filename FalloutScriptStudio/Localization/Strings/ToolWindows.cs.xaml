	<sys:String x:Key="Str.ToolWindows.Opt.ParserEnabled.Desc">Spustí analyzátor skriptů. Poskytuje funkce Najít deklaraci, Najít odkazy a podobné a boční panel s globálními proměnnými a procedurami.</sys:String>
