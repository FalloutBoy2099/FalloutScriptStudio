	<sys:String x:Key="Str.ToolWindows.Opt.ParserEnabled.Title">Activado</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.ParserEnabled.Desc">Ejecuta el analizador de scripts. Proporciona Buscar declaración, Buscar referencias y funciones similares, y el panel lateral con variables globales y procedimientos.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.ParserWarnings.Title">Advertencias</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.ParserWarnings.Desc">Muestra las advertencias del analizador.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.Preprocessor.Title">Preprocesador</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.Preprocessor.Desc">El preprocesador que se ejecuta antes del compilador.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.UseBatch.Title">Usar archivo por lotes para compilar</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.UseBatch.Desc">Compila los scripts con el archivo por lotes del usuario usercomp.bat.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.Optimization.Title">Optimización</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.Optimization.Desc">Ninguna: sin optimización. Básica: elimina procedimientos y variables sin referencias. Completa: plegado de constantes, eliminación de código muerto, fusión de variables. Experimental: aún más optimización (reutilización de variables, propagación de constantes); en algunos casos rompe el código, use Completa en su lugar.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.CompilerWarnings.Title">Advertencias</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.CompilerWarnings.Desc">Muestra los mensajes de advertencia del compilador y del preprocesador.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.Debug.Title">Depuración</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.Debug.Desc">Muestra información de depuración adicional sobre la optimización al compilar un script.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.ShortCircuit.Title">Evaluación en cortocircuito</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.ShortCircuit.Desc">El lado derecho de las expresiones AND y OR no se evalúa cuando el resultado ya se conoce. (X and Y): si X es falso, se omite Y. (X or Y): si X es verdadero, se omite Y.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.Backward.Title">Usar modo de compatibilidad</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.Backward.Desc">Cambia el compilador de sfall al modo de compatibilidad con el compilador de BIS. Esto permite compilar scripts antiguos (sin funciones de sfall) sin editarlos.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.SearchIncludes.Title">Buscar includes</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.SearchIncludes.Desc">Busca además en la carpeta de encabezados los archivos de encabezado necesarios.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.CompileNextToSource.Title">Compilar junto al archivo de origen</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.CompileNextToSource.Desc">Escribe el script compilado en la carpeta del archivo .ssl en lugar de la carpeta de salida.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.ShowErrorLog.Title">Mostrar el registro de errores si falla</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.ShowErrorLog.Desc">Trae el registro de errores al frente cuando un script no se puede compilar.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.MultiThread.Title">Compilación masiva multihilo</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.MultiThread.Desc">Usa varios hilos cuando se compilan muchos scripts a la vez.</sys:String>
