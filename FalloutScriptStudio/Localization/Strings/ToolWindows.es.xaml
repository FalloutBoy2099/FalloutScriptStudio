    <sys:String x:Key="Str.ToolWindows.Opt.TabsToSpaces.Title">Convertir tabulaciones en espacios</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TabsToSpaces.Desc">Inserta espacios en lugar de un carácter de tabulación al pulsar la tecla Tab. El número de espacios se define abajo.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TabSize.Title">Tamaño de tabulación/sangría en espacios</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TabSize.Desc">El número de espacios que sustituyen a un carácter de tabulación.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Autocomplete.Title">Autocompletar</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Autocomplete.Desc">Muestra una lista de nombres de procedimientos, variables, constantes y macros mientras se escribe. Pulse Alt+Espacio para abrir la lista. Se aplica tras reiniciar.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ColoredCompletion.Title">Lista de autocompletado en color</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ColoredCompletion.Desc">Usa colores para las palabras de la lista de autocompletado.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.PairedChars.Title">Insertar paréntesis emparejados</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.PairedChars.Desc">Escribe automáticamente el corchete o la comilla de cierre.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TrimSpaces.Title">Quitar espacios finales</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TrimSpaces.Desc">Quita los espacios finales de cada línea al guardar un archivo.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowTips.Title">Mostrar sugerencias</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowTips.Desc">Muestra información sobre herramientas de funciones y código al escribir un paréntesis de apertura. Se aplica tras reiniciar.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShortDescriptions.Title">Descripciones breves</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShortDescriptions.Desc">Muestra información breve sobre herramientas para los opcodes. Se aplica tras reiniciar.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveCaret.Title">Guardar posición del cursor</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveCaret.Desc">Recuerda la posición del cursor al cerrar un script y la restaura la próxima vez que se abra.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Encoding.Title">Codificación de scripts y archivos de mensajes</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Encoding.Desc">La página de códigos usada para leer y escribir scripts y archivos de mensajes.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveUtf8.Title">Guardar scripts como UTF-8</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveUtf8.Desc">Escribe los scripts en UTF-8 en lugar de la codificación elegida arriba.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.FileAssociation">Asociación de archivos</sys:String>
    <sys:String x:Key="Str.ToolWindows.Btn.Associate">A_sociar</sys:String>
    <sys:String x:Key="Str.ToolWindows.Tip.Associate">Asocia los archivos SSL, INT, MSG y FCD con el editor.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociationYes">El editor es el programa predeterminado para los archivos .ssl, .int, .msg y .fcd.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociationNo">El editor no está asociado con los archivos .ssl, .int, .msg y .fcd.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociateQuestion">¿Asociar los archivos .ssl, .int, .msg y .fcd con Fallout Script Studio?</sys:String>
