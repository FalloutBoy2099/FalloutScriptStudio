    <sys:String x:Key="Str.ToolWindows.Opt.ShowWhitespace.Title">Mostra tabulazioni e spazi</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowWhitespace.Desc">Disegna segni visibili per i caratteri di tabulazione e spazio.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.VerticalRuler.Title">Mostra linea verticale</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.VerticalRuler.Desc">Disegna la linea del righello verticale nell'editor.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Section.PreprocessorDefines">Definizioni del preprocessore</sys:String>
    <sys:String x:Key="Str.ToolWindows.Section.CompileProfiles">Profili di compilazione</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Help">Un profilo è un insieme di opzioni del compilatore con nome. Il profilo attivo, scelto nella barra degli strumenti, si applica sopra le opzioni precedenti e modifica solo le opzioni che imposta. Gli script vengono compilati di nuovo quando il profilo cambia.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.NewName">Nuovo profilo</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Add">Aggiungi profilo</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Delete">Elimina profilo</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Name">Nome del profilo</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Empty">Aggiungi un profilo per modificarne le opzioni.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Define">Definizione del preprocessore</sys:String>
    <sys:String x:Key="Str.ToolWindows.PreprocessorDefines.Help">Definizioni proposte nella barra degli strumenti accanto ai pulsanti di compilazione (per le direttive #if). DEBUG e RELEASE sono sempre disponibili; aggiungi qui le tue.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Placeholder.NewDefine">Nuova definizione</sys:String>
