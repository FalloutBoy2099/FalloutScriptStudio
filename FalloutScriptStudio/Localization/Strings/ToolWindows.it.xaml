    <sys:String x:Key="Str.ToolWindows.Opt.EditorFont.Title">Carattere dell'editor</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.EditorFont.Desc">Il carattere dell'editor di script. I caratteri aggiuntivi vengono caricati dalla cartella resources\fonts.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.FontSize.Title">Regolazione della dimensione del carattere</sys:String>
