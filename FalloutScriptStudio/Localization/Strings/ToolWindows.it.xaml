    <sys:String x:Key="Str.ToolWindows.Opt.CompileNextToSource.Desc">Scrive lo script compilato nella cartella del file .ssl invece che nella cartella di output.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowErrorLog.Title">Mostra il log degli errori in caso di errore</sys:String>
