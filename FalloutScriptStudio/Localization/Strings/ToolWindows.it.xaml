    <sys:String x:Key="Str.ToolWindows.Opt.ParserEnabled.Title">Attivato</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ParserEnabled.Desc">Esegue il parser degli script. Fornisce Trova dichiarazione, Trova riferimenti e funzioni simili, oltre al pannello laterale con variabili globali e procedure.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ParserWarnings.Title">Avvisi</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ParserWarnings.Desc">Mostra gli avvisi del parser.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Preprocessor.Title">Preprocessore</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Preprocessor.Desc">Il preprocessore eseguito prima del compilatore.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.UseBatch.Title">Usa un file batch per compilare</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.UseBatch.Desc">Compila gli script con il file batch utente usercomp.bat.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Optimization.Title">Ottimizzazione</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Optimization.Desc">Nessuna: nessuna ottimizzazione. Base: rimuove procedure e variabili non referenziate. Completa: riduzione delle costanti, rimozione del codice morto, unione delle variabili. Sperimentale: ottimizzazione ancora maggiore (riuso delle variabili, propagazione delle costanti); in alcuni casi rompe il codice, usa invece Completa.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.CompilerWarnings.Title">Avvisi</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.CompilerWarnings.Desc">Mostra i messaggi di avviso del compilatore e del preprocessore.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Debug.Title">Debug</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Debug.Desc">Mostra informazioni di debug aggiuntive sull'ottimizzazione durante la compilazione di uno script.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShortCircuit.Title">Valutazione in corto circuito</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShortCircuit.Desc">La parte destra delle espressioni AND e OR non viene valutata quando il risultato è già noto. (X and Y): se X è falso, Y viene saltato. (X or Y): se X è vero, Y viene saltato.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Backward.Title">Usa la modalità di compatibilità</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Backward.Desc">Imposta il compilatore sfall in compatibilità con il compilatore BIS. Questo permette di compilare vecchi script (senza funzioni sfall) senza modificarli.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SearchIncludes.Title">Cerca i file inclusi</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SearchIncludes.Desc">Cerca inoltre nella cartella delle intestazioni i file di intestazione richiesti.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.CompileNextToSource.Title">Compila accanto al file sorgente</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.CompileNextToSource.Desc">Scrive lo script compilato nella cartella del file .ssl invece che nella cartella di output.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowErrorLog.Title">Mostra il registro degli errori in caso di errore</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowErrorLog.Desc">Porta in primo piano il registro degli errori quando uno script non viene compilato.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.MultiThread.Title">Compilazione di massa multithread</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.MultiThread.Desc">Usa più thread quando vengono compilati molti script contemporaneamente.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ListUpToDate.Title">Elenca gli script aggiornati</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ListUpToDate.Desc">Il registro di compilazione indica ogni script saltato perché aggiornato, non solo il loro numero.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Decompiler.Title">Decompilatore</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Decompiler.Desc">Il programma che riconverte gli script .int compilati in codice sorgente. Il decompilatore integrato non richiede nient'altro; quello esterno esegue int2ssl.exe.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ExternalDecompiler.Title">Decompilatore esterno</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ExternalDecompiler.Desc">L'int2ssl.exe da eseguire. Se vuoto, viene cercato nella cartella resources dell'editor.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.DecompileF1.Title">Decompila per Fallout 1</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.DecompileF1.Desc">Produce codice per gli script di Fallout 1.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.OldDecompiler.Title">Usa il vecchio decompilatore</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.OldDecompiler.Desc">Solo decompilatore esterno: usa int2ssl_v35.exe, la vecchia versione, invece di int2ssl.exe.</sys:String>
