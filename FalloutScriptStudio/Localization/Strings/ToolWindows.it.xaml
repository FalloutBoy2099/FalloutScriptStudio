    <sys:String x:Key="Str.ToolWindows.Opt.Autocomplete.Title">Completamento automatico</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Autocomplete.Desc">Mostra un elenco di nomi di procedure, variabili, costanti e macro durante la digitazione. Premi Alt+Spazio per aprire l'elenco. Ha effetto dopo il riavvio.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ColoredCompletion.Title">Elenco di completamento colorato</sys:String>
