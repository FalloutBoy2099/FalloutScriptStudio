    <sys:String x:Key="Str.ToolWindows.Opt.SaveUtf8.Title">将脚本保存为 UTF-8</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveUtf8.Desc">以 UTF-8 而不是上面选择的编码写入脚本。</sys:String>
