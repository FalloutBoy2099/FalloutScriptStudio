    <sys:String x:Key="Str.ToolWindows.Opt.MsgLanguage.Desc">A pasta de idioma dos arquivos de mensagens, 'english' por padrão.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.OpenMsg.Title">Abrir arquivo de mensagens</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.OpenMsg.Desc">Abre automaticamente o arquivo de mensagens associado (se existir) ao abrir um script.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.OpenEditor.Title">Abrir o editor de mensagens automaticamente</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.OpenEditor.Desc">Abre o editor de mensagens junto com um script que tem um arquivo de mensagens.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.AssocById.Title">Associar por ID</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.AssocById.Desc">Associa os arquivos de mensagens pelo número do script em vez do nome do arquivo do script. Requer o arquivo Scripts.lst para ler os números dos scripts.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.HighlightComments.Title">Realçar linhas de comentário</sys:String>
