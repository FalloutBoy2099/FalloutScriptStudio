    <sys:String x:Key="Str.ToolWindows.Section.PreprocessorDefines">Definições do pré-processador</sys:String>
    <sys:String x:Key="Str.ToolWindows.Section.CompileProfiles">Perfis de compilação</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Help">Um perfil é um conjunto nomeado de opções do compilador. O perfil ativo, escolhido na barra de ferramentas, é aplicado sobre as opções acima e altera apenas as opções que define. Os scripts são compilados novamente quando o perfil muda.</sys:String>
