    <sys:String x:Key="Str.ToolWindows.Opt.TabsToSpaces.Title">Converter tabulações em espaços</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TabsToSpaces.Desc">Insere espaços em vez de um caractere de tabulação ao pressionar a tecla Tab. O número de espaços é definido abaixo.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TabSize.Title">Tamanho da tabulação/recuo em espaços</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TabSize.Desc">O número de espaços que substituem um caractere de tabulação.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Autocomplete.Title">Preenchimento automático</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Autocomplete.Desc">Mostra uma lista de nomes de procedimentos, variáveis, constantes e macros durante a digitação. Pressione Alt+Espaço para abrir a lista. Entra em vigor após reiniciar.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ColoredCompletion.Title">Lista de preenchimento colorida</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ColoredCompletion.Desc">Usa cores para as palavras na lista de preenchimento automático.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.PairedChars.Title">Inserir parênteses em pares</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.PairedChars.Desc">Digita automaticamente o colchete ou a aspa de fechamento.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TrimSpaces.Title">Remover espaços no final</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TrimSpaces.Desc">Remove os espaços no final de cada linha ao salvar um arquivo.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowTips.Title">Mostrar dicas</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowTips.Desc">Mostra dicas de funções e código ao digitar um parêntese de abertura. Entra em vigor após reiniciar.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShortDescriptions.Title">Descrições curtas</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShortDescriptions.Desc">Mostra dicas curtas para opcodes. Entra em vigor após reiniciar.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveCaret.Title">Salvar posição do cursor</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveCaret.Desc">Lembra a posição do cursor ao fechar um script e a restaura na próxima vez que ele for aberto.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Encoding.Title">Codificação de scripts e arquivos de mensagens</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Encoding.Desc">A página de código usada para ler e gravar scripts e arquivos de mensagens.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveUtf8.Title">Salvar scripts como UTF-8</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveUtf8.Desc">Grava os scripts em UTF-8 em vez da codificação escolhida acima.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.FileAssociation">Associação de arquivos</sys:String>
    <sys:String x:Key="Str.ToolWindows.Btn.Associate">Associar</sys:String>
    <sys:String x:Key="Str.ToolWindows.Tip.Associate">Associa os arquivos SSL, INT, MSG e FCD ao editor.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociationYes">O editor é o programa padrão para arquivos .ssl, .int, .msg e .fcd.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociationNo">O editor não está registrado para arquivos .ssl, .int, .msg e .fcd.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociateQuestion">Associar os arquivos .ssl, .int, .msg e .fcd ao Fallout Script Studio?</sys:String>
