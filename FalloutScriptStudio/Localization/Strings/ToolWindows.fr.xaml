	<sys:String x:Key="Str.ToolWindows.Opt.OpenMsg.Title">Ouvrir le fichier de messages</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.OpenMsg.Desc">Ouvre automatiquement le fichier de messages associé (s'il existe) à l'ouverture d'un script.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.OpenEditor.Title">Ouvrir automatiquement l'éditeur de messages</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.OpenEditor.Desc">Ouvre l'éditeur de messages avec un script qui possède un fichier de messages.</sys:String>
