    <sys:String x:Key="Str.ToolWindows.Profiles.Empty">Ajoutez un profil pour modifier ses options.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Define">Définition du préprocesseur</sys:String>
    <sys:String x:Key="Str.ToolWindows.PreprocessorDefines.Help">Définitions proposées dans la barre d'outils à côté des boutons de compilation (pour les directives #if). DEBUG et RELEASE sont toujours disponibles ; ajoutez les vôtres ici.</sys:String>
