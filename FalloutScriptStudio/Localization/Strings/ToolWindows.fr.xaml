	<sys:String x:Key="Str.ToolWindows.Opt.Autocomplete.Title">Saisie semi-automatique</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.Autocomplete.Desc">Affiche une liste de noms de procédures, de variables, de constantes et de macros pendant la saisie. Appuyez sur Alt+Espace pour ouvrir la liste. Pris en compte après un redémarrage.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.ColoredCompletion.Title">Liste de saisie semi-automatique colorée</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.ColoredCompletion.Desc">Utilise des couleurs pour les mots de la liste de saisie semi-automatique.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.PairedChars.Title">Insérer les parenthèses par paire</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.PairedChars.Desc">Saisit automatiquement la parenthèse ou le guillemet fermant.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.TrimSpaces.Title">Supprimer les espaces en fin de ligne</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.TrimSpaces.Desc">Supprime les espaces en fin de ligne à chaque enregistrement d'un fichier.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.ShowTips.Title">Afficher les info-bulles</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.ShowTips.Desc">Affiche des info-bulles pour les fonctions et le code lorsqu'une parenthèse ouvrante est saisie. Pris en compte après un redémarrage.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.ShortDescriptions.Title">Descriptions courtes</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.ShortDescriptions.Desc">Affiche de courtes info-bulles pour les opcodes. Pris en compte après un redémarrage.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.SaveCaret.Title">Mémoriser la position du curseur</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.SaveCaret.Desc">Mémorise la position du curseur à la fermeture d'un script et la rétablit à sa prochaine ouverture.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.Encoding.Title">Encodage des scripts et des fichiers de messages</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.Encoding.Desc">La page de codes utilisée pour lire et écrire les scripts et les fichiers de messages.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.SaveUtf8.Title">Enregistrer les scripts en UTF-8</sys:String>
	<sys:String x:Key="Str.ToolWindows.Opt.SaveUtf8.Desc">Écrit les scripts en UTF-8 au lieu de l'encodage choisi ci-dessus.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Settings.FileAssociation">Association de fichiers</sys:String>
	<sys:String x:Key="Str.ToolWindows.Btn.Associate">Associer</sys:String>
	<sys:String x:Key="Str.ToolWindows.Tip.Associate">Associe les fichiers SSL, INT, MSG et FCD à l'éditeur.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Settings.AssociationYes">L'éditeur est le programme par défaut pour les fichiers .ssl, .int, .msg et .fcd.</sys:String>
	<sys:String x:Key="Str.ToolWindows.Settings.AssociationNo">L'éditeur n'est pas enregistré pour les fichiers .ssl, .int, .msg et .fcd.</sys:String>
