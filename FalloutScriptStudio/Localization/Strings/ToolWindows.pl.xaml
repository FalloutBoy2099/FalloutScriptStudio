    <sys:String x:Key="Str.ToolWindows.Opt.ParserEnabled.Title">Włączony</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ParserEnabled.Desc">Uruchamia parser skryptów. Udostępnia funkcje „Znajdź deklarację”, „Znajdź odwołania” i podobne oraz panel boczny ze zmiennymi globalnymi i procedurami.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ParserWarnings.Title">Ostrzeżenia</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ParserWarnings.Desc">Wyświetla ostrzeżenia parsera.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Preprocessor.Title">Preprocesor</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Preprocessor.Desc">Preprocesor uruchamiany przed kompilatorem.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.UseBatch.Title">Użyj pliku wsadowego do kompilacji</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.UseBatch.Desc">Kompiluje skrypty za pomocą pliku wsadowego użytkownika usercomp.bat.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Optimization.Title">Optymalizacja</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Optimization.Desc">Brak: bez optymalizacji. Podstawowa: usuwa nieużywane procedury i zmienne. Pełna: składanie stałych, usuwanie martwego kodu, scalanie zmiennych. Eksperymentalna: jeszcze większa optymalizacja (ponowne użycie zmiennych, propagacja stałych); w niektórych przypadkach psuje kod, zamiast tego użyj opcji Pełna.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.CompilerWarnings.Title">Ostrzeżenia</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.CompilerWarnings.Desc">Wyświetla ostrzeżenia kompilatora i preprocesora.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Debug.Title">Debugowanie</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Debug.Desc">Wyświetla dodatkowe informacje diagnostyczne o optymalizacji podczas kompilacji skryptu.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShortCircuit.Title">Skrócone obliczanie</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShortCircuit.Desc">Prawa strona wyrażeń AND i OR nie jest obliczana, gdy wynik jest już znany. (X and Y): jeśli X jest fałszem, Y jest pomijane. (X or Y): jeśli X jest prawdą, Y jest pomijane.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Backward.Title">Użyj trybu wstecznej zgodności</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Backward.Desc">Przełącza kompilator sfall w tryb zgodności wstecznej z kompilatorem BIS. Pozwala to kompilować stare skrypty (bez funkcji sfall) bez ich edycji.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SearchIncludes.Title">Przeszukuj pliki include</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SearchIncludes.Desc">Dodatkowo przeszukuje folder plików nagłówkowych w poszukiwaniu wymaganych plików.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.CompileNextToSource.Title">Kompiluj obok pliku źródłowego</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.CompileNextToSource.Desc">Zapisuje skompilowany skrypt w folderze pliku .ssl zamiast w folderze wyjściowym.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowErrorLog.Title">Pokaż dziennik błędów po niepowodzeniu</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowErrorLog.Desc">Wyświetla dziennik błędów na wierzchu, gdy kompilacja skryptu się nie powiedzie.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.MultiThread.Title">Wielowątkowa kompilacja zbiorcza</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.MultiThread.Desc">Używa wielu wątków, gdy kompilowanych jest naraz wiele skryptów.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Decompiler.Title">Dekompilator</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Decompiler.Desc">Program zamieniający skompilowane skrypty .int z powrotem na kod źródłowy. Wbudowany dekompilator niczego więcej nie wymaga; zewnętrzny uruchamia int2ssl.exe.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ExternalDecompiler.Title">Zewnętrzny dekompilator</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ExternalDecompiler.Desc">Plik int2ssl.exe do uruchomienia. Jeśli pole jest puste, przeszukiwany jest folder resources edytora.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.DecompileF1.Title">Dekompiluj dla Fallouta 1</sys:String>
