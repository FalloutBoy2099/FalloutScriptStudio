    <sys:String x:Key="Str.ToolWindows.Section.PreprocessorDefines">Definicje preprocesora</sys:String>
    <sys:String x:Key="Str.ToolWindows.Section.CompileProfiles">Profile kompilacji</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Help">Profil to nazwany zestaw opcji kompilatora. Aktywny profil, wybrany na pasku narzędzi, jest stosowany na powyższych opcjach i zmienia tylko te opcje, które ustawia. Gdy profil się zmieni, skrypty są kompilowane ponownie.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.NewName">Nowy profil</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Add">Dodaj profil</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Delete">Usuń profil</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Name">Nazwa profilu</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Empty">Dodaj profil, aby edytować jego opcje.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Profiles.Define">Definicja preprocesora</sys:String>
    <sys:String x:Key="Str.ToolWindows.PreprocessorDefines.Help">Definicje dostępne na pasku narzędzi obok przycisków kompilacji (dla dyrektyw #if). DEBUG i RELEASE są zawsze dostępne; własne definicje dodaj tutaj.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Placeholder.NewDefine">Nowa definicja</sys:String>
    <sys:String x:Key="Str.ToolWindows.Btn.AddDefine">_Dodaj</sys:String>
    <sys:String x:Key="Str.ToolWindows.Btn.DeleteDefine">U_suń</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ExternalEditor.Title">Edytor zewnętrzny</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ExternalEditor.Desc">Program używany przez polecenie „Otwórz w edytorze zewnętrznym”. Jeśli puste, zostanie wyświetlone pytanie przy pierwszym użyciu.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.SelectExternalEditor">Wybierz edytor zewnętrzny</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TabsToSpaces.Title">Zamieniaj tabulatory na spacje</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TabsToSpaces.Desc">Wstawia spacje zamiast znaku tabulacji po naciśnięciu klawisza Tab. Liczbę spacji ustawia się poniżej.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TabSize.Title">Rozmiar tabulatora/wcięcia w spacjach</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TabSize.Desc">Liczba spacji zastępujących znak tabulacji.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Autocomplete.Title">Autouzupełnianie</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Autocomplete.Desc">Wyświetla listę nazw procedur, zmiennych, stałych i makr podczas pisania. Naciśnij Alt+Spacja, aby otworzyć listę. Zmiana zadziała po ponownym uruchomieniu.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ColoredCompletion.Title">Kolorowa lista autouzupełniania</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ColoredCompletion.Desc">Używa kolorów dla wyrazów na liście autouzupełniania.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.PairedChars.Title">Wstawiaj sparowane nawiasy</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.PairedChars.Desc">Automatycznie wpisuje nawias zamykający lub cudzysłów.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TrimSpaces.Title">Usuwaj spacje na końcu wierszy</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TrimSpaces.Desc">Usuwa spacje na końcu każdego wiersza podczas zapisywania pliku.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowTips.Title">Pokaż podpowiedzi</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowTips.Desc">Wyświetla podpowiedzi dla funkcji i kodu po wpisaniu nawiasu otwierającego. Zmiana zadziała po ponownym uruchomieniu.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShortDescriptions.Title">Krótkie opisy</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShortDescriptions.Desc">Wyświetla krótkie podpowiedzi dla opkodów. Zmiana zadziała po ponownym uruchomieniu.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveCaret.Title">Zapamiętuj pozycję kursora</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveCaret.Desc">Zapamiętuje pozycję kursora przy zamykaniu skryptu i przywraca ją przy następnym otwarciu.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Encoding.Title">Kodowanie skryptów i plików komunikatów</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Encoding.Desc">Strona kodowa używana do odczytu i zapisu skryptów i plików komunikatów.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveUtf8.Title">Zapisuj skrypty jako UTF-8</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveUtf8.Desc">Zapisuje skrypty w UTF-8 zamiast w kodowaniu wybranym powyżej.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.FileAssociation">Skojarzenia plików</sys:String>
    <sys:String x:Key="Str.ToolWindows.Btn.Associate">S_kojarz</sys:String>
    <sys:String x:Key="Str.ToolWindows.Tip.Associate">Skojarz pliki SSL, INT, MSG i FCD z edytorem.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociationYes">Edytor jest programem domyślnym dla plików .ssl, .int, .msg i .fcd.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociationNo">Edytor nie jest skojarzony z plikami .ssl, .int, .msg i .fcd.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociateQuestion">Skojarzyć pliki .ssl, .int, .msg i .fcd z programem Fallout Script Studio?</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociateFailed">Nie można skojarzyć typów plików: {0}</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociateDone">Typy plików zostały skojarzone z programem Fallout Script Studio.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.SaveFailed" xml:space="preserve">Ustawienia zostały zastosowane, ale nie udało się ich zapisać: {0}&#10;Sprawdź, czy folder ustawień jest zapisywalny i czy dysk nie jest pełny.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.SelectOutputFolder">Wybierz folder dla skompilowanych skryptów</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.SelectScriptsHeader">Wybierz plik scripts.h</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.SelectHeadersFolder">Wybierz folder z plikami nagłówkowymi</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.SelectInt2ssl">Wybierz int2ssl.exe</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.SelectMessageFolder">Wybierz folder z plikami komunikatów</sys:String>
    <sys:String x:Key="Str.ToolWindows.Filter.HeaderFiles">Pliki nagłówkowe (*.h)</sys:String>
    <sys:String x:Key="Str.ToolWindows.Filter.ExecutableFiles">Pliki wykonywalne (*.exe)</sys:String>
