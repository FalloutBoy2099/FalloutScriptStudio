    <sys:String x:Key="Str.ToolWindows.Opt.Autocomplete.Title">Automatische Vervollständigung</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Autocomplete.Desc">Zeigt beim Tippen eine Liste mit Prozedur-, Variablen-, Konstanten- und Makronamen an. Mit Alt+Leertaste öffnen Sie die Liste. Wirkt nach einem Neustart.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ColoredCompletion.Title">Farbige Vervollständigungsliste</sys:String>
