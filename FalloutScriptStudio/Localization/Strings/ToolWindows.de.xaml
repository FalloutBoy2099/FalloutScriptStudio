    <sys:String x:Key="Str.ToolWindows.Opt.TabsToSpaces.Desc">Beim Drücken der Tabulatortaste werden Leerzeichen statt eines Tabulatorzeichens eingefügt. Die Anzahl der Leerzeichen wird unten festgelegt.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TabSize.Title">Tabulator-/Einrückungsbreite in Leerzeichen</sys:String>
