    <sys:String x:Key="Str.ToolWindows.Opt.PairedChars.Title">Paarige Klammern automatisch einfügen</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.PairedChars.Desc">Die schließende Klammer oder das schließende Anführungszeichen automatisch eingeben.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TrimSpaces.Title">Nachgestellte Leerzeichen entfernen</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.TrimSpaces.Desc">Beim Speichern einer Datei nachgestellte Leerzeichen aus jeder Zeile entfernen.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowTips.Title">Tipps anzeigen</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShowTips.Desc">Zeigt Tooltips für Funktionen und Code, wenn eine öffnende Klammer eingegeben wird. Wirkt nach einem Neustart.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShortDescriptions.Title">Kurzbeschreibungen</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ShortDescriptions.Desc">Zeigt kurze Tooltips für Opcodes. Wirkt nach einem Neustart.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveCaret.Title">Cursorposition speichern</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.SaveCaret.Desc">Merkt sich die Cursorposition beim Schließen eines Skripts und stellt sie beim nächsten Öffnen wieder her.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.Encoding.Title">Kodierung von Skript- und Nachrichtendateien</sys:String>
