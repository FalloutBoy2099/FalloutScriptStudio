    <sys:String x:Key="Str.ToolWindows.Opt.ParserEnabled.Desc">Den Skript-Parser ausführen. Er stellt „Deklaration suchen“, „Verweise suchen“ und ähnliche Funktionen sowie das Seitenpanel mit globalen Variablen und Prozeduren bereit.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Opt.ParserWarnings.Title">Warnungen</sys:String>
