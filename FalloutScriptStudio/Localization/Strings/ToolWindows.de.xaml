    <sys:String x:Key="Str.ToolWindows.Tip.Associate">Die Dateien SSL, INT, MSG und FCD mit dem Editor verknüpfen.</sys:String>
    <sys:String x:Key="Str.ToolWindows.Settings.AssociationYes">Der Editor ist das Standardprogramm für .ssl-, .int-, .msg- und .fcd-Dateien.</sys:String>
